<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:camel="http://camel.apache.org/schema/spring"
	xsi:schemaLocation="http://www.springframework.org/schema/beans 
		http://www.springframework.org/schema/beans/spring-beans.xsd          
		http://www.springframework.org/schema/context
	http://www.springframework.org/schema/context/spring-context.xsd       
		http://camel.apache.org/schema/spring 
		http://camel.apache.org/schema/spring/camel-spring.xsd">

	<import resource="classpath:/routes/*.xml"/>
	
	<camelContext id="MyCamel"
		xmlns="http://camel.apache.org/schema/spring">


		<defaultServiceCallConfiguration component="http">
			<staticServiceDiscovery>
					<servers>validation-service@10.10.11.111:8082,validation-service@10.10.11.111:8009</servers>
					<servers>translation-service@10.10.11.111:8090,translation-service@10.10.11.111:8090</servers>
					<!-- <servers>ibanBic-service@10.10.11.111:8082, ibanBic-service@10.10.11.111:8009</servers>
					<servers>duplicate-check-service@10.10.11.111:8082, duplicate-check-service@10.10.11.111:8009</servers>
					<servers>scheduling-service@10.10.11.111:8082, scheduling-service@10.10.11.111:8009</servers>
					<servers>matching-service@10.10.11.111:8082, matching-service@10.10.11.111:8009</servers>
					<servers>sanction-service@10.10.11.111:8082, sanction-service@10.10.11.111:8009</servers>
					<servers>translation-service@10.10.11.111:8090, translation-service@10.10.11.111:8090</servers>
					<servers>proxyresolution-service@10.10.11.111:8082, proxyresolution-service@10.10.11.111:8009</servers>
					<servers>benefvalidation-service@10.10.11.111:8082, benefvalidation-service@10.10.11.111:8009</servers>
					<servers>accountingEntry-service@10.10.11.111:8082, accountingEntry-service@10.10.11.111:8009</servers>
					<servers>parseField-service@10.10.11.111:3068</servers>
					<servers>parseField-service@10.10.11.111:3068</servers> -->
			</staticServiceDiscovery>
		</defaultServiceCallConfiguration>

		<routeContextRef ref="main2"/>
		
		<onException id="httpException">
			<exception>org.apache.camel.http.common.HttpOperationFailedException</exception>
			<redeliveryPolicy
				maximumRedeliveries="2" />
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In HttpOperationFailedException Handler, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRFILEQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>			
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepaError)" />	
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queueIdError}, STATUS = '69',DISPLAY_FLAG = 'Y', RESUBMIT_QUEUEID=:#${header.PLCN_resubmitQueueId},RESUBMIT_STATUS='69',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.PLCN_twoPhaseCommitId} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException id="httpConnectException">
			<exception>java.net.ConnectException</exception>
			<redeliveryPolicy
				maximumRedeliveries="2" />
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In ExceptionHandler, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRFILEQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>			
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepaError)" />	
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queueIdError}, STATUS = '69',DISPLAY_FLAG = 'Y', RESUBMIT_QUEUEID=:#${header.PLCN_resubmitQueueId},RESUBMIT_STATUS='69',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.PLCN_twoPhaseCommitId} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException id="polyglotException">
			<exception>org.graalvm.polyglot.PolyglotException</exception>
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In ExceptionHandler, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRFILEQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>			
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepaError)" />	
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queueIdError}, STATUS = '69',DISPLAY_FLAG = 'Y', RESUBMIT_QUEUEID=:#${header.PLCN_resubmitQueueId},RESUBMIT_STATUS='69',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.PLCN_twoPhaseCommitId} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException id="debulkerException">
			<exception>ai.pelican.camel.exception.DebulkerException</exception>
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In DebulkerException, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRFILEQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>			
			<bean ref="pelicanController" method="exceptionLogger" />
			<log message="In DebulkerException, printing headers = ${headers}" />
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queue}, STATUS = '69',DISPLAY_FLAG = 'Y',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.MSGDBID} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException id="socketException">
			<exception>java.net.SocketException</exception>
			<redeliveryPolicy
				maximumRedeliveries="5" redeliveryDelay="1000" />
			<handled>
			<constant>true</constant>
			</handled>
			<log message="SocketException occurred" />
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepaError)" />	
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queueIdError}, STATUS = '69',DISPLAY_FLAG = 'Y', RESUBMIT_QUEUEID=:#${header.PLCN_resubmitQueueId},RESUBMIT_STATUS='69',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.PLCN_twoPhaseCommitId} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException>
			<exception>ai.pelican.camel.handler.exception.ExceptionHandler</exception>
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In ExceptionHandler, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRORQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>			
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperation)" />	
		<!--	<to uri="aceq://authErr?queueID=ERRORQ&amp;pollStatus=79&amp;updateQueueIDStatus=Y&amp;processingStage=ERR" />
			 <to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=79&amp;updateQueueIDStatus=Y&amp;processingStage=ERR" /> -->	
			<to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=79" />	
			<log message="MESSAGE MOVED TO ERRORQ" />
			<to uri="genaudit://route1Audit" />
			<stop />
		</onException>
		
		<onException>
			<exception>ai.pelican.camel.exception.AuthenticationException</exception>
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In AuthenticationException, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRORQ</simple>
			</setHeader>			
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>
			<setHeader headerName="PLCN_authenticationException">
				<simple>true</simple>
			</setHeader>
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDataDBRoute" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},populateMetaData)" />
			<to uri="direct://dbOperationCamelContext" />
			<!--<to uri="aceq://authErr?queueID=ERRORQ&amp;pollStatus=69&amp;updateQueueIDStatus=Y&amp;processingStage=ERR" />
			 <to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=69&amp;updateQueueIDStatus=Y&amp;processingStage=ERR" /> 	-->
			<log message="MESSAGE MOVED TO ERRORQ" />
			<to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=69" />
			<log message="MESSAGE TAMPERED ONEXCEPTION" />
			<to uri="genaudit://route1Audit" />
			<stop/>
		</onException>
				
		<onException>
			<exception>ai.pelican.camel.exception.StaticDataNotFoundException</exception>
			<redeliveryPolicy
				maximumRedeliveries="7" redeliveryDelay="30000" />
			<handled>
			<constant>true</constant>
			</handled>
			<log message="In StaticDataNotFoundException, exception occured..." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<bean ref="pelicanController" method="exceptionLogger" />
			<stop/>
		</onException>
		
		<onException id="hazelReconnect">
			<exception>com.hazelcast.client.HazelcastClientNotActiveException</exception>
			<exception>com.hazelcast.client.HazelcastClientOfflineException</exception>
			<!-- com.hazelcast.core.HazelcastException -->
			<handled>
				<constant>true</constant>
			</handled>
			<log message="In hazelReconnect handler." />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<bean ref="pelicanController" method="stopRoutes" />
		</onException>
		
		<onException id="genericException">
			<exception>java.lang.Exception</exception>
			<!--<redeliveryPolicy
				maximumRedeliveries="0" />-->
			<handled>
				<camel:constant>true</camel:constant>
			</handled>
			<log loggingLevel="INFO" message="IN Generic Exception handler" />
			<log loggingLevel="TRACE" message="body in Generic Exception: ${body}" />
			<setHeader headerName="exception">
				<simple>${exception.stacktrace}</simple>
			</setHeader>
			<setHeader headerName="PLCN_queue">
				<simple>ERRORQ</simple>
			</setHeader>
			<!--<setHeader headerName="PLCN_exceptionFlag">
				<constant>true</constant>
			</setHeader>-->
			<setHeader headerName="PLCN_validFlag">
				<simple>false</simple>
			</setHeader>
			<setHeader headerName="PLCN_GENERIC_EXCEPTION">
				<constant>true</constant>
			</setHeader>
			<bean ref="pelicanController" method="exceptionLogger" />
			<bean id="jspPopulateDatadbOperationCC" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepaError)" />	
			<to uri = "sql:update MSGDB set QUEUEID =:#${header.PLCN_queueIdError}, STATUS = '69',DISPLAY_FLAG = 'Y', RESUBMIT_QUEUEID=:#${header.PLCN_resubmitQueueId},RESUBMIT_STATUS='69',
			CURRENT_AUTH_LEVEL=:#${header.PLCN_currentAuthLevel},COMMENTS =:#${header.PLCN_fileComments}, PROCESSING_STAGE ='ERR' where MSGDB_ID =:#${header.PLCN_twoPhaseCommitId} " />	
			<log message="MESSAGE MOVED TO ERRFILEQ" />
			<to uri="genaudit://route1Audit" />
			<log loggingLevel="INFO" message="Going to update to DB" />
			<stop />
		</onException>
		
		<route id="dbOperationCamelContext">
			<from uri="direct://dbOperationCamelContext" />
			<bean id="jspPopulateDataSetAuthViolation" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},setExceptionViolation)" />
			<bean id="jspPopulateDataCreateResponseCamelContext" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},createResponse)" />
			<bean id="jspPopulateDatadbOperationCamelContext" ref="jspExecute"
				method="executeWithHazelCastInstance(${exchange},dbOperationSepa)" />
		</route>

	</camelContext>
	
</beans>