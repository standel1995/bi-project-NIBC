       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

    <routeContext id="validation" xmlns="http://camel.apache.org/schema/spring">
	
	<route id="licensepulse" startupOrder="1" autoStartup="true">
		<from uri="timer://licensepulseTrigger?fixedRate=true&amp;period=15000" />
		<log loggingLevel="DEBUG" message="License Check" />
		<bean ref="licensePulse" method="start" />
	</route>
	
	<route id="rest-validation">
		<from uri="direct://rest-validation" />
		<bean id="xmlParserValidation" ref="xmlParser" />
		<log loggingLevel="TRACE" message="Body in rest-validation Befor validationRoute call = ${body}" />
		<bean id="jspPopulateDataValidateHdr" ref="jspExecute"
			method="executeWithHazelCastInstance(${exchange},validateHeader)" />
		<choice>
			<when>
				<simple>${header.PLCN_headerFlag}</simple>
				<log message="Valid msg type in header calling validationRoute${header.RevisedPaymentType}"/>
				<toD uri="direct://validationRoute${header.RevisedPaymentType}"/>
				<log loggingLevel="INFO" message="rest-validation: after validation route. RevisedPaymentType=${header.RevisedPaymentType}, XSD_VALID=${header.XSD_VALID}, status=${header.status}" />
			</when>
			<otherwise>
				<log message="Invalid msg type in header"/>
				<setHeader headerName="PLCN_exceptionFlag">
					<constant>true</constant>
				</setHeader>
			</otherwise>
		</choice>
		<log loggingLevel="TRACE" message="Body in rest-validation after validationRoute call = ${body}" />
		<log loggingLevel="TRACE" message="Headers in rest-validation before remove headers = ${headers}" />
		<log message="status in rest-validation = ${header.status}" />
		<choice>
			<when>
				<simple>${header.PLCNAPI_call}</simple>
				<bean id="jspPopulateDataSetResponseCode" ref="jspExecute"
					method="executeWithHazelCastInstance(${exchange},setResponseCode)" />
				<removeHeaders pattern="PLCN_responseCdsDoc" />
				<removeHeaders pattern="ACEDB_responseCdsDoc" />
				<removeHeaders pattern="PLCN_ParseRequest" />
				<removeHeaders pattern="PLCN_originalMsgBody" />
				<log message="PLCNAPI_call internal" />
			</when>
			<otherwise>
				<bean id="jspPopulateDatacreateResponseValidation" ref="jspExecute"
					method="executeWithHazelCastInstance(${exchange},createResponseValidation)" />
				<removeHeaders pattern="*" excludePattern="status"/>
				<!-- <removeHeaders pattern="PLCN_" /> -->
			</otherwise>
		</choice>
		<!-- ResponseCds is an HTTP body, never an HTTP header. -->
		<removeHeaders pattern="PLCN_responseCdsDoc" />
		<removeHeaders pattern="ACEDB_responseCdsDoc" />
		<removeHeaders pattern="PLCN_BAH_*" />
		<!--
			The original payment message is preserved for the BAH flow. It is now
			kept as an Exchange property by validation.js, so it can no longer
			reach the HTTP response encoder. This removal stays in place as a
			safety net for an exchange produced by an older deployment: an XML
			payload contains line breaks and Netty rejects such a header value
			(IllegalArgumentException: Only ' ' and '\t' are allowed after '\n').
		-->
		<removeHeaders pattern="PLCN_originalBody" />
		<!--
			Optional generic guard. Removes every non-Camel text header whose value
			contains a line break. Enable only if a catch-all is wanted in addition
			to the targeted removals above.

		<bean id="jspSanitizeResponseHeaders" ref="jspExecute"
			method="executeWithHazelCastInstance(${exchange},sanitizeResponseHeaders)" />
		-->
		<log loggingLevel="INFO" message="Headers in rest-validation after remove headers ${headers}" />
		<log loggingLevel="TRACE" message="Body in rest-validation after remove headers ${body}" />
		<log message="status in rest-validation after remove headers ${header.status}" />
	</route>
	
	<route id="validationRouteAppHeader">
		<from uri="direct://validationRouteAppHeader" />

		<log loggingLevel="INFO" message="BAH XSD validation started." />
		<log loggingLevel="TRACE" message="BAH body before XSD validation = ${body}" />

		<!--
			Use a message-specific BAH XSD where available.
			TARGET2 and all other messages intentionally fall back
			to the existing generic head.001.001.02 XSD.
		-->
		<choice>

			<when>
				<simple>${header.PLCN_BAH_MESSAGE_TYPE} == 'CBPRPACS.009.001.08' || ${header.PLCN_BAH_MESSAGE_TYPE} == 'PACS.009.001.08'</simple>
				<log message="BAH XSD CHECK: pacs.009.001.08" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.bah.pacs.009.001.08}})" />
			</when>

			<when>
				<simple>${header.PLCN_BAH_MESSAGE_TYPE} == 'CBPRCAMT.057.001.06' || ${header.PLCN_BAH_MESSAGE_TYPE} == 'CAMT.057.001.06'</simple>
				<log message="BAH XSD CHECK: camt.057.001.06" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.bah.camt.057.001.06}})" />
			</when>

			<when>
				<simple>${header.PLCN_BAH_MESSAGE_TYPE} == 'CBPRPACS.002.001.10' || ${header.PLCN_BAH_MESSAGE_TYPE} == 'PACS.002.001.10'</simple>
				<log message="BAH XSD CHECK: pacs.002.001.10" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.bah.pacs.002.001.10}})" />
			</when>

			<when>
				<simple>${header.PLCN_BAH_MESSAGE_TYPE} == 'CBPRPACS.004.001.09' || ${header.PLCN_BAH_MESSAGE_TYPE} == 'PACS.004.001.09'</simple>
				<log message="BAH XSD CHECK: pacs.004.001.09" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.bah.pacs.004.001.09}})" />
			</when>

			<when>
				<simple>${header.PLCN_BAH_MESSAGE_TYPE} == 'CBPRPACS.008.001.08' || ${header.PLCN_BAH_MESSAGE_TYPE} == 'PACS.008.001.08'</simple>
				<log message="BAH XSD CHECK: pacs.008.001.08" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.bah.pacs.008.001.08}})" />
			</when>

			<otherwise>
				<log message="BAH XSD CHECK: DEFAULT head.001.001.02" />
				<bean ref="xsdValidationNew" method="validateWithExtXSDUsingSAX(${exchange},{{xsd.Location.head.001.001.02}})" />
			</otherwise>

		</choice>

		<log loggingLevel="INFO" message="BAH XSD validation completed. BAH XSD_VALID=${header.XSD_VALID}" />

		<!-- Preserve BAH validation result before normal payment validation. -->
		<bean ref="jspExecute" method="executeWithHazelCastInstance(${exchange},saveBahValidationResult)" />

		<!-- Restore the original payment message. -->
		<bean id="xmlParserP1.9" ref="xmlParser" />
		<bean id="jspPopulateDataP1.9" ref="jspExecute" method="executeWithHazelCastInstance(${exchange},setOriginalBody)" />

		<log loggingLevel="TRACE" message="Original payment message restored. Continuing with payment validation." />

		<!--
			The existing payment validation is invoked directly from here.
			rest-validation is deliberately NOT called again: re-entering it made
			the response-building step (setResponseCode / createResponseValidation)
			run twice on the same exchange, the second time after all headers had
			already been removed.
		-->
		<bean id="xmlParserBahPayment" ref="xmlParser" />
		<bean id="jspValidateHdrBahPayment" ref="jspExecute"
			method="executeWithHazelCastInstance(${exchange},validateHeader)" />

		<choice>
			<when>
				<simple>${header.PLCN_headerFlag} == true &amp;&amp; ${header.RevisedPaymentType} != 'AppHeader'</simple>
				<log message="BAH flow: calling validationRoute${header.RevisedPaymentType}" />
				<toD uri="direct://validationRoute${header.RevisedPaymentType}" />
			</when>
			<otherwise>
				<log loggingLevel="WARN" message="BAH flow: payment message type could not be resolved. RevisedPaymentType=${header.RevisedPaymentType}" />
				<setHeader headerName="PLCN_exceptionFlag">
					<constant>true</constant>
				</setHeader>
			</otherwise>
		</choice>

		<log loggingLevel="INFO" message="BAH flow: payment validation completed. Payment XSD_VALID=${header.XSD_VALID}, status=${header.status}" />

		<!-- Fold the BAH result back into the payment validation result. -->
		<bean id="jspMergeBahValidationResults" ref="jspExecute"
			method="executeWithHazelCastInstance(${exchange},mergeBahValidationResults)" />

		<log loggingLevel="INFO" message="BAH flow: merge completed. XSD_VALID=${header.XSD_VALID}, status=${header.status}" />
	</route>
	
