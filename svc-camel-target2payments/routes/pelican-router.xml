				<to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=69" />
				<stop />
			</when>
		</choice>
		<to uri="direct://setValidationHeaderTarget2" />
		<removeHeaders pattern="ACTIVE_INSTANCE"/>
		<serviceCall
			name="validation-service/payments/v1/validation?headerFilterStrategy=#aceqFilter" />
		<to uri="direct://setOriginalBody" />
		<!-- <to uri="direct://setStatusHeader" /> -->
		<removeHeaders pattern="ACTIVE_INSTANCE"/>		
		<serviceCall 
			name="duplicate-check-service/duplicate?headerFilterStrategy=#aceqFilter" />
		<!-- <to uri="direct://setStatusHeader" /> -->
		<!-- <removeHeaders pattern="ACTIVE_INSTANCE"/>
		<serviceCall 
			name="ibanBic-service/ibanBic?headerFilterStrategy=#aceqFilter" /> -->
		<!-- <to uri="direct://setStatusHeader" /> -->
		<to uri="direct://dynamicRoute" />
		<choice>
			<when>
				<simple>${header.PLCN_validFlag} == true</simple>
				<setHeader headerName="PLCN_queue">
					<simple>PROCDQ</simple>
				</setHeader>
				<!-- <to uri="direct://headerOperation" /> -->
				<to uri="direct://dbOperation" />
				<to uri="aceq://endpointwrite?queueID=PROCDQ&amp;pollStatus=79" />
				<log loggingLevel="INFO" message="Updated record in DB with QueueID=PROCDQ and Status=79" />
			</when>
			<otherwise>
				<log loggingLevel="INFO" message="Validation check failed, writting out to DB.." />
				<to uri="direct://dbOperation" />
				<to uri="direct://invalidRoute" />
				<!-- <to uri="direct://setResponseCds" /> -->
				<log loggingLevel="INFO" message="Updated record in DB with ${header.PLCN_queue} and Status=102" />
			</otherwise>
		</choice>
		<to uri="genaudit://route1Audit" />
		<log loggingLevel="INFO" message="Updated to DB from route-1-db-target2pacs009-ib" />
		<log loggingLevel="INFO" message="Message processed successfully.." />
