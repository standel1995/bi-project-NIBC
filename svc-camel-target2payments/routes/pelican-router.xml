	<routeContext id="main" xmlns="http://camel.apache.org/schema/spring">
	
	<route id="licensepulse" startupOrder="1" autoStartup="true">
			<from uri="timer://licensepulseTrigger?fixedRate=true&amp;period=15000" />
		<log loggingLevel="DEBUG" message="License Check" />
		<bean ref="licensePulse" method="start" />
	</route>
	
	<route id="_pel_mainRoute" startupOrder="2" autoStartup="true">
		<from
			uri="timer://mainRouteTimer2?fixedRate=true&amp;period=30000" />
		<bean ref="staticDataMaps" method="getCompletedFlag" />
		<choice>
			<when>
				<simple>${header.completedFlag} == true</simple>
				<bean ref="pelicanController" method="startRoutes" />
				<log loggingLevel="DEBUG" message="Startup activity completed.." />
			</when>
			<otherwise>
				<log loggingLevel="INFO" message="Hazelcast data not loaded, waiting..." />
			</otherwise>
		</choice>
	</route>
	
	<route id="route-1-db-target2pacs004ob" autoStartup="false" streamCache="true">
		<from id="readingDBRoute1" uri="aceq://route-1-db-target2pacs004ob?queueID=CPFRTQ&amp;pollStatus=69&amp;proThreads=5&amp;configID=config1" />
		<setHeader headerName="IdempotentKey">
			<simple>CPFRTQ:${header.ACEQ_MSGDB_ID}</simple>
        </setHeader>
		<idempotentConsumer skipDuplicate="true" messageIdRepositoryRef="idempotentRepoHazel">
		<header>IdempotentKey</header>
		<bean method="validateMessage" ref="hashValidation" />
