		<to uri="direct://dbRoute" />
		<to uri="direct://checkHeader" />
		<log loggingLevel="INFO" message="validLAU = ${header.validLAU}" />
		<choice>
			<when>
				<simple>${header.PLCN_validLAU} == false</simple>
				<log loggingLevel="INFO" message="Invalid LAU..." />
				<to uri="direct://dbOperation" />
				<to uri="genaudit://route1Audit" />
				<to uri="aceq://endpointwrite?queueID=ERRORQ&amp;pollStatus=69" />
				<stop />
			</when>
		</choice>
		<to uri="direct://setValidationHeaderTarget2" />
		<removeHeaders pattern="ACTIVE_INSTANCE"/>
		<log loggingLevel="TRACE" message="before validation-service call" />
		<serviceCall
				name="validation-service/payments/v1/validation?headerFilterStrategy=#aceqFilter" />
		<!-- <log loggingLevel="INFO" message="Body after validation = ${body}" /> -->
		<to uri="direct://setOriginalBody" />
		<!-- <log loggingLevel="INFO" message="Body after setOriginalBody = ${body}" /> -->
		<!-- <to uri="direct://setStatusHeader" /> -->
		<removeHeaders pattern="ACTIVE_INSTANCE"/>		
		<serviceCall 
		name="duplicate-check-service/duplicate?headerFilterStrategy=#aceqFilter" />
		<!-- <log loggingLevel="INFO" message="Body after duplicate = ${body}" /> -->
		<!-- <to uri="direct://setStatusHeader" /> -->
		<!-- <removeHeaders pattern="ACTIVE_INSTANCE"/>
		<serviceCall 
				name="ibanBic-service/ibanBic?headerFilterStrategy=#aceqFilter" /> -->
		
		<!-- <to uri="direct://setStatusHeader" /> -->
		<to uri="direct://repair" />
		<!-- <log loggingLevel="INFO" message="Body after repair = ${body}" /> -->
		<to uri="direct://dynamicRoute" />
		<!-- <log loggingLevel="INFO" message="Body after dynamic = ${body}" /> -->
		<choice>
			<when>  
				<simple>${header.PLCN_repairReqFinal} == false</simple>
				<log loggingLevel="INFO" message="Repair checked successfully.." />
				<to uri="direct://authorize" />
				<log loggingLevel="INFO" message="authReq flag = ${header.PLCN_authReq}" />
				<removeHeaders pattern="ACTIVE_INSTANCE"/>
				<serviceCall 
					name="scheduling-service/scheduling?headerFilterStrategy=#aceqFilter" />
				<log loggingLevel="INFO" message="schedulingReq flag = ${header.PLCN_schedulingReq}" />
				<choice>
					<when>
						<!-- <simple>${header.PLCN_authReq} == false</simple> -->
						<simple>${header.PLCN_authReq} == true</simple>
						<log loggingLevel="INFO" message="Authorization required, writting out to DB.." />
						<bean ref="jspExecute" method="executeWithHazelCastInstance(${exchange},setProcessingStage)" />
						<to uri="direct://dbOperation" />
						<to uri="aceq://endpointwrite?queueID=MXMSGAH&amp;pollStatus=69" />				
						<log loggingLevel="INFO" message="Updated record in DB with MXMSGAH and Status=69" />
					</when>
					<otherwise>
						<choice>
							<when>
								<simple>${header.PLCN_schedulingReq} == true</simple>
								<log loggingLevel="INFO" message="Message scheduled, writting out to DB.." />
								<to uri="direct://dbOperation" />
								<to uri="aceq://endpointwrite?queueID=MXHOLDQ&amp;pollStatus=69" />				
								<log loggingLevel="INFO" message="Updated record in DB with QueueID=MXHOLDQ and Status=69" />
							</when>
							<otherwise>
								<log loggingLevel="INFO" message="scheduling check successfully." />
								<to uri="direct://dbOperation" />
								<to uri="aceq://endpointwrite?queueID=TMPMSGQ&amp;pollStatus=69" />
							</otherwise>
						</choice>
					</otherwise>
				</choice>
			</when>			
			<otherwise>
				<log loggingLevel="INFO" message="Repair Required, writing out to DB.." />
				<to uri="direct://dbOperation" />
				<to uri="direct://invalidRoute" />
				<!-- <to uri="direct://setResponseCds" /> -->
				<log loggingLevel="INFO" message="Updated record in DB with ${header.PLCN_queue} and Status=69" />
		   </otherwise>
		</choice>
		<log loggingLevel="INFO" message="Going to update to DB" />
		<to uri="genaudit://route1Audit" />
		<log loggingLevel="INFO" message="Updated to DB" />
		<stop />
		</idempotentConsumer>
	</route>
	
