(FUNCTION DRVE_NIBC_OUTPUT_QUEUEID MSGTYPE MSG_DIR UNLOADCHECK)

(
	(VAR OUTPUT_QUEUE)
	(VAR UNLOADFLAG)

	(IF (ISPATTERNPRESENT MSGTYPE ".")
		THEN
		(ASSIGN MSGTYPE (SUBSTR (UPPER (REMOVEPATTERN MSGTYPE ".")) 1 7))
	)
	(IF (ISEQUALSTRING UNLOADCHECK "Y")
		THEN
		(
			(ASSIGN UNLOADFLAG (APPEND MSGTYPE (APPEND "-" MSG_DIR)))
			(ASSIGN OUTPUT_QUEUE (MemTblGetTableValue "BANIF_ROUTE_TABLE" UNLOADFLAG))
		)
		ELSE
		(
			(ASSIGN UNLOADFLAG (APPEND(APPEND (APPEND MSGTYPE (APPEND "-" MSG_DIR)) "-") UNLOADCHECK ))
			(ASSIGN OUTPUT_QUEUE (MemTblGetTableValue "BANIF_ROUTE_TABLE" UNLOADFLAG))
		)
	)
	(RETURN OUTPUT_QUEUE)

)




(FUNCTION DRVE_NIBC_PRODUCT_CODE PRODUCT_CODE MSGTYPE)		 ;;ADDED BY VARSHA 

(
	(VAR TXN_GROUP)
	(VAR KEY)
	(VAR MSG_MODE_IN)
	(VAR SOURCE_CHNL_ID)
	(VAR MSG_DIRECTION)
	(VAR ORIG_PRODUCT_CODE)
	(VAR INSTITUTIONID)
	(VAR MSG_SCHEME)
	(VAR SOURCECHANNELID)
	(ASSIGN INSTITUTIONID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "INSTITUTION_ID"))
	(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "QM"))

	(IF (ISEMPTY MSG_MODE_IN)
	THEN
	(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "MSG_MODE_IN"))
	)
	(Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGEDIRECTION"))
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGE_DIRECTION"))
	 )
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_MESSAGEDIRECTION"))
	 )
	 (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
	 (DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)
	 (IF (ISEMPTY MSG_MODE_IN)
		THEN
		(

			(IF (OR (ISEQUALSTRING SOURCE_CHNL_ID "FILE-ROUTE-IN")
					(ISEQUALSTRING SOURCE_CHNL_ID "SWFTFQ-IN")
					(ISEQUALSTRING SOURCE_CHNL_ID "RJE-FQ-IP-1")
					;(ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In")
				)
				THEN
				(ASSIGN MSG_MODE_IN "FILE")
			)
			;;ADDED ON 09/03/2018 BY DILIP FOR PRODUCT CODE
			(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "BO1-SWFT-OB-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-MT-IN") ;;ADDED BY LAXMI BARHATE 20/06/2022
				   (ISEQUALSTRING SOURCE_CHNL_ID "BO1-SWFT-OB-IN")
				)
				THEN
					(
					(ASSIGN MSG_MODE_IN SOURCE_CHNL_ID)
					(ASSIGN SOURCE_CHNL_ID (MemTblGetTableValue "NIBC_SWIFT_CHANNEL_DERIVATION" SOURCE_CHNL_ID))
					(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)
					)
			)
			;;END

		)
	)
	(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
	(IF	(AND (IsEqualString MSG_MODE_IN "MQ")
		(OR (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-MT-IN")) ;;ADDED BY LAXMI BARHATE 20/06/2022
		)
		THEN
		(
		   ;(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCECHANNELID"))
		   (ASSIGN MSG_MODE_IN SOURCE_CHNL_ID)
		   (ASSIGN SOURCE_CHNL_ID (MemTblGetTableValue "NIBC_SWIFT_CHANNEL_DERIVATION" SOURCE_CHNL_ID))
		   (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
		   (SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
		   (DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)
		)
	)
	(IF (AND (IsEqualString MSG_MODE_IN "MQ")
			(OR (IsEqualString MSGTYPE "pacs.008.001.08")
				(IsEqualString MSGTYPE "pacs.009.001.08")
				(IsEqualString MSGTYPE "pacs.002.001.10")
				(IsEqualString MSGTYPE "pacs.004.001.09")
				(IsEqualString MSGTYPE "camt.057.001.06")
				)
		)
	    THEN
		(
		    (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCECHANNELID"))
			(IF(ISEMPTY SOURCE_CHNL_ID)
			THEN
				(
		 		(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
				)
			)
			(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-MT-IN") ;;ADDED BY LAXMI BARHATE 20/06/2022
				   
				)
				THEN
					(
					(ASSIGN MSG_MODE_IN SOURCE_CHNL_ID)
					(ASSIGN SOURCE_CHNL_ID (MemTblGetTableValue "NIBC_SWIFT_CHANNEL_DERIVATION" SOURCE_CHNL_ID))
					(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)
					)
			)
		)
	)
	(IF (ISEMPTY MSG_MODE_IN)
		THEN
		(
			(IF (ISEQUALSTRING SOURCE_CHNL_ID "CLIEOP-ROUTE-IN-ERR")
				THEN
				(
				(ASSIGN PRODUCT_CODE "SEPA_OUT_STS")
				(ASSIGN MSGTYPE "pain.002.001.03")
				(ASSIGN MSG_MODE_IN "FILE")
				)
			)

			(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
			(IF (OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA Service Bureau")
					(ISEQUALSTRING SOURCE_CHNL_ID "SCT_IN")
					(ISEQUALSTRING SOURCE_CHNL_ID "SCT_INSTA_IN");;ADITI_FOR_INSTA_SUPPORT	pain.001
					(ISEQUALSTRING SOURCE_CHNL_ID "SEPA_INSTA_SVC_BUREAU_OB");;ADITI_FOR_INSTA_SUPPORT pacs.008
					;(ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In")
					;(ISEQUALSTRING SOURCE_CHNL_ID "Thaler NL SEPA In")
					;(ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA In")
					;(ISEQUALSTRING SOURCE_CHNL_ID "TBLOX SEPA In")
					;(ISEQUALSTRING SOURCE_CHNL_ID "CashFac SEPA In")
				)
				THEN
				(ASSIGN MSG_MODE_IN "FILE")
			)
		)
	)
	(IF (IsEmpty MSG_MODE_IN)
		 THEN
		   (ASSIGN MSG_MODE_IN (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "MANUAL_MODE"))
	)
	;(IF (IsEmpty MSG_MODE_IN)
	;	 THEN
	;	   (ASSIGN MSG_MODE_IN (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MANUAL_MODE"))
	;)
	(IF (ISEMPTY MSG_MODE_IN)
	THEN
		(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "MANUAL_MODE"))
	)
	(IF (ISEMPTY MSG_MODE_IN )
	THEN
		(ASSIGN MSG_MODE_IN (MemTblGetTableValue "MESSAGE_DETAILS" "MANUAL_MODE"))
	)
	(ASSIGN ORIG_PRODUCT_CODE  (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "DERIVED_PRODUCT"))
	(IF (AND (ISEQUALSTRING MSG_MODE_IN "REPAIR")
			 (NOT (ISEMPTY ORIG_PRODUCT_CODE))
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "NOTAPPLICABLE"))
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "null"))	 ;BY ADITI
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "NULL"))	 ;BY ADITI
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "Null"))
		)
		THEN
			(RETURN ORIG_PRODUCT_CODE)
	)
	(IF (ISEQUALSTRING MSG_MODE_IN "REPAIR")
	THEN
		(ASSIGN MSG_MODE_IN "MANUAL")
	)
	(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
	(IF (ISEQUALSTRING SOURCE_CHNL_ID "SWIFT_UPL_IN")
	  THEN
		  (
		  	(ASSIGN MSG_MODE_IN "UPLOAD")
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_MODE_IN" MSG_MODE_IN)
			(ASSIGN KEY MSG_MODE_IN)
			(ASSIGN PRODUCT_CODE (MemTblGetTableValue "PPAY_PRODUCT_CD" KEY))
		  )
	)
	(IF (OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
	        (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN")
			(ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In NFA");;ADDED BY LAXMI 29/04/22
			(ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_OB")
			 (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ob")
			 (ISEQUALSTRING SOURCE_CHNL_ID "Thaler NL SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "TBLOX SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "CashFac SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
			 (ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In") ;ADDED BY SP 10-10-2022
		)
		THEN
		(ASSIGN MSG_MODE_IN (MemTblGetTableValue "NIBC_CHANNEL_TO_MODE" SOURCE_CHNL_ID))
	)
	;;PELPAYP-1121
	(VAR HDR_PREV_QUEUE)
	(VAR CONF_PREV_QUEUE)
	(VAR DERV_PRODUCT)

	(Assign DERV_PRODUCT (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT"))
	(IF (ISPATTERNPRESENT DERV_PRODUCT "C2B")
		THEN
			(RETURN DERV_PRODUCT)
	)
	(Assign HDR_PREV_QUEUE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "PREVQUEUEID"))
	(ASSIGN CONF_PREV_QUEUE (MemTblGetTableValue "FLAG-TABLE" "MANUAL-CREATE-QUEUES"))
	(IF (IsEqualString MSG_MODE_IN "MANUAL")
	   THEN
	     (
		   	(IF (IsPresent HDR_PREV_QUEUE)
			   THEN
				 (
				   	(IF (AND (NOT(IsPatternPresent CONF_PREV_QUEUE HDR_PREV_QUEUE))
					         (IsPresent DERV_PRODUCT)
						)
					   THEN
					     (
							(ASSIGN PRODUCT_CODE DERV_PRODUCT)
						 )
					)
				  )
			)
		 )
	)
	;;PELPAYP-1121
	(IF (AND (ISEMPTY PRODUCT_CODE)
			 (ISNOTEQUALSTRING MSG_MODE_IN "UPLOAD")
		)
		THEN
		(
			(ASSIGN KEY (APPEND (APPEND MSG_MODE_IN "-") MSGTYPE))
			(ASSIGN PRODUCT_CODE (MemTblGetTableValue "PPAY_PRODUCT_CD" KEY))
		)
	;	ELSE
	;	(
	;	 
	;		(IF (AND (OR (ISEMPTY PRODUCT_CODE)
	;				     (ISEQUALSTRING PRODUCT_CODE "SEPA_OUT")
	;			  	 )
	;				 (ISNOTEQUALSTRING MSG_MODE_IN "UPLOAD")
	;			 )
	;			THEN
	;			(
	;				(ASSIGN KEY (APPEND (APPEND MSG_MODE_IN "-") MSGTYPE))
	;			  ;	(ASSIGN KEY MSG_MODE_IN)
	;				(ASSIGN PRODUCT_CODE (MemTblGetTableValue "NIBC_PRODUCT_CODE" KEY))
	;			)
	;		   ELSE
	;		    (
				  ;	(ASSIGN KEY MSG_MODE_IN)
	;				(ASSIGN PRODUCT_CODE (MemTblGetTableValue "NIBC_PRODUCT_CODE" KEY))
	;	        )
	;		)
	;	)
	)



	;(IF (AND (ISEMPTY PRODUCT_CODE)
	;		 (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
	;		 (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA In")
	;	)
	;	THEN
	;	  (ASSIGN PRODUCT_CODE (MemTblGetTableValue "NIBC_PRODUCT_CODE" MSG_MODE_IN))
	;
	;)	
	(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "BO1-SWFT-OB-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-MT-IN") ;;ADDED BY LAXMI BARHATE 20/06/2022
		)
		THEN
		(ASSIGN MSG_MODE_IN "MQ")
	)	
	(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ob")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Thaler NL SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "TBLOX SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "CashFac SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
		   (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In NFA")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In");ADDED BY SP 13-10-2022
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_OB")
		)
		THEN
		   (ASSIGN MSG_MODE_IN "FILE")
	)
	(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ob")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Thaler NL SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "TBLOX SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "CashFac SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
		   (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
		   (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In NFA")
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_OB")
		)
		THEN
		   (ASSIGN MSG_MODE_IN "FILE")
	)


	(ASSIGN TXN_GROUP (MemTblGetTableValue "MESSAGETYPE" MSGTYPE))
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP" TXN_GROUP)
	(ASSIGN MSG_SCHEME (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SCHEME")); added 26122018
	(IF (ISEMPTY MSG_SCHEME)
        THEN
	 		(ASSIGN MSG_SCHEME (MemtblGetTableValue "StreamTable" "MSG_SCHEME"))
	)
	(IF (IsEqualString MSG_SCHEME "INST")																		   ;;added 24122018
	THEN
		(
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP" "EFT")
		)
	ELSE
		(
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP" TXN_GROUP)
		)
   )


	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_MODE_IN" MSG_MODE_IN)
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE" PRODUCT_CODE)
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT_CODE)
	(IF (ISEMPTY PRODUCT_CODE)
		THEN
			(
				(IF (ISPRESENT DERV_PRODUCT)
					THEN
					   (
					   		(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE" DERV_PRODUCT)
							(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT" DERV_PRODUCT)
					  )
				)
			)
	)

	(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ob")
           (ISEQUALSTRING SOURCE_CHNL_ID "Thaler NL SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "TBLOX SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "CashFac SEPA IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
           (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
		   (ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_OB")
		   (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN")
		)
		THEN
		   (ASSIGN MSG_MODE_IN "FILE")
	)

	(RETURN PRODUCT_CODE)

)
(FUNCTION DRVE_NIBC_CONFIGURATIONS MSGTYPE)
(
	;;custom banif configurations
	(VAR CHANNEL_ID_SOURCE)
	(VAR MSG_DIRECTION)
	(VAR FILE_TYPE)
	(VAR FTYPE)
	(VAR BANKING_CHANL)
	(VAR SOURCE_CHNL_ID)

	(Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGEDIRECTION"))
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGE_DIRECTION"))
	 )
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_MESSAGEDIRECTION"))
	 )
	(Assign BANKING_CHANL (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BANKING_CHANL_UPDT"))	  ;;ADDED BY VARSHA FOR BACK_OFFICE DERIVATION
	(IF (AND (ISEMPTY BANKING_CHANL)
			 (IsEqualString MSG_DIRECTION "O"))
		THEN
		(
			;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL" "SEPA_SERVICE_BUREAU")
			;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL_UPDT" "SEPA_SERVICE_BUREAU")
			;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANNEL" "SEPA_SERVICE_BUREAU")
			(ASSIGN BANKING_CHANL(MemTblGetTablevalue "FLAG-TABLE" "BACK_OFFICE"))
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL" BANKING_CHANL)
		  	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL_UPDT" BANKING_CHANL)
		  	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANNEL" BANKING_CHANL)

		)
	)
	(IF (IsEqualString MSG_DIRECTION "I")
		THEN
		(
		  ;(ASSIGN BANKING_CHANL(MemTblGetTablevalue "FLAG-TABLE" "EQUENS_BACK_OFFICE"))
		  (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
		  (IF(ISEMPTY SOURCE_CHNL_ID)
			THEN
			(
		 		(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
			)
		  )
		  (ASSIGN BANKING_CHANL(MemTblGetTableValue "USER_CONFIG" SOURCE_CHNL_ID))
		  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL" BANKING_CHANL)
		  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANL_UPDT" BANKING_CHANL)
		  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "BANKING_CHANNEL" BANKING_CHANL)
		)
	)
	;(IF (ISPATTERNPRESENT MSGTYPE "pain")
	;	THEN
	;	(
	;		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "FILE_TYPE" "SEPA-PAIN")
	;		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_TYPE" "SEPA-PAIN")
	;
	;	)
	;)
	;(IF (ISPATTERNPRESENT MSGTYPE "pacs")
	;	THEN
	;	(
	;		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "FILE_TYPE" "SEPA-PACS")
	;		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_TYPE" "SEPA-PACS")
	;		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" "SEPA Service Bureau")
	;		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" "SEPA Service Bureau")
	;	)
	;)
)

(FUNCTION DRVE_NIBC_CUSTOM_CHANNELS PRODUCT_CODE)
(
	;;custom banif configurations
	(VAR CHANNEL_ID_SOURCE)

	(ASSIGN CHANNEL_ID_SOURCE (MemTblGetTableValue "BANIF-PRODCODE-SOURCECHNL" PRODUCT_CODE))	
	(IF(IsPresent CHANNEL_ID_SOURCE)
	   THEN
		   (
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" CHANNEL_ID_SOURCE)			   	
		   )
	)

)

(FUNCTION DRVE_NIBC_CLYSYS_DETAILS)
(
;This function looks up the database to derive the clearing system from the currency of the
;message and then checks the holiday if present for the clearing system and the date

    (VAR SQLQUERY)
    (VAR CLRG_ID)
    (VAR HOLIDAY)
	(VAR CLRG_ID_CUTOFF_FLAG)
	(VAR CLRG_ID_STATUS)
	(VAR MODE)
	(VAR MSGTYPE)
	(VAR MSGPRIORITY)
	(VAR CURRENCY)
	(VAR MSG_DIRECTION)
	(VAR CURRENCY_LIST)
	(VAR CLRG_ID_RELEASE_FLAG)
	(VAR MSG_FAMILY)
	(VAR CLG_SYS)
	(VAR COMMENTS)
	(VAR COMMENTS1)
	(VAR COMMENTS2)
  	(ASSIGN CLRG_ID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CLEARING_ID")) ;; Clearing ID from LINK Webservice
	(ASSIGN COMMENTS (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "GV_COMMENTS_FRM_DB"))
	(ASSIGN COMMENTS2 (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COMMENTS_SET_DB"))
	(ASSIGN COMMENTS1 GV_COMMENTS_FOR_BLOB6)
	(ASSIGN CURRENCY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_CURRENCY"))
	(IF (ISEMPTY COMMENTS)
		THEN
		(ASSIGN COMMENTS COMMENTS1)
	)
	(IF (ISEMPTY CLRG_ID)
	  THEN
	    (Assign CLRG_ID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CLRG_ID_SET"))
	)

	(IF (AND (ISPRESENT CLRG_ID)
			 (NOT (ISPATTERNPRESENT COMMENTS "9505"))
			 (NOT (ISPATTERNPRESENT COMMENTS1 "9505"))
			 (NOT (ISPATTERNPRESENT COMMENTS2 "9505"))
			(ISNOTEQUALSTRING CLRG_ID "DEFAULT_CLEARING")
			(ISPATTERNPRESENT CLRG_ID CURRENCY )
		)
	  THEN
	  (
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CLRG_ID_SET" CLRG_ID)
			(RETURN CLRG_ID)

	  )
	)

	(ASSIGN CLRG_ID_STATUS (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CUTOFF_TIME"))

	;(ASSIGN CURRENCY_LIST "CAD|EUR|GBP|USD|AUD|CHF|CZK|DKK|HUF|JPY|NOK|PLN|SEK|ZAR")
	(ASSIGN CURRENCY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_CURRENCY"))
	(ASSIGN CURRENCY_LIST (MemTblGetTableValue "TABLEDETAILS_CURR" CURRENCY))
  	(IF (IsEmpty CURRENCY)
	   THEN
		(Assign CURRENCY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CURRENCY"))
	)

   	(Assign MODE (GETVALUEFROMHEADER GV_MSG_OUTPATH "MESSAGE_DETAILS" "MANUAL_MODE"))
	(IF (IsEmpty MODE)
	   THEN
		(ASSIGN MODE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_MODE_IN"))
	)
	(IF (IsEmpty MODE)
	   THEN
		(ASSIGN MODE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "QM"))
	)
	(ASSIGN MSGTYPE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_MESSAGECLASSTYPE"))
	(IF (IsEmpty MSGTYPE)
	   THEN
		(Assign MSGTYPE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGTYPE"))
	)
	(IF (ISEMPTY MSGTYPE)
		THEN
		 (ASSIGN MSGTYPE (MemTblGetTableValue "STREAM_DETAILS" "MSG_TYPE"))
	 )
	(IF (ISEMPTY MSGTYPE)
	  THEN
	    (Assign MSGTYPE (MemTblGetTableValue "StreamTable" "MSG_TYPE" ))
	)

	(Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGEDIRECTION"))
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MESSAGE_DIRECTION"))
	 )
	 (IF (IsEmpty MSG_DIRECTION)
		THEN
		  (Assign MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_MESSAGEDIRECTION"))
	 )
	(ASSIGN MSGPRIORITY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_PRIORITY"))

	(IF (ISEQUALSTRING MSG_DIRECTION "O")
       THEN
		  (
	 		   (IF (ISPATTERNPRESENT CURRENCY_LIST CURRENCY)
		       	THEN
		 			(ASSIGN CLRG_ID (APPEND CURRENCY "_IN"))
				ELSE
					(ASSIGN CLRG_ID "")
				)
				(IF (OR (ISPATTERNPRESENT MSGTYPE "PACS.008")
				   	 (ISPATTERNPRESENT MSGTYPE "pacs.008")
				   )
			       THEN
			 		   (ASSIGN CLRG_ID "TARGET2_IN")
				)
				;(IF (OR (ISPATTERNPRESENT MSGTYPE "CAMT.029")
				;   	 (ISPATTERNPRESENT MSGTYPE "camt.029")
				;   )
			    ;   THEN
			 	;	   (ASSIGN CLRG_ID "TARGET2")
				;)
	 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		  )
	)
	(IF (AND (OR (ISPATTERNPRESENT MSGTYPE "PACS.008")
				 (ISPATTERNPRESENT MSGTYPE "pacs.008")
			 )
			 (ISEQUALSTRING MSG_DIRECTION "I")
		)
       THEN
		  (
 		   (ASSIGN CLRG_ID "TARGET2_STD")
 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		  )
	)
	(IF (AND (OR (ISPATTERNPRESENT MSGTYPE "CAMT.029")
				 (ISPATTERNPRESENT MSGTYPE "camt.029")
			 )
			 (ISEQUALSTRING MSG_DIRECTION "I")
		)
			       THEN
				   (
			 		   ;(ASSIGN CLRG_ID "TARGET2_IN")
					   (ASSIGN CLRG_ID "TARGET2")
					   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
				   )


	)
	(IF (AND (OR (ISPATTERNPRESENT MSGTYPE "CAMT.056")
				 (ISPATTERNPRESENT MSGTYPE "camt.056")
			 )
			 (ISEQUALSTRING MSG_DIRECTION "I")
		)
       THEN
		  (
 		   (ASSIGN CLRG_ID "TARGET2")
 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		  )
	)
	(IF (AND (OR (ISPATTERNPRESENT MSGTYPE "PACS.004")
				 (ISPATTERNPRESENT MSGTYPE "pacs.004")
			 )
			 (ISEQUALSTRING MSG_DIRECTION "I")
		)
       THEN
		  (
 		   (ASSIGN CLRG_ID "TARGET2")
 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		  )
	)
	;;added by hatim
	(IF (AND (OR (ISPATTERNPRESENT MSGTYPE "PACS.003")
				 (ISPATTERNPRESENT MSGTYPE "pacs.003")
			 )
			 (ISEQUALSTRING MSG_DIRECTION "I")
		)
       THEN
		  (
 		   (ASSIGN CLRG_ID "TARGET2_SDD")
 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		  )
	)
	;;added by hatim
	(IF (OR (IsEqualString MODE "REPAIR")
			(IsEqualString MODE "MANUAL")
			(IsEqualString MODE "UPLOAD")
			(IsEqualString MODE "MQ")
			(IsEqualString MODE "FILE") ;;Added by nihal 181219-Test
		)
	   THEN
	    (
		;;ADDED BY Aashishgd FOR CLEARING ID FOR OUTBOUND SWIFT MESSAGE
					;;START
						(ASSIGN MSG_FAMILY (GETVALUEFROMHEADER GV_MSG_OUTPATH "MESSAGE_DETAILS" "MSG_FAMILY"))
						(IF (AND (IsEqualString MSG_DIRECTION "I")
								(ISPATTERNPRESENT "101|103|103+|202|210" MSGTYPE)
							)
						THEN
							(
							(IF (OR (ISPATTERNPRESENT COMMENTS "9505")
									(ISPATTERNPRESENT COMMENTS1 "9505")
									(ISPATTERNPRESENT COMMENTS2 "9505")
								)
								THEN
								(

												(ASSIGN CLRG_ID (APPEND "Outbound_SWIFT_" "TARGET2"))
												(ASSIGN CLRG_ID_RELEASE_FLAG "NO")

								)
								ELSE
								(

									 (ASSIGN CLRG_ID (APPEND "Outbound_SWIFT_" CURRENCY))
									 (ASSIGN CLRG_ID_RELEASE_FLAG "NO")

								)
							)
						)
							;;END
						ELSE
						(
						  (IF (IsEqualString MSGTYPE "103")
							 THEN
							  (
							   (ASSIGN CLRG_ID (APPEND CURRENCY "_URG"))
							   (ASSIGN CLRG_ID_RELEASE_FLAG "YES")
							  )
						  )
						  (IF (IsEqualString MSGTYPE "202")
							 THEN
							   (
								   (IF (IsEqualString MSGPRIORITY "U")
									  THEN
										(
										  (ASSIGN CLRG_ID (APPEND CURRENCY "_URG"))
										  (ASSIGN CLRG_ID_RELEASE_FLAG "YES")
										)
								   )
								   (IF (IsEqualString MSGPRIORITY "N")
									  THEN
										(
										  (ASSIGN CLRG_ID (APPEND CURRENCY "_STD"))
										  (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
										)
								   )
							   )
						  )
						  (IF (AND (OR (ISPATTERNPRESENT MSGTYPE "PACS.008")
										 (ISPATTERNPRESENT MSGTYPE "pacs.008")
									 )
								   (ISEQUALSTRING MSG_DIRECTION "I")
							  )
							 THEN
							  (
							   (ASSIGN CLRG_ID "TARGET2_STD")
							   ;(ASSIGN CLRG_ID "TARGET2")
							   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
							  )
						  )

									(IF (ISEMPTY CLRG_ID)
									THEN
										(Assign CLRG_ID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CLRG_ID_SET"))
									)

						)
				)
			)
		)
	   (IF (AND (IsEqualString (MEMTBLGETTABLEVALUE "StreamTable" "MSG_SCHEME") "INST")
				(NOT (ISPATTERNPRESENT "101|103|103+|202|210" MSGTYPE))
			)
		THEN
		(
			(ASSIGN CLRG_ID "TARGET2_INSTA")
 		   (ASSIGN CLRG_ID_RELEASE_FLAG "NO")
		)
	)

	(IF (OR (AND (NOT (IsPatternPresent "AUD|CAD|CHF|CZK|DKK|GBP|HUF|JPY|NOK|NZD|PLN|SAR|SEK|USD|ZAR|HKD|SGD|RON|TRY|EUR" CURRENCY)) ;;EUR temp remove to avoid MSGHOLDQ
			(ISNOTEQUALSTRING CLRG_ID "Outbound_SWIFT_TARGET2"))
			(IsEqualString CLRG_ID_STATUS "CLEARING_ID_NOT_FOUND")
		)
	   THEN
		 (ASSIGN CLRG_ID "Outbound_SWIFT_DEF")
	)
	(IF (OR (IsEmpty CLRG_ID) ;;Added by nihal for test
	        (IsEqualString CLRG_ID_STATUS "CLEARING_ID_NOT_FOUND")
		)
	   THEN
		 (ASSIGN CLRG_ID "DEFAULT_CLEARING")
	)
	(SETVALUETOHEADER  GV_MSG_OUTPATH "STREAM_DETAILS" "CLRG_ID_SET" CLRG_ID)
	(SETVALUETOHEADER  GV_MSG_OUTPATH "STREAM_DETAILS" "CLEARING_ID" CLRG_ID)
	(SETVALUETOHEADER  GV_MSG_OUTPATH "STREAM_DETAILS" "CLRG_ID_RELEASE_FLAG" CLRG_ID_RELEASE_FLAG)
	(RETURN CLRG_ID)
)

(FUNCTION VALIDATE_NIBC_PRODUCT_CODE PRODUCT_CODE MSG_MODE_IN MSGTYPE)

(
	(VAR FLAG)
	(VAR PRODUCT_CODE_LIST)	;to support product code validation
	(VAR KEY)
	(VAR RETVAL)
	(VAR PATH)
	(VAR PRODUCT_CODE1)
	(ASSIGN FLAG (MEMTBLGETTABLEVALUE "FLAG-TABLE" "VAL_PRDT_CODE_ERR_WRN"))
	(ASSIGN RETVAL 0)
	(IF (ISEMPTY PRODUCT_CODE)
	THEN
	(
		(ASSIGN PRODUCT_CODE (MemTblGetTableValue "STREAM_DETAILS" "PRODUCT_CODE"))
		(IF (ISEMPTY PRODUCT_CODE)
		THEN
		(ASSIGN PRODUCT_CODE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "DERIVED_PRODUCT"))
		)
	)
	)

	(IF (ISEQUALSTRING MSG_MODE_IN "WS")  ;to support product code validation for webservice
		THEN
		(
			(IF (ISEMPTY PRODUCT_CODE)
				THEN
				(Assign PRODUCT_CODE1 "")
				ELSE
				(
					(Assign PRODUCT_CODE1 (APPEND (APPEND "|" PRODUCT_CODE) "|"))
					(ASSIGN KEY (APPEND (APPEND MSG_MODE_IN "-") MSGTYPE))
					(ASSIGN PRODUCT_CODE_LIST (MemTblGetTableValue "PPAY_PRODUCT_CD" KEY))
					(IF (NOT(ISPATTERNPRESENT PRODUCT_CODE_LIST PRODUCT_CODE1))
					THEN
					(Assign PRODUCT_CODE1 "INVALID_PRODUCT_CODE")
					)

				)
			)

		)
	)
	(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "PRODUCT_CODE" PRODUCT_CODE)
	(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT_CODE)


	(IF (OR (ISEMPTY PRODUCT_CODE1)
				(ISEQUALSTRING PRODUCT_CODE1 "INVALID_PRODUCT_CODE")
			)
	THEN
	  (
		(IF (ISEQUALSTRING FLAG "ERROR")
		 THEN
		 (
			(IF (ISEMPTY PRODUCT_CODE1)
				THEN
				(Assign RETVAL "8465")
			)
			(IF (ISEQUALSTRING PRODUCT_CODE1 "INVALID_PRODUCT_CODE")
			THEN
			(Assign RETVAL "8477")
			)
			(IF (ISGREATERTHAN RETVAL 0)
				THEN
				(
	            	(ASSIGN PATH (STRING "MSG"))
	            (MEMTBLSETTABLEVALUE "TransTable" "TransValErrorPath" PATH)
	            (MEMTBLSETTABLEVALUE "TransTable" "TransErrorFlag" "T")
	            (MEMTBLSETTABLEVALUE "TransTable" "TransErrorCode" RETVAL)
	             (MEMTBLSETTABLEVALUE "StreamTable" "TechErrComments" (Append "P00-1:A00:00-" RETVAL))
	             (ASSIGN GV_COMMENTS (Append "P00-1:A00:00-" RETVAL))
	             (SetViolation "00" RETVAL)
				 (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "QUEUEID" "PROCEXCP")
				 (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "GV_COMMENTS_FRM_DB" GV_COMMENTS)
				 (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "GV_COMMENTS" GV_COMMENTS)
		         (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" GV_COMMENTS)
		         (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COMMENTS" GV_COMMENTS)
				 (SET-COMMENTS-FOR-FILE "00" RETVAL)	   ;added by rajeshree for ws flow
				)
			)

            (RETURN RETVAL)
		 )
		 ELSE
		 (
			(IF (ISEMPTY PRODUCT_CODE1)
				THEN
				(Assign RETVAL "7465")
			)
			(IF (ISEQUALSTRING PRODUCT_CODE1 "INVALID_PRODUCT_CODE")
			THEN
			(Assign RETVAL "7492")
			)

			(SET_ENHCR_VIOLATION "00" RETVAL)
			(ASSIGN GV_COMMENTS (Append "P00-1:A00:00-" RETVAL))
			(RETURN "0")
		 )
    	)
	)
	)
	(RETURN 0)
)


(FUNCTION VD_NIBC_SOURCE_CHANNEL)
(
	(VAR MSGTYPE)
	(VAR MSG_DIRECTION)
	(VAR INPUT_QUEUEID)
	(VAR QUEUEID)
	(VAR COMMENTS_FOR_BLOB6)
	(VAR COV_MSG_TYPE)
	(VAR TXN_GRP)
	(ASSIGN MSGTYPE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE"))
	(ASSIGN MSG_DIRECTION (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MESSAGE_DIRECTION"))
	(ASSIGN INPUT_QUEUEID (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "ACE_QUEUE_ID"))
	(ASSIGN COV_MSG_TYPE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COV_MSG_TYPE"))
	(ASSIGN TXN_GRP (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP"))
	(ASSIGN QUEUEID (DRVE_NIBC_OUTPUT_QUEUEID MSGTYPE MSG_DIRECTION "N"))
	   ;(IF (AND(NOT(ISEMPTY QUEUEID))
	               ;(ISEQUALSTRING MSG_TYPE "202COV"))
                    ;THEN
                    ;(
                      ; (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUE_ID" "CRPERR")
                       ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE" "UNSUPPORTED")
                       ;(RETURN)
                    ;)
                ;)
				(IF (ISEQUALSTRING COV_MSG_TYPE "202COV")
				  THEN
				  	  (
                  		(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUE_ID" "CRPERR")
											(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "CRPERR")
                      (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE" "UNSUPPORTED")
					  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "FILE_PROCESSING_STAGE" "ERR")
					  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COV_MSG_TYPE" "")
                      (RETURN)
                    )
				)
	            (IF (ISEMPTY QUEUEID)
                    THEN
                    (
                       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUE_ID" "CRPERR")
											 (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "CRPERR")
                       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE" "UNSUPPORTED")
					   (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "FILE_PROCESSING_STAGE" "ERR")
					   (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP" "EFT");;added on 15-02-2018 for QA bug
                       (RETURN)
                    )
                )

	(IF (ISNOTEQUALSTRING QUEUEID INPUT_QUEUEID)
		THEN
		(
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUE_ID" "PROCEXCP")
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "PROCEXCP")
	        (ASSIGN COMMENTS_FOR_BLOB6 "P00-1:A00:00-8474")
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" COMMENTS_FOR_BLOB6)
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS" COMMENTS_FOR_BLOB6)
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "GV_COMMENTS_FOR_BLOB6" COMMENTS_FOR_BLOB6)
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS_SET_DB" COMMENTS_FOR_BLOB6)
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "ERR_COMMENTS" COMMENTS_FOR_BLOB6)
			(RETURN)
		)
	)
)

(FUNCTION SEND_TO_REPR_NIBC)
(

(VAR VALUE_DATE)
(VAR TODAYS_DATE)
(VAR STAGE)
(VAR TERROR)
(VAR MODE)
(VAR SOURCE_CHNL_ID)
(VAR REPR_PRODUCT_CODE)
(VAR PATTERN)

(ASSIGN TERROR (MemTblGetTableValue "TransTable" "TransErrorFlag"))
(ASSIGN VALUE_DATE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "VALUEDATE"))
(ASSIGN STAGE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PROCESSING_STAGE"))
(ASSIGN MODE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "MANUAL_MODE"))
(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(IF(ISEMPTY SOURCE_CHNL_ID)
	THEN
	(
		 (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
	)
)
(IF (ISEMPTY MODE)
	THEN
	(ASSIGN MODE (MemTblGetTableValue "STREAM_DETAILS" "QM"))
)
(ASSIGN TODAYS_DATE (Date))

	(IF (Isempty VALUE_DATE)
		THEN
		(RETURN)
	)

	(IF (AND (IsLessthan VALUE_DATE TODAYS_DATE)
			 (AND (ISNOTEQUALSTRING STAGE "ERR")
			      (ISNOTEQUALSTRING TERROR "T")
			 )
		)
		THEN
		(
			(IF (NOT(IsPatternPresent (MemTblGetTablevalue "FLAG-TABLE" "PASTDATE_CHECK_NOTAPPLICABLE_CHANNEL") SOURCE_CHNL_ID))
				THEN
				(
					(IF  (AND (ISNOTEQUALSTRING MODE "REPAIR")
							  (ISNOTEQUALSTRING MODE "MQ")
							  (ISNOTEQUALSTRING MODE "MANUAL") ;;ADDED FOR TBSEETHTY-5738
							  (ISNOTEQUALSTRING MODE "FILE");;ADDED FOR TBSEETHTY-5738
						 )
						 THEN
						 (   
							(SET_ENHCR_VIOLATION "32" "9506")
							(Assign GV_COMMENTS_FOR_BLOB6 (FILLVIOLATION))
							(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "REPRQ")
						 )
					)
					(IF  (AND (OR (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_MQ") "NO")
								  (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_MANUAL") "NO");;ADDED FOR TBSEETHTY-5738
								  (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_UPLOAD") "NO");;ADDED FOR TBSEETHTY-5738
							  )
						  	  (OR (ISEQUALSTRING MODE "MQ")
								  (ISEQUALSTRING MODE "MANUAL");;ADDED FOR TBSEETHTY-5738
								  (ISEQUALSTRING MODE "FILE");;ADDED FOR TBSEETHTY-5738
							  )
					 )
					 THEN
					(
						(SET_ENHCR_VIOLATION "32" "9506")
						(Assign GV_COMMENTS_FOR_BLOB6 (FILLVIOLATION))
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" GV_COMMENTS_FOR_BLOB6)
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "REPRQ")
						(IF (ISEMPTY (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "REPR_PRODUCT_CODE"))
							THEN
								(
									(ASSIGN REPR_PRODUCT_CODE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT"))
									(Assign PATTERN (SearchNthPattern REPR_PRODUCT_CODE "-" -1))
									(ASSIGN REPR_PRODUCT_CODE (StrSub REPR_PRODUCT_CODE "1" PATTERN))
									(ASSIGN REPR_PRODUCT_CODE (APPEND REPR_PRODUCT_CODE "R"))
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT" REPR_PRODUCT_CODE)
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE" REPR_PRODUCT_CODE)
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "REPR_PRODUCT_CODE" REPR_PRODUCT_CODE)
								)
						)
					)
					)
				)
			)
		)
	)
)

(FUNCTION SEND_TO_REPR_NIBC_1)
(

(VAR RELEASE_DATE)
(VAR ORIG_VALUE_DATE)
(VAR TODAYS_DATE)
(VAR STAGE)
(VAR TERROR)
(VAR MODE)
(VAR SOURCE_CHNL_ID)
(VAR REPR_PRODUCT_CODE)
(VAR PATTERN)

(ASSIGN TERROR (MemTblGetTableValue "TransTable" "TransErrorFlag"))
(ASSIGN RELEASE_DATE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "VALUEDATE"))
(ASSIGN ORIG_VALUE_DATE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "VALUE_DATE_2"))
(ASSIGN STAGE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PROCESSING_STAGE"))
(ASSIGN MODE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "MANUAL_MODE"))
(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(IF(ISEMPTY SOURCE_CHNL_ID)
	THEN
	(
		 (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
	)
)
(IF (ISEMPTY MODE)
	THEN
	(ASSIGN MODE (MemTblGetTableValue "STREAM_DETAILS" "QM"))
)
(ASSIGN TODAYS_DATE (Date))

	(IF (Isempty ORIG_VALUE_DATE)
		THEN
		(RETURN)
	)

	(IF (AND (OR (IsLessthan ORIG_VALUE_DATE TODAYS_DATE)
			 	 (IsLessthan ORIG_VALUE_DATE RELEASE_DATE)
			 )
			 (AND (ISNOTEQUALSTRING STAGE "ERR")
			      (ISNOTEQUALSTRING TERROR "T")
			 )
		)
		THEN
		(
		(IF (NOT(IsPatternPresent (MemTblGetTablevalue "FLAG-TABLE" "PASTDATE_CHECK_NOTAPPLICABLE_CHANNEL") SOURCE_CHNL_ID))
			THEN
			(
				(IF  (AND (ISNOTEQUALSTRING MODE "REPAIR")
						  (ISNOTEQUALSTRING MODE "MQ")
						  (ISNOTEQUALSTRING MODE "MANUAL")
						  (ISNOTEQUALSTRING MODE "UPLOAD")
					 )
					 THEN
					(
						(SET_ENHCR_VIOLATION "32" "9506")
						(Assign GV_COMMENTS_FOR_BLOB6 (FILLVIOLATION))
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" GV_COMMENTS_FOR_BLOB6)
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "REPRQ")
					)
				)
				(IF  (AND (OR (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_MQ") "NO")
							  (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_MANUAL") "NO");;ADDED FOR TBSEETHTY-5738
							  (IsEqualString (MemTblGetTableValue "USER_CONFIG" "AUTOREPAIR_VALUEDATE_UPLOAD") "NO");;ADDED FOR TBSEETHTY-5738
						  )
						  (OR (ISEQUALSTRING MODE "MQ")
							  (ISEQUALSTRING MODE "MANUAL");;ADDED FOR TBSEETHTY-5738
							  (ISEQUALSTRING MODE "UPLOAD");;ADDED FOR TBSEETHTY-5738
						  )
					 )
					 THEN
					(
						(SET_ENHCR_VIOLATION "32" "9506")
						(Assign GV_COMMENTS_FOR_BLOB6 (FILLVIOLATION))
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" GV_COMMENTS_FOR_BLOB6)
						(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "REPRQ")
						(IF (ISEMPTY (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "REPR_PRODUCT_CODE"))
							THEN
								(
									(ASSIGN REPR_PRODUCT_CODE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT"))
									(Assign PATTERN (SearchNthPattern REPR_PRODUCT_CODE "-" -1))
									(ASSIGN REPR_PRODUCT_CODE (StrSub REPR_PRODUCT_CODE "1" PATTERN)) 
									(ASSIGN REPR_PRODUCT_CODE (APPEND REPR_PRODUCT_CODE "R"))									
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT" REPR_PRODUCT_CODE)
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE" REPR_PRODUCT_CODE)
									(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "REPR_PRODUCT_CODE" REPR_PRODUCT_CODE)
								)
						)
					)
				)
			)
		)
		)
	)
)


(FUNCTION FLOW_CLASSIFICATION_NIBC MSG);;ADDED BY AJINKYA FOR UNSUPPORTED MSGTYPE DEVELOPMENT ON 5-1-2018

(

(VAR DIRECTION)
(VAR INPUT_CHANNEL)
(VAR MESSAGE)
(VAR MSG_TYPE)
(VAR QUEUE_ID)
(VAR INSTITUTIONID)
(VAR PREV_QUEUEID)
(VAR MSG_MODE_IN)
(VAR MQ_FLAG)
(VAR ST_MSGTYPE)
(VAR MSG1)
(VAR MSG_TYPE_1)
(VAR MSG_DIRECTION)
(VAR CHANNEL_SOURCE)
(VAR PATH_ROUTE_GEN)
(VAR AUTO_ROUTEGEN)
(VAR MSG_TYPE_MT)
(VAR FLAG_BO)
(VAR FLAG_COPY_BO)
(VAR NEW_NIBC_FLOW)
(VAR BLOCK3_DATA)
(VAR BLOCK3_SUB_DATA)
(GLOBALVAR GV_WS_MSG_TYPE_VAR)
(GLOBALVAR GV_MSG_DIR)
(GLOBALVAR GV_INSTTBL_FLAG)
(GLOBALVAR GV_TABLE_FLAG)
(GLOBALVAR GV_TBLDTLS_QUERY_HDL)
(VAR COV_MSG_TYPE)
(VAR MSGTYPE)
(VAR SOURCE_CHNL_ID)


(GLOBALVAR GV_PMT_INF_TOT_AMOUNT)
(GLOBALVAR GV_NO_OF_TRXN)
(GLOBALVAR GV_BTCH_NO_OF_TRXN)
(GLOBALVAR GV_TOT_AMOUNT)
(GLOBALVAR GV_FILE_TOTAL_AMOUNT)
(GLOBALVAR GV_FILE_TOTAL_AMT_NUM)
(GLOBALVAR GV_COMMENTS)
(GLOBALVAR GV_ADDITIONAL_NONALLOWED_CHARACTERS)          ;;pggm 22jan2016

(Assign INPUT_CHANNEL "")
(Assign MESSAGE "")
(Assign MQ_FLAG "N")
(Assign MSG1 (TRUNCATE_MQ_DATA MSG))
(ASSIGN MESSAGE MSG)
(Assign INPUT_CHANNEL (MemTblGetTableValue "GENERAL" "INPUT_CHANNEL"))
(Assign MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "MSG_MODE_IN"))
(Assign QUEUE_ID (MemTblGetTableValue "STREAM_DETAILS" "ACE_QUEUE_ID"))
(Assign ST_MSGTYPE (MemTblGetTableValue "STREAM_DETAILS" "MSGTYPE"))
(ASSIGN CHANNEL_SOURCE (MemTblGetTableValue "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(Assign INSTITUTIONID (MemTblGetTableValue "STREAM_DETAILS" "INSTITUTIONID"))
(Assign PATH_ROUTE_GEN (Append INSTITUTIONID ".GEN_PARAMS.ROUTE_MESSAGES"))
(ASSIGN AUTO_ROUTEGEN (MemTblGetTableValue "INST_PARAM" PATH_ROUTE_GEN))
(Assign FLAG_BO (Append INSTITUTIONID ".MANUAL_DATA_ENTRY.GEN_PARAMS.PAYMENT_INTI_COPY_REQ.PAYMENT_INTI_COPY_REQ"))
(ASSIGN FLAG_COPY_BO (MemTblGetTableValue "INST_PARAM" FLAG_BO))
;(ASSIGN COV_MSG_TYPE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "COV_MSG_TYPE"))
(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))



(Assign MESSAGE (FMT-INF-MSG MESSAGE))

(ASSIGN BLOCK3_DATA(DATA_BETWEEN_TOKENS "{3:" "}{4:" MESSAGE))

(ASSIGN BLOCK3_SUB_DATA(DATA_BETWEEN_TOKENS "{119:" "}" BLOCK3_DATA))

(Assign MSG_TYPE (StrStr MESSAGE "{2:"))
(Assign MSG_TYPE_1 MSG_TYPE)
(Assign MSG_TYPE (SubStr MSG_TYPE 5 3))
;;ADDED ON 23042018 TO FIX 103+ MESSAGE TYPE FROM MQ
(IF (ISEQUALSTRING BLOCK3_SUB_DATA "STP")
  THEN
   (
     (Assign MSG_TYPE (APPEND MSG_TYPE "+"))
   )
)
;;END
(ASSIGN MSG_DIRECTION (SubStr MSG_TYPE_1 4 1)) ;; PELPAYP-938
(IF (IsPatternPresent MESSAGE "|")
  THEN
   (
     (ASSIGN MQ_FLAG "Y")
   )
)
(IF (AND(IsPatternPresent MSG1 "|")
        (ISEQUALSTRING QUEUE_ID "CRPMSGIN")
        (ISEQUALSTRING INPUT_CHANNEL "DB-MAIN-IP")
    )
  THEN
   (
     (ASSIGN MQ_FLAG "N")
   )
)
(IF (ISEMPTY MSG_TYPE)
	THEN
	(
		(IF(IsPatternPresent MESSAGE "{1:F21")
			THEN
			(
				(IF(IsPatternPresent MESSAGE "{451:0")
				THEN
					(ASSIGN MSG_TYPE "ACK")
				ELSE
					(ASSIGN MSG_TYPE "NAK")
				)
			)
		 )
	)
)
(IF (AND (IsPatternPresent "COV" BLOCK3_SUB_DATA)
         (IsEqualString MSG_TYPE "202")


     )
     THEN
        (
             (ASSIGN MSG_TYPE (APPEND MSG_TYPE "COV"))
         )
)

(MemTblSetTableValue "STREAM_DETAILS" "MSGTYPE" MSG_TYPE)
(MemTblSetTableValue "STREAM_DETAILS" "MSG_DIRECTION" MSG_DIRECTION) ;; PELPAYP-938

(XT-AVLB-VALD-FLAG-PAYMT)

(IF(OR(ISEqualString QUEUE_ID "CRPFINFQ")
      (ISEqualString QUEUE_ID "CORPINFQ")
	  (ISEqualString QUEUE_ID "PAYINFQ")
    )
 THEN
  (RETURN "DEBULK-FLOW-PYMT")
 )


(IF (IsEqualString INPUT_CHANNEL "REL-DB-IN-1")
THEN
    (
       (RETURN "RELEASE_HLDQ_FRM_DB_FLOW")
    )
)


(IF (IsEqualString QUEUE_ID "ROUTEIN")
    THEN
        (
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
 )


(IF (AND (OR (IsEqualString QUEUE_ID "CRPMQQUT")
			 ;(IsEqualString INPUT_CHANNEL "MQ-MAIN-IP-3")
		 )
         (OR (IsEqualString ST_MSGTYPE "ACK")
             (IsEqualString ST_MSGTYPE "NAK")
         )
    )
      THEN
        (
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
)
;;Added on 08/03/2018  by DILIP FOR ENI
(IF (AND (IsEqualString INPUT_CHANNEL "SWF-FIN-IN")
             (OR (IsEqualString MSG_TYPE "195")
                (IsEqualString MSG_TYPE "199")
                (IsEqualString MSG_TYPE "295")
                (IsEqualString MSG_TYPE "999")
		        (IsEqualString MSG_TYPE "299")
              )
     )
      THEN
        (
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
 )
;;end
(IF ;(AND
	( OR (IsEqualString INPUT_CHANNEL "BO1-SWFT-OB-IN")
			  (IsEqualString INPUT_CHANNEL "STP-ACBS-IN")
			  (IsEqualString INPUT_CHANNEL "STP-FRAR-IN")
			  (IsEqualString INPUT_CHANNEL "STP-GLBS-IN")
			  (IsEqualString INPUT_CHANNEL "STP-TBLX-IN")
			  (IsEqualString INPUT_CHANNEL "SWF-FIN-IN"))
		 ;(OR (IsEqualString MSG_TYPE "101")
         ;	 (IsEqualString MSG_TYPE "103")
		 ;    (IsEqualString MSG_TYPE "103+")
         ;    (IsEqualString MSG_TYPE "210")
         ;    (IsEqualString MSG_TYPE "202")
         ;    (IsEqualString MSG_TYPE "019")
         ;    (IsEqualString MSG_TYPE "012"))
	;)
	THEN
        (
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
)
(IF (OR(IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-ERR")
       (IsEqualString INPUT_CHANNEL "CLIEOP-ROUTE-IN-ERR")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-ERR-3")
       (IsEqualString INPUT_CHANNEL "CSV-ROUTE-IN-ERR")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-STS")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-STS1")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-1")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-2")
       (IsEqualString INPUT_CHANNEL "FILE-ROUTE-IN-3")
    )
  THEN
    (
       (RETURN "FILE_ROUTE_FLOW")
    )
)
(IF ;(AND
       (IsEqualString  MQ_FLAG "Y")
        ;(IsNotEqualString  QUEUE_ID "CRPMSGIN")
    ;)
    THEN
        (
           (ASSIGN MQ_FLAG "N")
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
 )

(IF (OR ;(IsEqualString QUEUE_ID "CORPINFQ") ;; Commented by AlbinT for Product7.8.2
        (IsEqualString QUEUE_ID "STMQOUT")
        (IsEqualString QUEUE_ID "CRPMQQUT")
     )
    THEN
        (
           (RETURN "MESSAGE_EXTRACTION_FLOW")
        )
 )


;;ADDED BY DILIP ON 20/09/2017 FOR COPY OF PAYMENT TO BACKOFFICE
 (IF;(AND(OR(IsEqualString SOURCE_CHNL_ID "DB-MAIN-IP-COPY-BO")
    ;       (IsEqualString SOURCE_CHNL_ID "DB-IP-COPY-BO-SEPA"))
 	;	    (IsEqualString FLAG_COPY_BO "Y")
 	;)
	(AND(OR(IsEqualString INPUT_CHANNEL "DB-MAIN-IP-COPY-BO")
           (IsEqualString INPUT_CHANNEL "DB-IP-COPY-BO-SEPA"))
 		    (IsEqualString FLAG_COPY_BO "Y")
 	)
           THEN
             (
                (RETURN "MESSAGE_EXTRACTION_FLOW")
             )
 )


	(IF (AND(ISEQUALSTRING QUEUE_ID "CRPAHRPR")
 			(ISEQUALSTRING INPUT_CHANNEL "DB-MAIN-IP")
            )
          THEN
           (
             (RETURN "MESSAGE_EXTRACTION_FLOW")
           )
        )

    ;(IF (IsEqualString COV_MSG_TYPE "202COV")
    ;THEN
    ;    (
    ;       (RETURN)
    ;    )
    ;)

    (IF(OR (IsEqualString MSG_TYPE "101")
        (IsEqualString MSG_TYPE "103")
		(IsEqualString MSG_TYPE "103+")
        (IsEqualString MSG_TYPE "210")
        (IsEqualString MSG_TYPE "202")
       )
    THEN
        (
           (RETURN "INSTRUCTION-FLOW")
        )
    )


    (IF(AND (OR (IsEqualString MSG_TYPE "195")
                (IsEqualString MSG_TYPE "199")
                (IsEqualString MSG_TYPE "295")
                (IsEqualString MSG_TYPE "999")
		        (IsEqualString MSG_TYPE "299")
				(IsEqualString MSG_TYPE "192")
				(IsEqualString MSG_TYPE "292")
		    )
		        ;(ISNOTEQUALSTRING SOURCE_CHNL_ID "SWIFT_UPL_IN" )
			    (ISNOTEQUALSTRING CHANNEL_SOURCE "SWIFT_UPL_IN" )

       )
    THEN
        (
           (RETURN "EXCEP-INVEST-FLOW")
        )
    )
	(IF (AND(ISEQUALSTRING QUEUE_ID "CRPAHRPR")
 			(ISEQUALSTRING INPUT_CHANNEL "DB-MAIN-IP")
            )
          THEN
           (
             (RETURN "MESSAGE_EXTRACTION_FLOW")
           )
        )
	 (IF  (AND (IsPatternPresent MESSAGE "{451")     ;FOR ACK-NAK MESSAGE (IsEqualString MSG_BLOCK1 "{1:F01")
           	   (IsPatternPresent MESSAGE "{1:F21")
          )
          THEN
             (
        		(RETURN "NETWORK_RESPONSE_FLOW")
      		 )
     	  ;ELSE
          ;   (
          ;    	(IF (IsPatternPresent MESSAGE "|")
          ;		THEN
          ;  		(RETURN "INTERFACE_RESPONSE_FLOW")
          ;		)
       	  ;	 )
     )
	 (IF  ;(OR (IsPatternPresent MSG_TYPE "011")
             (IsPatternPresent MSG_TYPE "012")
          ;)
          THEN
        	(RETURN "MATCH-FLOW-011-012")
     )
    (IF  (IsPatternPresent MSG_TYPE "019")
     	THEN
      		(RETURN "MATCH-FLOW-019")
    )


)

(FUNCTION DRVE_NIBC_PRODUCT_CODE_MSG PRODUCT_CODE MSGTYPE)

(
	(VAR TXN_GROUP)
	(VAR KEY)
	(VAR MSG_MODE_IN)
	(VAR SOURCE_CHNL_ID)
	(VAR ORIG_PRODUCT_CODE)
	(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "QM"))
	(IF (ISEMPTY MSG_MODE_IN)
	THEN
	(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "MSG_MODE_IN"))
	)


	(IF (ISEMPTY MSG_MODE_IN)
		THEN
		(
			(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
			(IF (OR (ISEQUALSTRING SOURCE_CHNL_ID "FILE-ROUTE-IN")
					(ISEQUALSTRING SOURCE_CHNL_ID "SWFTFQ-IN")
					(ISEQUALSTRING SOURCE_CHNL_ID "RJE-FQ-IP-1")
				)
				THEN
				(ASSIGN MSG_MODE_IN "FILE")
			)
			;;ADDED ON 09/03/2018 BY DILIP FOR PRODUCT CODE
			(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "BO1-SWFT-OB-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
				   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
				)
				THEN
					(
					(ASSIGN MSG_MODE_IN SOURCE_CHNL_ID)
					(ASSIGN SOURCE_CHNL_ID (MemTblGetTableValue "NIBC_SWIFT_CHANNEL_DERIVATION" SOURCE_CHNL_ID))
					(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE" SOURCE_CHNL_ID)
					(DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)
					)
			)
			;;END
		)
	)
	(IF (ISEMPTY MSG_MODE_IN)
		THEN
		(
			(IF (ISEQUALSTRING SOURCE_CHNL_ID "CLIEOP-ROUTE-IN-ERR")
				THEN
				(
				(ASSIGN PRODUCT_CODE "SEPA_OUT_STS")
				(ASSIGN MSGTYPE "pain.002.001.03")
				(ASSIGN MSG_MODE_IN "FILE")
				)
			)

			(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))

			(IF (OR (ISEQUALSTRING SOURCE_CHNL_ID "SEPA Service Bureau")
				(ISEQUALSTRING SOURCE_CHNL_ID "SCT_IN")
				(ISEQUALSTRING SOURCE_CHNL_ID "SCT_INSTA_IN");;ADITI_FOR_INSTA_SUPPORT	pain.001
				(ISEQUALSTRING SOURCE_CHNL_ID "SEPA_INSTA_SVC_BUREAU_OB"));;ADITI_FOR_INSTA_SUPPORT pacs.008
				THEN
				(ASSIGN MSG_MODE_IN "FILE")
			)
		)
	)
	(IF (IsEmpty MSG_MODE_IN)
		 THEN
		   (ASSIGN MSG_MODE_IN (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "MANUAL_MODE"))
	)
	(IF (ISEMPTY MSG_MODE_IN)
	THEN
		(ASSIGN MSG_MODE_IN (MemTblGetTableValue "STREAM_DETAILS" "MANUAL_MODE"))
	)
	(IF (ISEMPTY MSG_MODE_IN )
	THEN
		(ASSIGN MSG_MODE_IN (MemTblGetTableValue "MESSAGE_DETAILS" "MANUAL_MODE"))
	)
	(ASSIGN ORIG_PRODUCT_CODE  (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "MESSAGE_DETAILS" "DERIVED_PRODUCT"))
	(IF (AND (ISEQUALSTRING MSG_MODE_IN "REPAIR")
			 (NOT (ISEMPTY ORIG_PRODUCT_CODE))
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "NOTAPPLICABLE"))
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "null"))	 ;BY ADITI
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "NULL"))	 ;BY ADITI
			 (NOT (ISEQUALSTRING ORIG_PRODUCT_CODE "Null"))
		)
		THEN
			(RETURN ORIG_PRODUCT_CODE)
	)
	(IF (ISEQUALSTRING MSG_MODE_IN "REPAIR")
	THEN
		(ASSIGN MSG_MODE_IN "MANUAL")
	)
	(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
	(IF (ISEQUALSTRING SOURCE_CHNL_ID "SWIFT_UPL_IN")
	  THEN
		  (ASSIGN MSG_MODE_IN "UPLOAD")
	)
	;;PELPAYP-1121
	(VAR HDR_PREV_QUEUE)
	(VAR CONF_PREV_QUEUE)
	(VAR DERV_PRODUCT)

	(Assign DERV_PRODUCT (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT"))
	(Assign HDR_PREV_QUEUE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "PREVQUEUEID"))
	(ASSIGN CONF_PREV_QUEUE (MemTblGetTableValue "FLAG-TABLE" "MANUAL-CREATE-QUEUES"))
	(IF (IsEqualString MSG_MODE_IN "MANUAL")
	   THEN
	     (
		   	(IF (IsPresent HDR_PREV_QUEUE)
			   THEN
				 (
				   	(IF (AND (NOT(IsPatternPresent CONF_PREV_QUEUE HDR_PREV_QUEUE))
					         (IsPresent DERV_PRODUCT)
						)
					   THEN
					     (
							(ASSIGN PRODUCT_CODE DERV_PRODUCT)
						 )
					)
				  )
			)
		 )
	)
	;;PELPAYP-1121
	(IF (OR (ISEMPTY PRODUCT_CODE)
			(ISEQUALSTRING PRODUCT_CODE "SEPA_OUT")
		)
		THEN
		(
			(ASSIGN KEY (APPEND (APPEND MSG_MODE_IN "-") MSGTYPE))
			(ASSIGN PRODUCT_CODE (MemTblGetTableValue "NIBC_PRODUCT_CODE_MSG" KEY))
		)
	)		
	(IF(OR (ISEQUALSTRING SOURCE_CHNL_ID "BO1-SWFT-OB-IN")
           (ISEQUALSTRING SOURCE_CHNL_ID "STP-ACBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-FRAR-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-GLBS-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "STP-TBLX-IN")
		   (ISEQUALSTRING SOURCE_CHNL_ID "SWF-FIN-IN")
		)
		THEN
		(ASSIGN MSG_MODE_IN "MQ")
	)

	(ASSIGN TXN_GROUP (MemTblGetTableValue "MESSAGETYPE" MSGTYPE))
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TXN_GRP" TXN_GROUP)
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_MODE_IN" MSG_MODE_IN)
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE" PRODUCT_CODE)
	(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT_CODE)

	(RETURN PRODUCT_CODE)

)

(FUNCTION DRVE_LOCATION_FRM_SRC SOURCE_CHNL_ID)

(

(VAR MSGSEGR)
(VAR NIBC_MSGSEGR)
(ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(ASSIGN NIBC_MSGSEGR (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "NIBC_MSGSEG"))
(IF(ISEMPTY SOURCE_CHNL_ID)
	THEN
		(
		 (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
		)
)
(IF(ISEMPTY SOURCE_CHNL_ID)
	THEN
		(
		 (ASSIGN SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "SOURCE_CHANNEL_ID"))
		)
)
(IF (ISEMPTY NIBC_MSGSEGR)
	THEN
	(ASSIGN MSGSEGR (MemTblGetTableValue "NIBC_CHANNEL_TO_LOCATION" SOURCE_CHNL_ID))
	ELSE
	(ASSIGN MSGSEGR (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "NIBC_MSGSEG"))
)
(IF (ISEMPTY MSGSEGR)
	THEN
			(ASSIGN MSGSEGR (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MESSAGE_SEGREGATION"))
	ELSE
	   (
			(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MESSAGE_SEGREGATION" MSGSEGR)
			(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MESSAGE_SEGREGATION" MSGSEGR)
	        (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SEGR" MSGSEGR)
	        (SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SEGR" MSGSEGR)
	   )
)

(IF (OR(ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
       (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN"))
   THEN
   (
	 (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SEGR" "DEFAULT")
	 (SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SEGR" "DEFAULT")
   )
)
)

(FUNCTION ROUTE_SEPA_STP_NIBC SOURCE_CHNL_ID MDBFL-PARAM5 PRODUCT INSTITUTION_ID)

(
(VAR GENPATH)
(VAR SERVICE_CONFIGURATION_PATH)
(VAR FILE_HASHCODE_PRODUCT)
(VAR CHECK_N_RELEASE_PRODUCT)
(VAR FLAG)
(VAR MDBFL-FILENAME)
(VAR VALUE_DATE)
(VAR TIME)
(VAR FILE_NAME)
(VAR SEQ_NUMBER)
(ASSIGN FLAG "N")
(VAR QUEUE_ID)
(VAR MSGTYPE)
(VAR QUEUEID)
(VAR MDBFL-FILENAME_OUT)
;(DERIVE_PRODUCT_FOR_FILE)
(VAR FILENAME)
(VAR MESSAGECLASSTYPE)
(VAR DIRECTION)
(VAR COMMENTS_FOR_BLOB6)
(VAR SOURCE_CHNL_ID_1)
(VAR FILEACT_KEY)
(VAR FILEACT_FLAG)
(VAR INSTITUTIONID)
(ASSIGN MDBFL-FILENAME_OUT "IN.FILEQ-MSG.MDBFL-OUTPUT-FILENAME")
(ASSIGN FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
(ASSIGN FILENAME (Upper FILENAME))
(Assign QUEUEID "IN.FILEQ-MSG.QUEUEID" )
(Assign SOURCE_CHNL_ID (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(Assign SOURCE_CHNL_ID_1  "IN.FILEQ-MSG.SOURCE-CHANNEL-ID")

(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INPUT_TO_PELICAN" "Y")    
(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "OUTPUT_FROM_PELICAN" "Y")  

(IF (AND (IsPresent FILENAME)
		 ;(ISEQUALSTRING SOURCE_CHNL_ID "SEPA-Ib")
		(OR (ISEQUALSTRING SOURCE_CHNL_ID "EQUENS_SEPA_IN")
		(ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In NFA")
		(ISEQUALSTRING SOURCE_CHNL_ID "Equens SEPA In")
		)
		
	)
	THEN
		(
	   		(ASSIGN MESSAGECLASSTYPE (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "MESSAGE_CLASS_TYPE"))
			(ASSIGN DIRECTION (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "MESSAGE_DIRECTION"))
			(IF (AND (IsPatternPresent MESSAGECLASSTYPE "pacs.002")
					 (ISEQUALSTRING DIRECTION "O")
					 (NOT (OR (IsPatternPresent FILENAME "CTRPS")
						      (IsPatternPresent FILENAME "CTPS")
							  (IsPatternPresent FILENAME "CTRJ")
							  (IsPatternPresent FILENAME "CTRTRJ")
			               )
					 )
				)
				THEN
				   (
				   		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PROCEXFQ")
                		(ASSIGN COMMENTS_FOR_BLOB6 "P00-1:A00:00-8474") ;Invalid File Format For This Source Channel
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
				   )	
			
			)
			(IF (AND (IsPatternPresent MESSAGECLASSTYPE "pacs.004")
					 (ISEQUALSTRING DIRECTION "O")
					 (NOT (IsPatternPresent FILENAME "CTRTBI"))
				)
				THEN
				   (
				   		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PROCEXFQ")
                		(ASSIGN COMMENTS_FOR_BLOB6 "P00-1:A00:00-8474") ;Invalid File Format For This Source Channel
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
				   )	
			
			)
			(IF (AND (IsPatternPresent MESSAGECLASSTYPE "pacs.008")
					 (ISEQUALSTRING DIRECTION "O")
					 (NOT (IsPatternPresent FILENAME "CTBI"))
				)
				THEN
				   (
				   		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PROCEXFQ")
                		(ASSIGN COMMENTS_FOR_BLOB6 "P00-1:A00:00-8474") ;Invalid File Format For This Source Channel
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS_FOR_BLOB6" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "COMMENTS" COMMENTS_FOR_BLOB6)
                		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
				   )	
			
			)
		)
)

(IF  (ISEMPTY MDBFL-PARAM5)
    THEN
    (
		(ASSIGN GENPATH ".PROCESSING_STAGES.ACCEPT.PRODUCTS")
		(ASSIGN SERVICE_CONFIGURATION_PATH (APPEND INSTITUTION_ID GENPATH))
		(ASSIGN FILE_HASHCODE_PRODUCT (MemTblGetTableValue "INST_PARAM" SERVICE_CONFIGURATION_PATH))

		(IF (AND (IsPatternPresent FILE_HASHCODE_PRODUCT PRODUCT)
				 (NOT (IsPatternPresent MDBFL-PARAM5 "01HASH"))
			)
			THEN
			   (
			   	   (Assign MDBFL-PARAM5 (Append "01HASH|" MDBFL-PARAM5))
				   (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
			   )
		)

		(ASSIGN GENPATH ".PROCESSING_STAGES.CHECK_AND_RELEASE.PRODUCTS")
		(ASSIGN SERVICE_CONFIGURATION_PATH (APPEND INSTITUTION_ID GENPATH))
		(ASSIGN CHECK_N_RELEASE_PRODUCT (MemTblGetTableValue "INST_PARAM" SERVICE_CONFIGURATION_PATH))
		(IF (AND(IsPatternPresent CHECK_N_RELEASE_PRODUCT PRODUCT)
				(NOT (IsPatternPresent MDBFL-PARAM5 "3.5CHCKRS"))
			)
		    THEN
		       (
		           (Assign MDBFL-PARAM5 (Append "3.5CHCKRS|" MDBFL-PARAM5))
				   (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
			   )
		)
	)
)

;(IF (ISEQUALSTRING SOURCE_CHNL_ID "Thaler BE SEPA In")
;	THEN
;	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ1")
;)

;(IF (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In")
;	THEN
;	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ2")
;)

(IF (AND(IsPatternPresent MDBFL-PARAM5 "01HASH")
		(OR (IsEqualString SOURCE_CHNL_ID "Thaler BE SEPA In")
			(IsEqualString SOURCE_CHNL_ID "BE SEPA In")
			(ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
		)
	)
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "HASHVRFQ")
        (Assign MDBFL-PARAM5 (RemovePattern MDBFL-PARAM5 "01HASH|"))
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		;(MemTblSetTableValue "StreamTable" "previous_stage" "01HASH|")
        (Assign FLAG "Y")
    )
)

(IF (AND (IsPatternPresent MDBFL-PARAM5 "3.5CHCKRS")
		 (IsEqualString FLAG "N")
		(OR (IsEqualString SOURCE_CHNL_ID "BE SEPA In")
			(ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
			(IsEqualString SOURCE_CHNL_ID "Thaler BE SEPA In")
		)
	 )
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "CHCKRSFQ")
        (Assign MDBFL-PARAM5 (RemovePattern MDBFL-PARAM5 "3.5CHCKRS|"))
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
		;(MemTblSetTableValue "StreamTable" "previous_stage" "3.5CHCKRS|")
		;(ASSIGN GV_DONE_STAGES (APPEND GV_DONE_STAGES "3.5CHCKRS|"))
        (Assign FLAG "Y")
    )
)

(ASSIGN INSTITUTIONID (GETVALUEFROMHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "INSTITUTION_ID"))
(ASSIGN FILEACT_KEY (APPEND (APPEND INSTITUTIONID ".MESSAGE_PROCESSING.FUNCTIONALITY.FILEACT_CHECK") ".FILEACT_CHECK_REQD"))
;(ASSIGN FILEACT_KEY ".MESSAGE_PROCESSING.FUNCTIONALITY.FILEACT_CHECK")
(ASSIGN FILEACT_FLAG (MemTblGetTableValue "INST_PARAM" FILEACT_KEY))

		(IF (AND (IsEqualString MDBFL-PARAM5 "04END")
		;(IsEqualString FILEACT_FLAG "N")
		 (IsEqualString FLAG "N")
		 (OR (IsEqualString SOURCE_CHNL_ID "BE SEPA In")
			 (ISEQUALSTRING SOURCE_CHNL_ID "BE SEPA In NFA") ;ADDED BY SAMEER ON 25/01/2022 FOR INBOUND
		    ;(IsEqualString SOURCE_CHNL_ID "Thaler BE SEPA In")
		)	
		)
			THEN
			(
				(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "DISPLAY_FLAG" "Y")
				(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ1")
				(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
				(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
				(ASSIGN MSGTYPE (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "MSG_CLS_TYPE")) 
				(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "MSG_CLS_TYPE" "SEPA")
				(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MSG_CLS_TYPE" "SEPA")
				;(Assign "OUT.FILEQ-MSG.MSG_CLS_TYPE" "SEPA")
				;(ACELOG MSGTYPE)
				;(ACELOG "Aditi")
				;(Assign "OUT.FILEQ-MSG.MESSAGE_CLASS_TYPE" "SEPA")
				(Assign FLAG "Y")
				(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
				(ASSIGN VALUE_DATE (date))
				;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
				(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
				(ASSIGN TIME (SUBSTR TIME 1 8))
				(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
				(IF (OR(IsEqualString SOURCE_CHNL_ID "BE SEPA In NFA")
					(IsEqualString SOURCE_CHNL_ID "BE SEPA In")
					)
					THEN
						(
							(ASSIGN SOURCE_CHNL_ID "THALERBEOUT")
							(ASSIGN FILE_NAME (APPEND(APPEND(APPEND FILE_NAME MDBFL-FILENAME)SOURCE_CHNL_ID)VALUE_DATE))
							(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
							(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILE-EXTENSION" "XML")
							(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)
						)
				)
			)
		)
(IF (AND (IsEqualString FLAG "N")
		 (OR (IsEqualString SOURCE_CHNL_ID "Plcn Thaler NL SEPA In")
		 	  (IsEqualString SOURCE_CHNL_ID "Plcn TBLOX SEPA In")
			  (IsEqualString SOURCE_CHNL_ID "Plcn CashFac SEPA In")
		 )
		 (NOT (OR (ISPATTERNPRESENT MDBFL-FILENAME_OUT "ThalerNLPELREJOut")
				  (ISPATTERNPRESENT MDBFL-FILENAME_OUT "TBLOXPELREJOut")
				  (ISPATTERNPRESENT MDBFL-FILENAME_OUT "CashFacPELREJOut")
			  )
		 )	
	     (IsEqualString MDBFL-PARAM5 "04END")
		 (IsEqualString QUEUEID "INPFILEQ")
	 )
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SSRINFQ")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
	    (ASSIGN VALUE_DATE (date))
		;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
		(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
		(ASSIGN TIME (SUBSTR TIME 1 8))
		(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
		(IF (IsEqualString SOURCE_CHNL_ID "Plcn Thaler NL SEPA In")
			THEN
			(ASSIGN SOURCE_CHNL_ID "ThalerNLPELREJOut")	
		)
		(IF (IsEqualString SOURCE_CHNL_ID "Plcn TBLOX SEPA In")
			THEN
			(ASSIGN SOURCE_CHNL_ID "TBLOXPELREJOut")	
		)
		(IF (IsEqualString SOURCE_CHNL_ID "Plcn CashFac SEPA In")
			THEN
			(ASSIGN SOURCE_CHNL_ID "CashFacPELREJOut")	
		)
		
		;(Assign FILE_NAME (Append (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE) ".xml"))
		(Assign FILE_NAME (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE))
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(RETURN)
	)
)
;;ADDED BY DILIP ON 31052018
(IF (AND (IsEqualString FLAG "N")
		 (OR (IsEqualString SOURCE_CHNL_ID_1 "SEPA-Ob")
		  	  (IsEqualString SOURCE_CHNL_ID_1 "EQUENS_SEPA_OB")
			  (IsEqualString SOURCE_CHNL_ID_1 "Thaler NL SEPA In")
		 	  (IsEqualString SOURCE_CHNL_ID_1 "TBLOX SEPA In")
			  (IsEqualString SOURCE_CHNL_ID_1 "CashFac SEPA In")
		 )		 	
	     (IsEqualString MDBFL-PARAM5 "04END")
		 (IsEqualString QUEUEID "INPFILEQ")
		 (IsPatternPresent (UPPER MESSAGECLASSTYPE) "PACS.002")
	 )
    THEN
    (
        ;(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SSRINFQ")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
	    (ASSIGN VALUE_DATE (date))
		;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
		(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
		(ASSIGN TIME (SUBSTR TIME 1 8))
		(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
		(IF ;(IsEqualString SOURCE_CHNL_ID_1 "SEPA-Ob")
		     (IsEqualString SOURCE_CHNL_ID_1 "EQUENS_SEPA_OB")
			THEN
			(	
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ3")
			(ASSIGN SOURCE_CHNL_ID "THALERNLOUT")
			)
		)
		(IF (IsEqualString SOURCE_CHNL_ID_1 "TBLOX SEPA In")
			THEN
			(
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ6")
			(ASSIGN SOURCE_CHNL_ID "DEFAULT")
			)
		)
		(IF (IsEqualString SOURCE_CHNL_ID_1 "CashFac SEPA In")
			THEN
			(
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ5")
			(ASSIGN SOURCE_CHNL_ID "CASHFACOUT")
			)
		)

		;(Assign FILE_NAME (Append (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE) ".xml"))
		(Assign FILE_NAME (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE))
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(RETURN)
	)
)
;;END
(IF (AND (IsEqualString FLAG "N")
		 (OR (IsEqualString SOURCE_CHNL_ID "Plcn Thaler NL SEPA In")
			 (ISPATTERNPRESENT MDBFL-FILENAME_OUT "ThalerNLPELREJOut")
		 )
	     (IsEqualString QUEUEID "INPFILEQ")
	 )
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PACSTSQ3")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
	    (ASSIGN VALUE_DATE (date))
		;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
		(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
		(ASSIGN TIME (SUBSTR TIME 1 8))
		(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
		(ASSIGN SOURCE_CHNL_ID "ThalerNLPELREJOut")
		;(Assign FILE_NAME (Append (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE) ".xml"))
		(Assign FILE_NAME (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE))
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)



    )
)

(IF (AND (IsEqualString FLAG "N")
		 (OR (IsEqualString SOURCE_CHNL_ID "Plcn TBLOX SEPA In")
			  (ISPATTERNPRESENT MDBFL-FILENAME_OUT "TBLOXPELREJOut")
		 )
		 (IsEqualString QUEUEID "INPFILEQ")
	 )
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PACSTSQ1")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
	    (ASSIGN VALUE_DATE (date))
		;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
		(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
		(ASSIGN TIME (SUBSTR TIME 1 8))
		(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
		(ASSIGN SOURCE_CHNL_ID "TBLOXPELREJOut")
		;(Assign FILE_NAME (Append (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE) ".xml"))
		(Assign FILE_NAME (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE))
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)



    )
)

(IF (AND (IsEqualString FLAG "N")
		(OR (IsEqualString SOURCE_CHNL_ID "Plcn CashFac SEPA In")
			(ISPATTERNPRESENT MDBFL-FILENAME_OUT "CashFacPELREJOut")
		)
		 (IsEqualString MDBFL-PARAM5 "04END")
		 (IsEqualString QUEUEID "INPFILEQ")
	 )
    THEN
    (
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "PACSTSQ2")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
	    (ASSIGN VALUE_DATE (date))
		;(ASSIGN VALUE_DATE (ConvertDateFormat VALUE_DATE "YYMMDD" "CCYYMMDD"))
		(Assign TIME (GETLOCALTIMEINHHMMSSMSFORMAT))
		(ASSIGN TIME (SUBSTR TIME 1 8))
		(ASSIGN VALUE_DATE (APPEND VALUE_DATE (REPLACEALLPATTERN TIME ":" "")))
		(ASSIGN SOURCE_CHNL_ID "CashFacPELREJOut")
		;(Assign FILE_NAME (Append (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE) ".xml"))
		(Assign FILE_NAME (Append (Append MDBFL-FILENAME SOURCE_CHNL_ID)  VALUE_DATE))
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)



    )
)

(IF (AND (IsEqualString MDBFL-PARAM5 "04END")
		 (IsEqualString FLAG "N")
		 (IsEqualString SOURCE_CHNL_ID "Thaler BE SEPA In")
		 (IsEqualString QUEUEID "INPFILEQ")
	 )
    THEN
    (
		(FILEACT_HEADERS)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "DISPLAY_FLAG" "Y")
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" "SEPSTPQ2")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
		(SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "MSG_CLS_TYPE" "SEPA")
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MSG_CLS_TYPE" "SEPA")
		;(Assign "OUT.FILEQ-MSG.MSG_CLS_TYPE" "SEPA")
		;(ACELOG MSGTYPE)
		;(ACELOG "Aditi")
		;(Assign "OUT.FILEQ-MSG.MESSAGE_CLASS_TYPE" "SEPA")
        (Assign FLAG "Y")
		(ASSIGN MDBFL-FILENAME "IN.FILEQ-MSG.MDBFL-FILENAME")
		(ASSIGN SEQ_NUMBER "IN.FILEQ-MSG.MESSAGENO")
		(ASSIGN SEQ_NUMBER (STRSUB SEQ_NUMBER 6 12))
		;(Assign FILE_NAME (Append (Append "Ingsepa" SEQ_NUMBER) ".xml"))
		;(Assign FILE_NAME (Append "Ingsepa" SEQ_NUMBER))
		;(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-FILENAME" FILE_NAME)
		(Assign FILE_NAME MDBFL-FILENAME)
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILENAME" FILE_NAME)
		(Assign "OUT.FILEQ-MSG.MDBFL-OUTPUT-FILE-EXTENSION" "XML")
		;(Assign "IN.FILEQ-MSG.MDBFL-FILENAME" FILE_NAME)
		;(Assign "OUT.FILEQ-MSG.MDBFL-FILENAME" FILE_NAME)
		(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "FILE_NAME" FILE_NAME)

    )
)
(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBFL-PARAM5" MDBFL-PARAM5)
)

(FUNCTION NIBC_DERIVE_MESSAGE_CLASSTYPE MSGTYPE)
(
   (VAR MSG_DIRECTION)
   (VAR TXN_GROUP)
   (ASSIGN MSG_DIRECTION (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "MESSAGE_DIRECTION"))
   (IF (ISEMPTY MSG_DIRECTION)
		THEN
		(
			(ASSIGN MSG_DIRECTION (MemTblGetTableValue "STREAM_DETAILS" "MSG_DIRECTION" MSG_DIRECTION))
		)
	)
   
   (IF (NOT (OR(IsEqualString MSGTYPE "101")
               (IsEqualString MSGTYPE "103")
	           (IsEqualString MSGTYPE "103+")
               (IsEqualString MSGTYPE "210")
               (IsEqualString MSGTYPE "202")
               (IsEqualString MSGTYPE "019")
               (IsEqualString MSGTYPE "012")
               (IsEqualString MSGTYPE "195")
               (IsEqualString MSGTYPE "199")
               (IsEqualString MSGTYPE "295")
               (IsEqualString MSGTYPE "999")
		       (IsEqualString MSGTYPE "299")
		       (IsEqualString MSGTYPE "ACK")
		       (IsEqualString MSGTYPE "NAK")
			   (IsEqualString MSGTYPE "192")
			   (IsEqualString MSGTYPE "292"))
		)
		THEN
		(
		  ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE" "UNSUPPORTED")
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "GV_MESSAGE_CLASS_TYPE" "UNSUPPORTED")
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "PROCESSING_STAGE" "ERR")
		  ;(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TXN_GRP" "EFT")
		  (ASSIGN TXN_GROUP (MemTblGetTableValue "MESSAGETYPE" "UNSUPPORTED"))
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TXN_GRP" TXN_GROUP)		  
		)
	)
	
	(IF (AND (IsEqualString MSG_DIRECTION "I")
			 (OR(IsEqualString MSGTYPE "019")
                (IsEqualString MSGTYPE "012")
                (IsEqualString MSGTYPE "195")
                (IsEqualString MSGTYPE "199")
                (IsEqualString MSGTYPE "295")
                (IsEqualString MSGTYPE "999")
		        (IsEqualString MSGTYPE "299")
		        (IsEqualString MSGTYPE "ACK")
		        (IsEqualString MSGTYPE "NAK")
			 )
			
		)
		THEN
		(
		  ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE" "UNSUPPORTED")
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "GV_MESSAGE_CLASS_TYPE" "UNSUPPORTED")
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "PROCESSING_STAGE" "ERR")
		  ;(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TXN_GRP" "ENI")
		  (ASSIGN TXN_GROUP (MemTblGetTableValue "MESSAGETYPE" MSGTYPE))
		  (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TXN_GRP" TXN_GROUP)
		)
	)
)
;;added by ashishGD for MIML institution derivation in product ;;should be deleted in project
;;start
(FUNCTION DRVE_INSTITUTION_FRM_SRC_CHNL SOURCE_CHNL_ID)

(

(VAR MSGSEGR)
(VAR INSTITUTIONID)
(VAR MSG_MODE_IN)

(IF (NOT (ISEMPTY SOURCE_CHNL_ID))
	THEN
	(
		(ASSIGN INSTITUTIONID (MemTblGetTableValue "INSTITUTION_FROM_SRC_CHANNEL" SOURCE_CHNL_ID))
		(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "INSTITUTION_ID" INSTITUTIONID)
		(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "INSTITUTION_ID" INSTITUTIONID)
		(MemTblSetTableValue "StreamTable" "InstitutionID" INSTITUTIONID)
		(SETVALUETOHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "INSTITUTIONID" INSTITUTIONID)
		(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "INSTITUTIONID" INSTITUTIONID)
	)
)

)
;;added by ashishGD for MIML in 78835
(FUNCTION DRVE_LOCATION_VALUE_KEY )

(
 

;; Developed by Albin (05 DEC 2011)
;; This rule Derives values for location from database. If it does not derive value it takes Default Location

(VAR CHANNEL)
(VAR CURRENCY)
(VAR DIRECTION)
(VAR BLK1_CTRY)
(VAR BLK1_BIC)
(VAR BLK2_CTRY)
(VAR BLK2_BIC)
(VAR CNTRY)
(VAR COUNTRY)
(VAR BLOCK1_DATA)
(VAR BLOCK2_DATA)
(VAR INSTITUTIONID)
(VAR FINAL_KEY_VALUE)
(VAR POS)
(VAR POS1)
(VAR DEFLT_LOCN)
(VAR LOCATION_KEY)
(VAR PATT_POS)
(VAR LENT)
(VAR VALUE)
(VAR VALUE1)
(VAR LENT1)
(VAR KEY_VALUE)
(VAR FIRST_KEY)
(VAR SECOND_KEY)
(VAR TD_VALUE)
(VAR FLAG)
(VAR CHK_KEY_VALUE)
(VAR COUNT)
(VAR I)
(VAR J)
(VAR K)
(VAR EQLPOS)
(VAR EQLPOS1)
(VAR EQLPOS2)
(VAR FAMILY)
(VAR TYPE)
(VAR LOCATION)

(ASSIGN COUNT 1)
(ASSIGN I 0)
(ASSIGN J 0)
(ASSIGN K 1)


    (ASSIGN FAMILY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_FAMILY"))
    (ASSIGN CHANNEL (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))   ;; For MI/ML
    (ASSIGN CURRENCY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CURRENCY"))
    (ASSIGN DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_DIRECTION"))
    (ASSIGN TYPE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGTYPE"))
    (ASSIGN BLK1_BIC (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK1_BIC"))
    (ASSIGN BLK2_CTRY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK2_CTRY"))
    (ASSIGN BLK2_BIC (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK2_BIC"))
    (ASSIGN COUNTRY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COUNTRY"))
    (ASSIGN INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INSTITUTION_ID"))
    (ASSIGN LOCATION "") 
    
    ;INSTITUTIONID|CHANNEL|FAMILY|TYPE|DIRECTION|COUNTRY  

    (IF (IsPresent BLK1_CTRY)
       THEN
         (
            (Assign COUNTRY BLK1_CTRY)
         )
       ELSE
         (
           (IF (IsPresent BLK2_CTRY)
              THEN
                (
                   (Assign COUNTRY BLK2_CTRY)   
                )
              ELSE
                (
                  (IF (IsPresent CNTRY)
                    THEN
                      (
                         (Assign COUNTRY CNTRY)
                      )
                  )
                )
            )
         )
    )

    (IF (OR (IsPresent BLK1_BIC)
            (IsPresent BLK2_BIC)
        )
       THEN
         (
            (IF (IsPresent BLK1_BIC)
               THEN
                 (
                   (Assign BLOCK1_DATA BLK1_BIC)
                 )
               ELSE
                 (
                   (Assign BLOCK2_DATA BLK2_BIC)        
                 )
            )
            
         )
    )

    (Assign LOCATION_KEY (Append INSTITUTIONID ".OPERATIONAL_CONF.PROCESSING.LOCATION.LOCATION_KEY"))                                                                                                                            
    (Assign LOCATION_KEY (MemTblGetTableValue "INST_PARAM" LOCATION_KEY))
    (IF(ISPRESENT LOCATION_KEY)
     THEN
      (
        (ASSIGN LOCATION_KEY (APPEND LOCATION_KEY "|"))
      )
    )    
    (IF (IsPresent LOCATION_KEY)
       THEN
         (
            (WHILE(ISLESSTHAN I COUNT)
                         (IF (OR (ISPRESENT LOCATION_KEY)
                                     (ISPATTERNPRESENT LOCATION_KEY "|")
                                 )                
                         THEN
                (
                 (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" 1))
                 ;; IF "|" is at start position then it will remove.
                 (IF(ISEQUAL PATT_POS 1)
                  THEN
                   (
                     (ASSIGN LOCATION_KEY (ReplacePattern LOCATION_KEY  "|" ""))
                     (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" 1))
                   )
                 )
                 (ASSIGN LENT (LENGTH LOCATION_KEY))
                 (ASSIGN VALUE (SUBSTR LOCATION_KEY PATT_POS LENT ))
                 (ASSIGN VALUE1 (RemovePattern LOCATION_KEY VALUE))

                 (IF(ISPRESENT VALUE1)
                 THEN
                  (
                   (ASSIGN PATT_POS (SearchNthPattern VALUE1 "|" -1))
                   (ASSIGN LENT1 (LENGTH VALUE1))
                   (ASSIGN VALUE (SUBSTR VALUE1 (+ PATT_POS 1) LENT1 ))
                  )
                 ELSE
                  (
                    ;; this condition will be used when "|" is at start position.
                   (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" -1))
                   (ASSIGN LENT1 (LENGTH LOCATION_KEY))
                   (ASSIGN VALUE (SUBSTR LOCATION_KEY (+ PATT_POS 1) LENT1 ))
                  )
                 )
                )
              ELSE
                (
                  (ASSIGN VALUE LOCATION_KEY)
                )
                        )
      (IF(ISPRESENT VALUE)
       THEN
        (
         (IF (IsEqualString VALUE "CHANNEL")
          THEN
           (
              (IF (IsPresent CHANNEL)
               THEN
                 (
                        (Assign KEY_VALUE (Append KEY_VALUE (Append CHANNEL "|")))
                 )
                 ELSE
                  (
                    (Assign KEY_VALUE (Append KEY_VALUE "|"))
                  )
              )

             (IF(ISPATTERNPRESENT LOCATION_KEY "|")
              THEN
               (
                (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                (IF(ISPRESENT LOCATION_KEY)
                 THEN 
                      (ASSIGN COUNT(+ COUNT 1))
                )
               )
             )
           )
         )

         (IF(IsEqualString VALUE "CURRENCY") 
              THEN
               (
                   (IF (IsPresent CURRENCY)
                                THEN
                     (
                       (Assign KEY_VALUE (Append KEY_VALUE (APPEND CURRENCY "|")))
                     )
                      ELSE
                 (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )
                   )
                   
                 (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                  THEN
                   (
                    (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                    (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                    (IF(ISPRESENT LOCATION_KEY)
                     THEN 
                          (ASSIGN COUNT(+ COUNT 1))
                    )
                   )
                 )
               )
            )

            (IF(IsEqualString VALUE "COUNTRY") 
                THEN
                 (
                    (IF (IsPresent COUNTRY)     
                                  THEN
                         (
                             (Assign KEY_VALUE (Append KEY_VALUE (APPEND COUNTRY "|")))
                         )
                        ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                    )

                  (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                   THEN
                    (
                     (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                     (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                     (IF(ISPRESENT LOCATION_KEY)
                     THEN 
                          (ASSIGN COUNT(+ COUNT 1))
                    )
                   )
                  )
                )
             )

             (IF(IsEqualString VALUE "BIC") 
                  THEN
                  (
                                 (IF (IsPresent BLOCK1_DATA)
                                        THEN
                                  (
                                  (ASSIGN BLOCK1_DATA (SubStr BLOCK1_DATA 1 8))
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND BLOCK1_DATA "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                     )

                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )

              (IF(IsEqualString VALUE "RECEIVER") 
                  THEN
                  (
                                 (IF (IsPresent BLOCK2_DATA)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND BLOCK2_DATA "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )  
                      )
    
                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )
              
              (IF(IsEqualString VALUE "DIRECTION") 
                  THEN
                  (
                                 (IF (IsPresent DIRECTION)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND DIRECTION "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                     )

                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )
              
              (IF(IsEqualString VALUE "INSTITUTIONID") 
                  THEN
                  (
                                 (IF (IsPresent INSTITUTIONID)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND INSTITUTIONID "|")))
                              )
                             ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )  
                     )
                   
                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                  )
              ) 
              
              (IF(IsEqualString VALUE "FAMILY") 
                 THEN
                 (
                                (IF (IsPresent FAMILY)
                                       THEN
                                 (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND FAMILY "|")))
                             )
                              ELSE
                  (
                    (Assign KEY_VALUE (Append KEY_VALUE "|"))
                  )
                     )              
                  
 (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                   
                     THEN
                      (
                       (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))
                       (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                       (IF(ISPRESENT LOCATION_KEY)
                        THEN                         
                            (ASSIGN COUNT(+ COUNT 1))
                       )
                      )
                     )
                    )
                  )
                  (IF(IsEqualString VALUE "TYPE") 
                
                   THEN
                   (
                               (IF (IsPresent TYPE)
                                      THEN
                                 (
                               (Assign KEY_VALUE (Append KEY_VALUE (APPEND TYPE "|")))
                                 )
                                  ELSE
                   (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                   )
                      )
                  
                      (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                    
                       THEN
                       (
                         (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))
                         (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                         (IF(ISPRESENT LOCATION_KEY)
                           THEN
                                (ASSIGN COUNT(+ COUNT 1))
                         )
                         )
                        )
                      )
                   )
                   
                )
           )
   (ASSIGN I(+ I 1))
  )
 )
)

    (Assign FINAL_KEY_VALUE KEY_VALUE)
    (Assign POS (SearchNthPattern FINAL_KEY_VALUE "|" -1))
    (Assign POS1 (- POS 1))
    (Assign FINAL_KEY_VALUE (StrSub FINAL_KEY_VALUE 1 POS1))

    (IF (IsPresent FINAL_KEY_VALUE)
   THEN
    (

        (Assign FIRST_KEY (MemTblGetFirstKeyForTable "LOCATION_DERIVE"))
        (WHILE (Ispresent FIRST_KEY)

            (ASSIGN TD_VALUE (MemTblGetTableValue "LOCATION_DERIVE" FIRST_KEY))

            ;Ld updated after change in TDVALUE to take location code e.g. 103|I|AUD=SYD
            (Assign EQLPOS (SearchNthPattern TD_VALUE "=" 1))
            (Assign EQLPOS1 (- EQLPOS 1))
            (Assign EQLPOS2 (+ EQLPOS 1))
            (IF (IsGreaterThan EQLPOS1 0)
             THEN
                 (
                    (Assign FIRST_KEY (StrSub TD_VALUE EQLPOS2 (LENGTH TD_VALUE)))
                    (Assign TD_VALUE (StrSub TD_VALUE 1 EQLPOS1))
                 )
            )
        
                    (ASSIGN TD_VALUE (APPEND TD_VALUE "|")) 
                    (ASSIGN TD_VALUE (REMOVEPATTERN TD_VALUE "||"))
                 (IF (ISEQUAL (SearchNthPattern TD_VALUE "|" -1) (STRLEN TD_VALUE))
                     THEN
                      (
                      (ASSIGN TD_VALUE (APPEND TD_VALUE "|"))
                      (ASSIGN TD_VALUE (REMOVEPATTERN TD_VALUE "||"))
                      )
                 )      

            (IF (ISPATTERNPRESENT FINAL_KEY_VALUE TD_VALUE)
             THEN
                 ( 
                    (IF (ISPATTERNPRESENT FIRST_KEY "_")
                    THEN
                        (
                           (ASSIGN FIRST_KEY (APPEND "_" FIRST_KEY))
                           (ASSIGN FIRST_KEY (DATA_BETWEEN_TOKENS "_" "_" FIRST_KEY ))
                       )
                    )
                    (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGSEGR" FIRST_KEY)
                    (RETURN FIRST_KEY)
                  )
             )
                
                (ASSIGN FIRST_KEY "")

                (Assign FIRST_KEY (MemTblGetNextKeyForTable))   

        )
    )
 )

    
    (IF (NOT (IsPresent FIRST_KEY)
        )
      THEN
       (
          (Assign DEFLT_LOCN (Append INSTITUTIONID ".OPERATIONAL_CONF.PROCESSING.LOCATION.DEFAULT_LOCATION"))                                                                                                                            
          (Assign DEFLT_LOCN (MemTblGetTableValue "INST_PARAM" DEFLT_LOCN))
          (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGSEGR" DEFLT_LOCN)
       )
    )


)

(FUNCTION DRVE_LOCATION_VALUE_KEY_RECALL )

(
;;added by hatim to display location on MSGSEGR column  
;; This rule Derives values for location from database. If it does not derive value it takes Default Location

(VAR CHANNEL)
(VAR CURRENCY)
(VAR DIRECTION)
(VAR BLK1_CTRY)
(VAR BLK1_BIC)
(VAR BLK2_CTRY)
(VAR BLK2_BIC)
(VAR CNTRY)
(VAR COUNTRY)
(VAR BLOCK1_DATA)
(VAR BLOCK2_DATA)
(VAR INSTITUTIONID)
(VAR FINAL_KEY_VALUE)
(VAR POS)
(VAR POS1)
(VAR DEFLT_LOCN)
(VAR LOCATION_KEY)
(VAR PATT_POS)
(VAR LENT)
(VAR VALUE)
(VAR VALUE1)
(VAR LENT1)
(VAR KEY_VALUE)
(VAR FIRST_KEY)
(VAR SECOND_KEY)
(VAR TD_VALUE)
(VAR FLAG)
(VAR CHK_KEY_VALUE)
(VAR COUNT)
(VAR I)
(VAR J)
(VAR K)
(VAR EQLPOS)
(VAR EQLPOS1)
(VAR EQLPOS2)
(VAR FAMILY)
(VAR TYPE)
(VAR LOCATION)

(ASSIGN COUNT 1)
(ASSIGN I 0)
(ASSIGN J 0)
(ASSIGN K 1)


    (ASSIGN FAMILY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_FAMILY"))
    (ASSIGN CHANNEL (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))   ;; For MI/ML
    (ASSIGN CURRENCY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CURRENCY"))
    (ASSIGN DIRECTION (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSG_DIRECTION"))
    (ASSIGN TYPE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGTYPE_RECALL"))
    (ASSIGN BLK1_BIC (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK1_BIC"))
    (ASSIGN BLK2_CTRY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK2_CTRY"))
    (ASSIGN BLK2_BIC (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BLOCK2_BIC"))
    (ASSIGN COUNTRY (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COUNTRY"))
    (ASSIGN INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INSTITUTION_ID"))
    (ASSIGN LOCATION "") 
    
    ;INSTITUTIONID|CHANNEL|FAMILY|TYPE|DIRECTION|COUNTRY  

    (IF (IsPresent BLK1_CTRY)
       THEN
         (
            (Assign COUNTRY BLK1_CTRY)
         )
       ELSE
         (
           (IF (IsPresent BLK2_CTRY)
              THEN
                (
                   (Assign COUNTRY BLK2_CTRY)   
                )
              ELSE
                (
                  (IF (IsPresent CNTRY)
                    THEN
                      (
                         (Assign COUNTRY CNTRY)
                      )
                  )
                )
            )
         )
    )

    (IF (OR (IsPresent BLK1_BIC)
            (IsPresent BLK2_BIC)
        )
       THEN
         (
            (IF (IsPresent BLK1_BIC)
               THEN
                 (
                   (Assign BLOCK1_DATA BLK1_BIC)
                 )
               ELSE
                 (
                   (Assign BLOCK2_DATA BLK2_BIC)        
                 )
            )
            
         )
    )

    (Assign LOCATION_KEY (Append INSTITUTIONID ".OPERATIONAL_CONF.PROCESSING.LOCATION.LOCATION_KEY"))                                                                                                                            
    (Assign LOCATION_KEY (MemTblGetTableValue "INST_PARAM" LOCATION_KEY))
    (IF(ISPRESENT LOCATION_KEY)
     THEN
      (
        (ASSIGN LOCATION_KEY (APPEND LOCATION_KEY "|"))
      )
    )    
    (IF (IsPresent LOCATION_KEY)
       THEN
         (
            (WHILE(ISLESSTHAN I COUNT)
                         (IF (OR (ISPRESENT LOCATION_KEY)
                                     (ISPATTERNPRESENT LOCATION_KEY "|")
                                 )                
                         THEN
                (
                 (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" 1))
                 ;; IF "|" is at start position then it will remove.
                 (IF(ISEQUAL PATT_POS 1)
                  THEN
                   (
                     (ASSIGN LOCATION_KEY (ReplacePattern LOCATION_KEY  "|" ""))
                     (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" 1))
                   )
                 )
                 (ASSIGN LENT (LENGTH LOCATION_KEY))
                 (ASSIGN VALUE (SUBSTR LOCATION_KEY PATT_POS LENT ))
                 (ASSIGN VALUE1 (RemovePattern LOCATION_KEY VALUE))

                 (IF(ISPRESENT VALUE1)
                 THEN
                  (
                   (ASSIGN PATT_POS (SearchNthPattern VALUE1 "|" -1))
                   (ASSIGN LENT1 (LENGTH VALUE1))
                   (ASSIGN VALUE (SUBSTR VALUE1 (+ PATT_POS 1) LENT1 ))
                  )
                 ELSE
                  (
                    ;; this condition will be used when "|" is at start position.
                   (ASSIGN PATT_POS (SearchNthPattern LOCATION_KEY "|" -1))
                   (ASSIGN LENT1 (LENGTH LOCATION_KEY))
                   (ASSIGN VALUE (SUBSTR LOCATION_KEY (+ PATT_POS 1) LENT1 ))
                  )
                 )
                )
              ELSE
                (
                  (ASSIGN VALUE LOCATION_KEY)
                )
                        )
      (IF(ISPRESENT VALUE)
       THEN
        (
         (IF (IsEqualString VALUE "CHANNEL")
          THEN
           (
              (IF (IsPresent CHANNEL)
               THEN
                 (
                        (Assign KEY_VALUE (Append KEY_VALUE (Append CHANNEL "|")))
                 )
                 ELSE
                  (
                    (Assign KEY_VALUE (Append KEY_VALUE "|"))
                  )
              )

             (IF(ISPATTERNPRESENT LOCATION_KEY "|")
              THEN
               (
                (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                (IF(ISPRESENT LOCATION_KEY)
                 THEN 
                      (ASSIGN COUNT(+ COUNT 1))
                )
               )
             )
           )
         )

         (IF(IsEqualString VALUE "CURRENCY") 
              THEN
               (
                   (IF (IsPresent CURRENCY)
                                THEN
                     (
                       (Assign KEY_VALUE (Append KEY_VALUE (APPEND CURRENCY "|")))
                     )
                      ELSE
                 (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )
                   )
                   
                 (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                  THEN
                   (
                    (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                    (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                    (IF(ISPRESENT LOCATION_KEY)
                     THEN 
                          (ASSIGN COUNT(+ COUNT 1))
                    )
                   )
                 )
               )
            )

            (IF(IsEqualString VALUE "COUNTRY") 
                THEN
                 (
                    (IF (IsPresent COUNTRY)     
                                  THEN
                         (
                             (Assign KEY_VALUE (Append KEY_VALUE (APPEND COUNTRY "|")))
                         )
                        ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                    )

                  (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                   THEN
                    (
                     (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                     (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                     (IF(ISPRESENT LOCATION_KEY)
                     THEN 
                          (ASSIGN COUNT(+ COUNT 1))
                    )
                   )
                  )
                )
             )

             (IF(IsEqualString VALUE "BIC") 
                  THEN
                  (
                                 (IF (IsPresent BLOCK1_DATA)
                                        THEN
                                  (
                                  (ASSIGN BLOCK1_DATA (SubStr BLOCK1_DATA 1 8))
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND BLOCK1_DATA "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                     )

                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )

              (IF(IsEqualString VALUE "RECEIVER") 
                  THEN
                  (
                                 (IF (IsPresent BLOCK2_DATA)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND BLOCK2_DATA "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )  
                      )
    
                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )
              
              (IF(IsEqualString VALUE "DIRECTION") 
                  THEN
                  (
                                 (IF (IsPresent DIRECTION)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND DIRECTION "|")))
                              )
                               ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 ) 
                     )

                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                   )
              )
              
              (IF(IsEqualString VALUE "INSTITUTIONID") 
                  THEN
                  (
                                 (IF (IsPresent INSTITUTIONID)
                                        THEN
                                  (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND INSTITUTIONID "|")))
                              )
                             ELSE
                  (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                 )  
                     )
                   
                     (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                      THEN
                       (
                        (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))            
                        (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                        (IF(ISPRESENT LOCATION_KEY)
                         THEN 
                              (ASSIGN COUNT(+ COUNT 1))
                        )
                       )
                     )
                  )
              ) 
              
              (IF(IsEqualString VALUE "FAMILY") 
                 THEN
                 (
                                (IF (IsPresent FAMILY)
                                       THEN
                                 (
                                (Assign KEY_VALUE (Append KEY_VALUE (APPEND FAMILY "|")))
                             )
                              ELSE
                  (
                    (Assign KEY_VALUE (Append KEY_VALUE "|"))
                  )
                     )              
                  
 (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                   
                     THEN
                      (
                       (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))
                       (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                       (IF(ISPRESENT LOCATION_KEY)
                        THEN                         
                            (ASSIGN COUNT(+ COUNT 1))
                       )
                      )
                     )
                    )
                  )
                  (IF(IsEqualString VALUE "TYPE") 
                
                   THEN
                   (
                               (IF (IsPresent TYPE)
                                      THEN
                                 (
                               (Assign KEY_VALUE (Append KEY_VALUE (APPEND TYPE "|")))
                                 )
                                  ELSE
                   (
                      (Assign KEY_VALUE (Append KEY_VALUE "|"))
                   )
                      )
                  
                      (IF(ISPATTERNPRESENT LOCATION_KEY "|")
                    
                       THEN
                       (
                         (ASSIGN LOCATION_KEY(STRSTR LOCATION_KEY "|"))
                         (ASSIGN LOCATION_KEY(RemovePattern LOCATION_KEY "|"))
                         (IF(ISPRESENT LOCATION_KEY)
                           THEN
                                (ASSIGN COUNT(+ COUNT 1))
                         )
                         )
                        )
                      )
                   )
                   
                )
           )
   (ASSIGN I(+ I 1))
  )
 )
)

    (Assign FINAL_KEY_VALUE KEY_VALUE)
    (Assign POS (SearchNthPattern FINAL_KEY_VALUE "|" -1))
    (Assign POS1 (- POS 1))
    (Assign FINAL_KEY_VALUE (StrSub FINAL_KEY_VALUE 1 POS1))

    (IF (IsPresent FINAL_KEY_VALUE)
   THEN
    (

        (Assign FIRST_KEY (MemTblGetFirstKeyForTable "LOCATION_DERIVE"))
        (WHILE (Ispresent FIRST_KEY)

            (ASSIGN TD_VALUE (MemTblGetTableValue "LOCATION_DERIVE" FIRST_KEY))

            ;Ld updated after change in TDVALUE to take location code e.g. 103|I|AUD=SYD
            (Assign EQLPOS (SearchNthPattern TD_VALUE "=" 1))
            (Assign EQLPOS1 (- EQLPOS 1))
            (Assign EQLPOS2 (+ EQLPOS 1))
            (IF (IsGreaterThan EQLPOS1 0)
             THEN
                 (
                    (Assign FIRST_KEY (StrSub TD_VALUE EQLPOS2 (LENGTH TD_VALUE)))
                    (Assign TD_VALUE (StrSub TD_VALUE 1 EQLPOS1))
                 )
            )
        
                    (ASSIGN TD_VALUE (APPEND TD_VALUE "|")) 
                    (ASSIGN TD_VALUE (REMOVEPATTERN TD_VALUE "||"))
                 (IF (ISEQUAL (SearchNthPattern TD_VALUE "|" -1) (STRLEN TD_VALUE))
                     THEN
                      (
                      (ASSIGN TD_VALUE (APPEND TD_VALUE "|"))
                      (ASSIGN TD_VALUE (REMOVEPATTERN TD_VALUE "||"))
                      )
                 )      

            (IF (ISPATTERNPRESENT FINAL_KEY_VALUE TD_VALUE)
             THEN
                 ( 
                    (IF (ISPATTERNPRESENT FIRST_KEY "_")
                    THEN
                        (
                           (ASSIGN FIRST_KEY (APPEND "_" FIRST_KEY))
                           (ASSIGN FIRST_KEY (DATA_BETWEEN_TOKENS "_" "_" FIRST_KEY ))
                       )
                    )
                    (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGSEGR" FIRST_KEY)
                    (RETURN FIRST_KEY)
                  )
             )
                
                (ASSIGN FIRST_KEY "")

                (Assign FIRST_KEY (MemTblGetNextKeyForTable))   

        )
    )
 )

    
    (IF (NOT (IsPresent FIRST_KEY)
        )
      THEN
       (
          (Assign DEFLT_LOCN (Append INSTITUTIONID ".OPERATIONAL_CONF.PROCESSING.LOCATION.DEFAULT_LOCATION"))                                                                                                                            
          (Assign DEFLT_LOCN (MemTblGetTableValue "INST_PARAM" DEFLT_LOCN))
          (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGSEGR" DEFLT_LOCN)
       )
    )


)



(FUNCTION DRVE_TRANS_MT101_MT103 MSG)

(
	(VAR TEMPSTR)
	(VAR STRLENGTH)
	(VAR TRANSREFNO)
	(VAR UPPER_TRANSREF)
	(VAR CRLF)
	(VAR MESSAGETYPE)
	(Assign CRLF (Append (ConvertDecToHex 13) (ConvertDecToHex 10)))
	(ASSIGN TEMPSTR (STRSTR MSG ":20:"))
    (IF (NOT (IsEmpty TEMPSTR))
    THEN
		(
			(ASSIGN STRLENGTH (SearchNthPattern TEMPSTR CRLF 1))
			(ASSIGN TRANSREFNO (SUBSTR TEMPSTR 5 (- STRLENGTH 5)))
		)
	)
	
	(ASSIGN MESSAGETYPE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "MSGTYPE"))
	(IF (NOT (IsPresent MESSAGETYPE)
        )
      THEN
       (
			(Assign MESSAGETYPE (MemTblGetTableValue "STREAM_DETAILS" "MSGTYPE"))
		)
	)
	(Assign UPPER_TRANSREF (Upper TRANSREFNO))
	(IF (AND (ISPATTERNPRESENT MESSAGETYPE "101")
			 (IsPresent TRANSREFNO)
			 (ISPATTERNPRESENT UPPER_TRANSREF "CONVERSION")
		)
      THEN
       (
          (RETURN "MT103")
       )
    )
	(RETURN "MT101")

)
(FUNCTION TRANS_PAIN001_PACS008 MSG)

(
	(VAR TEMPSTR)
	(VAR STRLENGTH)
	(VAR TRANSREFNO)
	(VAR UPPER_TRANSREF)
	(VAR CRLF)
	(VAR MESSAGETYPE)
	(Assign TRANSREFNO (DATA_BETWEEN_TOKENS "<MsgId>" "</MsgId>" MSG))
	(Assign UPPER_TRANSREF (Upper TRANSREFNO))
	(IF (AND (ISPATTERNPRESENT MSG "<CstmrCdtTrfInitn>")
			 (IsPresent TRANSREFNO)
			 (ISPATTERNPRESENT UPPER_TRANSREF "CONVERSION")
		)
      THEN
       (
          (RETURN "T")
       )
    )
	(RETURN "F")

)

(FUNCTION FILEACT_HEADERS )

(

(VAR INSTITUTIONID)
(VAR FILEACTPROFILE)
(VAR GENPATH)
(VAR GENPATH1)
(VAR INSTKEY)
(VAR KEY)
(VAR PRMTABLE)
(VAR NIBCTBLNAME)
(VAR SQLQUERY)
(VAR PRMVALUE)
(VAR AML_RESET_MEMTBL_HDL)
(VAR CUSTOM37)
(VAR FILEACT_SERVICE_PRODUCT)
(VAR VALUE)
	
	
	(ASSIGN INSTITUTIONID (GETVALUEFROMHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "INSTITUTION_ID"))
	(ASSIGN PRMTABLE (APPEND INSTITUTIONID "_PRM"))
	(ASSIGN PRMVALUE (MemTblGetTableValue "CONF_FILEACT" PRMTABLE));;Option2-REFRESH-MEMTABLE-FROM-DB-FA
	(IF(ISEMPTY PRMVALUE)
	THEN
		(
			;(ASSIGN INSTITUTIONID "NIBCNLNV")
			(ASSIGN INSTITUTIONID (MemTblGetTableValue "PARENT_CHILD_RELATION" INSTITUTIONID))
			(ASSIGN PRMTABLE (APPEND INSTITUTIONID "_PRM"))
			(ASSIGN PRMVALUE (MemTblGetTableValue "CONF_FILEACT" PRMTABLE));;Option2-REFRESH-MEMTABLE-FROM-DB-FA
		)
	)
	;(ASSIGN CUSTOM37 (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "CUSTOM37" ))
	(IF (ISEMPTY CUSTOM37)
	THEN
		(
			;(ASSIGN CUSTOM37 (GETVALUEFROMHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "CUSTOM37" ))
		)
	)
	
	(ASSIGN FILEACTPROFILE (MemTblGetTableValue PRMVALUE CUSTOM37));;Option2-REFRESH-MEMTABLE-FROM-DB-FAPROFILE
	(IF (ISEMPTY FILEACTPROFILE)
	THEN
		(		
			(ASSIGN FILEACTPROFILE (MemTblGetTableValue PRMVALUE "DEFAULT_FILEACT"));;Option2-REFRESH-MEMTABLE-FROM-DB-FAPROFILE
		)
	)
	
	(ASSIGN INSTKEY (APPEND INSTITUTIONID (APPEND ".SWIFT_FileAct_PROFILE_NAME." FILEACTPROFILE)))
	(ASSIGN INSTKEY (UPPER INSTKEY))
	
	(ASSIGN GENPATH1 (MemTblGetTableValue "FILEACT_PROFILE_SEPA" INSTKEY));;Option2-REFRESH-MEMTBL-FROM-INSTPATH
		
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.SEPACT.REQUEST_TYPE"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_REQUEST_TYPE" FILEACT_SERVICE_PRODUCT)
	
	
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.AUTH_USER_DN"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_USER_DN" FILEACT_SERVICE_PRODUCT)
	
	
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.REQUESTOR_DN"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_REQUESTER_DN" FILEACT_SERVICE_PRODUCT)
	
		
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.RESPONDER_DN"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_RESPONDER_DN" FILEACT_SERVICE_PRODUCT)
		
	
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.SERVICE_NAME"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_SERVICE_NAME" FILEACT_SERVICE_PRODUCT)
	
	
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.FILE_MODE"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_FILE_MODE" FILEACT_SERVICE_PRODUCT)
	

	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.POSITIVE_DELIVERY_NOTIFICATION"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(IF (ISEQUALSTRING FILEACT_SERVICE_PRODUCT "true")
	THEN
		(		
			(ASSIGN VALUE "Y")
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_ACK_REQD" VALUE)
		)
	ELSE
       (
            (Assign VALUE "N")
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_ACK_REQD" VALUE)
			
       )
	)

	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.ACK_RESPONDER_DN"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_ACK_RESPONDER_DN" FILEACT_SERVICE_PRODUCT)
	

	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.NR_FLAG"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	(IF (ISEQUALSTRING FILEACT_SERVICE_PRODUCT "true")
	THEN
		(		
			(ASSIGN VALUE "Y")
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_NR_FLAG" VALUE)
		)
	ELSE
       (
            (Assign VALUE "N")
			(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_NR_FLAG" VALUE)
			
       )
	)
		
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.DELIVERY_NOTIF_Q"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_DEL_NOTFQ" FILEACT_SERVICE_PRODUCT)
	
		
	(ASSIGN GENPATH (APPEND GENPATH1 ".ADVANCE_FILE_ACT.GENERAL.ACK_REQUEST_TYPE"))
	
	(ASSIGN KEY (APPEND INSTITUTIONID (APPEND "." GENPATH)))
	
	(ASSIGN FILEACT_SERVICE_PRODUCT (MemTblGetTableValue "INST_PARAM" KEY))
	
	(SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "MDBSN_ACK_REQTYPE" FILEACT_SERVICE_PRODUCT)
	
)	