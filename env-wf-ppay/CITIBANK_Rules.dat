(FUNCTION ACH_CITI_ENRICH_CT )

(
 (VAR INSTITUTIONID)
 (VAR PARENT_INST_ID_PATH)
 (VAR PARENT_INST_ID)
 (VAR PAYMT_ON_BEHALF_PATH)
 (VAR PAYMT_ON_BEHALF)

        
        (CITIENH_FILEHDR_IMDT_DEST_NM)
        (CITIENH_FILEHDR_IMDT_ORIGIN_NM)
        (CITIENH_FILEHDR_REF_CODE)
        (CITIENH_BTHHDR_SRVC_CLASS_CODE)
        (CITIENH_BTHHDR_COMP_DISC_DATA)
        (CITIENH_BTHHDR_ORGNTR_STS_CODE)
        ;(CITIENH_CCD_ENTRY_ID_NUM) ; This function is not required as per specification
        (CITIENH_BTHCTR_SRVC_CLASS_CODE)
        (CITIENH_BTHCTR_MSG_AUTH_CD)
        (CITIENH_FILEHDR_IMDT_DEST)

    (ASSIGN INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INSTITUTION_ID"))
        ;(Assign PARENT_INST_ID_PATH (Append INSTITUTIONID ".INSTITUTION_DETAILS.PARENT_ID"))
        ;(Assign PARENT_INST_ID (MemTblGetTableValue "INST_PARAM" PARENT_INST_ID_PATH))
        (Assign PARENT_INST_ID (MEMTBLGETTABLEVALUE "TOP_PARENT" INSTITUTIONID))
        (Assign PAYMT_ON_BEHALF_PATH (Append PARENT_INST_ID ".INSTITUTION_DETAILS.PAYMENTS_ON_BEHALF.ENABLED"))
        ;(Assign PAYMT_ON_BEHALF_PATH (Append PARENT_INST_ID ".INSTITUTION_DETAILS.PAYMENTS_ON_BEHALF.PAYMENTS_ON_BEHALF.ENABLED"))
        (Assign PAYMT_ON_BEHALF (MemTblGetTableValue "INST_PARAM" PAYMT_ON_BEHALF_PATH))

    (IF (OR (IsEqualString PAYMT_ON_BEHALF "Y")
                    (IsEqualString PAYMT_ON_BEHALF "YES")
                )
           THEN
             (
                        (CITIENH_FILEHDR_IMDT_ORIGIN)
                        (CITIENH_BTHHDR_COMP_ID)
                        (CITIENH_BTHHDR_ORGNT_DFI_ID)
                        (CITIENH_BTHCTR_COMP_ID)
                        (CITIENH_BTHCTR_ORGNT_DFI_ID)
                 )
        )


)

(FUNCTION CITIENH_BTHCTR_COMP_ID )

(
(VAR COMPID_BTHHDR)
(VAR COMPID_BTHHDR_PATH)
(VAR COMPID_BTHCTR)
(VAR COMPID_BTHCTR_PATH)

(ASSIGN COMPID_BTHHDR_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.COMPANY-ID"))
(ASSIGN COMPID_BTHHDR (GETINDIRECT COMPID_BTHHDR_PATH))
(ASSIGN COMPID_BTHCTR_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-CTRL-REC.COMPANY-ID"))
(ASSIGN COMPID_BTHCTR COMPID_BTHHDR)
(SETINDIRECT COMPID_BTHCTR_PATH COMPID_BTHCTR)


)

(FUNCTION CITIENH_BTHCTR_MSG_AUTH_CD  )

(
(VAR MSG_AUTH_CD)
(VAR MSG_AUTH_CD_OUT_PATH)

(ASSIGN MSG_AUTH_CD "                   ")
(ASSIGN MSG_AUTH_CD_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-CTRL-REC.MESSAGE-AUTH-CODE"))
(SETINDIRECT MSG_AUTH_CD_OUT_PATH MSG_AUTH_CD)

)

(FUNCTION CITIENH_BTHCTR_ORGNT_DFI_ID )

(
(VAR ORGNT_DFIID_BTCHHDR)
(VAR ORGNT_DFIID_BTCHHDR_PATH)
(VAR ORGNT_DFIID_BTCHCTR_PATH)

(ASSIGN ORGNT_DFIID_BTCHHDR_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.ORIGINATING-DFI-ID"))
(ASSIGN ORGNT_DFIID_BTCHHDR (GETINDIRECT ORGNT_DFIID_BTCHHDR_PATH))
(ASSIGN ORGNT_DFIID_BTCHCTR_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-CTRL-REC.ORIGINATING-DFI-ID"))
(SETINDIRECT ORGNT_DFIID_BTCHCTR_PATH ORGNT_DFIID_BTCHHDR)


)

(FUNCTION CITIENH_BTHCTR_SRVC_CLASS_CODE )

(
(VAR SRVC_CLCD_IN)
(VAR SRVC_CLCD_OUT_PATH)

(ASSIGN SRVC_CLCD_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-CTRL-REC.SERVICE-CLASS-CODE"))

;For SERVICE CLASS CODE
(ASSIGN SRVC_CLCD_IN "200")
(SETINDIRECT SRVC_CLCD_OUT_PATH SRVC_CLCD_IN)

)

(FUNCTION CITIENH_BTHHDR_COMP_DISC_DATA )

(
(VAR COMP_DISC_DTA_IN)
(VAR COMP_DISC_DTA_IN_PATH)
(VAR COMP_DISC_DTA_OUT)
(VAR COMP_DISC_DTA_OUT_PATH)
(VAR LEN_COMP_DISC_DTA_IN)

(ASSIGN COMP_DISC_DTA_IN_PATH (STRING "IN.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.COMPANY-DISCRETIONARY-DATA"))
(ASSIGN COMP_DISC_DTA_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.COMPANY-DISCRETIONARY-DATA"))
(ASSIGN COMP_DISC_DTA_IN (GETINDIRECT COMP_DISC_DTA_IN_PATH))
(ASSIGN LEN_COMP_DISC_DTA_IN (LENGTH COMP_DISC_DTA_IN))

;For COMPANY DISCRETIONARY DATA
(IF (ISPRESENT COMP_DISC_DTA_IN)
   THEN
     (
      (IF (ISGREATERTHAN LEN_COMP_DISC_DTA_IN "20")
         THEN
           (ASSIGN COMP_DISC_DTA_IN (SUBSTR LEN_COMP_DISC_DTA_IN 1 20))
      )
      (WHILE (ISLESSTHAN LEN_COMP_DISC_DTA_IN "20")
         (ASSIGN COMP_DISC_DTA_IN (APPEND LEN_COMP_DISC_DTA_IN " "))
         (ASSIGN LEN_COMP_DISC_DTA_IN (LENGTH COMP_DISC_DTA_IN))
      )
     )
   ELSE
     (ASSIGN COMP_DISC_DTA_IN "                    ")
)
(ASSIGN COMP_DISC_DTA_OUT COMP_DISC_DTA_IN)   
(SETINDIRECT COMP_DISC_DTA_OUT_PATH COMP_DISC_DTA_OUT)

)

(FUNCTION CITIENH_BTHHDR_COMP_ID )

(
(VAR COMPID_IN)
(VAR COMPID_IN_PATH)
(VAR COMPID_OUT)
(VAR COMPID_OUT_PATH)
(VAR START_CHAR_COMPID)
(VAR LEN_COMPID_IN)
(VAR INSTITUTIONID)
(VAR COMPANY_ID)


(ASSIGN COMPID_IN_PATH (STRING "IN.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.COMPANY-ID"))
(ASSIGN COMPID_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.COMPANY-ID"))

(ASSIGN COMPID_IN (GETINDIRECT COMPID_IN_PATH))
(ASSIGN START_CHAR_COMPID (SUBSTR COMPID_IN 1 1))
(ASSIGN LEN_COMPID_IN (LENGTH COMPID_IN))

(ASSIGN INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INSTITUTION_ID"))
(ASSIGN COMPANY_ID (APPEND (APPEND INSTITUTIONID ".BANKS.CITIBANK_US") ".COMPANY_ID"))
(ASSIGN COMPANY_ID (MemTblGetTableValue "INST_PARAM" COMPANY_ID))
(Assign COMPANY_ID (Trimspace COMPANY_ID))

;For COMPANY IDENTIFICATION
(IF (ISPRESENT COMPID_IN)
   THEN
     (
      (IF (ISNOTEQUALSTRING START_CHAR_COMPID "1")
         THEN
           (ASSIGN COMPID_IN (APPEND "1" (SUBSTR COMPID_IN 2 (- (LENGTH COMPID_IN) 1))))
      )
      (IF (ISGREATERTHAN LEN_COMPID_IN "10")
         THEN
           (ASSIGN COMPID_IN (SUBSTR COMPID_IN 1 10))
      )
      (WHILE (ISLESSTHAN LEN_COMPID_IN "10")
          (ASSIGN COMPID_IN (APPEND COMPID_IN " "))
          (ASSIGN LEN_COMPID_IN (LENGTH COMPID_IN))
      )
     )
)

(IF (IsPresent COMPANY_ID)
   THEN
         (ASSIGN COMPID_IN COMPANY_ID)
)

(ASSIGN COMPID_OUT COMPID_IN)
(SETINDIRECT COMPID_OUT_PATH COMPID_OUT)



)

(FUNCTION CITIENH_BTHHDR_ORGNTR_STS_CODE )

(
(VAR ORGTR_STSCD)
(VAR ORGTR_STSCD_OUT_PATH)

(ASSIGN ORGTR_STSCD_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.ORIGINATOR-STATUS-CODE"))
;For ORIGINATOR STATUS CODE
(ASSIGN ORGTR_STSCD "1")
(SETINDIRECT ORGTR_STSCD_OUT_PATH ORGTR_STSCD)

)

(FUNCTION CITIENH_BTHHDR_ORGNT_DFI_ID )

(
(VAR ORGNT_DFIID_IN)
(VAR ORGNT_DFIID_IN_PATH)
(VAR ORGNT_DFIID_OUT)
(VAR ORGNT_DFIID_OUT_PATH)
(VAR LEN_ORGNT_DFIID_IN)

(ASSIGN ORGNT_DFIID_IN_PATH (STRING "IN.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.ORIGINATING-DFI-ID"))
(ASSIGN ORGNT_DFIID_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.ORIGINATING-DFI-ID"))

(ASSIGN ORGNT_DFIID_IN (GETINDIRECT ORGNT_DFIID_IN_PATH))
(ASSIGN LEN_ORGNT_DFIID_IN (LENGTH ORGNT_DFIID_IN))

;Below commented Logic will be updated once response from OMnicom is received : Nalini on 1Aug2014
;(IF (ISEMPTY ORGNT_DFIID_IN)
;   THEN
;     (SET_ENHCR_VIOLATION "00" 1550)
;)
;;Logic to derive ORIGINATING DFI IDENTIFICATION will be implemented once answer from OMNICOM is received for the related query
(ASSIGN ORGNT_DFIID_IN "03110020")
(SETINDIRECT ORGNT_DFIID_OUT_PATH ORGNT_DFIID_IN)


)

(FUNCTION CITIENH_BTHHDR_SRVC_CLASS_CODE )

(
(VAR SRVC_CLCD_IN)
(VAR SRVC_CLCD_OUT_PATH)

(ASSIGN SRVC_CLCD_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].FLD-COMP-BTCH-HDR-REC.SERVICE-CLASS-CODE"))

;For SERVICE CLASS CODE
(ASSIGN SRVC_CLCD_IN "200")
(SETINDIRECT SRVC_CLCD_OUT_PATH SRVC_CLCD_IN)

)

(FUNCTION CITIENH_CCD_ENTRY_ID_NUM )

(
(VAR ID_NUM_IN)
(VAR ID_NUM_IN_PATH)
(VAR ID_NUM_OUT)
(VAR ID_NUM_OUT_PATH)
(VAR LEN_ID_NUM_IN)

(ASSIGN ID_NUM_IN_PATH (STRING "IN.ACH.SEQ-BATCH[0].SEQ-CCD-ENTRY-DETAIL-REC[0].FLD-CCD-ENTRY-DETAIL-REC.IDENTIFICATION-NUMBER"))
(ASSIGN ID_NUM_OUT_PATH (STRING "OUT.ACH.SEQ-BATCH[0].SEQ-CCD-ENTRY-DETAIL-REC[0].FLD-CCD-ENTRY-DETAIL-REC.IDENTIFICATION-NUMBER"))

(ASSIGN ID_NUM_IN (GETINDIRECT ID_NUM_IN_PATH))
(ASSIGN LEN_ID_NUM_IN (LENGTH ID_NUM_IN))

(IF (ISGREATERTHAN LEN_ID_NUM_IN "15")
   THEN
      (ASSIGN ID_NUM_IN (SUBSTR 1 15))
)
(WHILE (ISLESSTHAN LEN_ID_NUM_IN "15")
    (ASSIGN ID_NUM_IN (APPEND ID_NUM_IN " "))
    (ASSIGN LEN_ID_NUM_IN (LENGTH ID_NUM_IN))
)
;;Logic to derive IDENTIFICATION NUMBER will be implemented once answer from OMNICOM is received for the related query
(SETINDIRECT ID_NUM_OUT_PATH ID_NUM_IN)

)

(FUNCTION CITIENH_FILEHDR_IMDT_DEST )

(
 (VAR IMDT_DEST_IN)
(VAR IMDT_DEST_IN_PATH)
(VAR IMDT_DEST_OUT)
(VAR IMDT_DEST_OUT_PATH)

(ASSIGN IMDT_DEST_IN_PATH (STRING "IN.ACH.FLD-FILE-HDR-REC.IMMEDIATE-DESTINATION"))
(ASSIGN IMDT_DEST_OUT_PATH (STRING "OUT.ACH.FLD-FILE-HDR-REC.IMMEDIATE-DESTINATION"))

(ASSIGN IMDT_DEST_IN (GETINDIRECT IMDT_DEST_IN_PATH))
(ASSIGN IMDT_DEST_OUT (GETINDIRECT IMDT_DEST_OUT_PATH))

(ASSIGN IMDT_DEST_OUT " 031100209")
(SETINDIRECT IMDT_DEST_OUT_PATH IMDT_DEST_OUT)


)

(FUNCTION CITIENH_FILEHDR_IMDT_DEST_NM )

(
(VAR IMDT_DEST_NM_IN)
(VAR IMDT_DEST_NM_IN_PATH)
(VAR IMDT_DEST_NM_OUT_PATH)

(ASSIGN IMDT_DEST_NM_IN_PATH (STRING "IN.ACH.FLD-FILE-HDR-REC.IMMEDIATE-DESTINATION-NAME"))
(ASSIGN IMDT_DEST_NM_OUT_PATH (STRING "OUT.ACH.FLD-FILE-HDR-REC.IMMEDIATE-DESTINATION-NAME"))
(ASSIGN IMDT_DEST_NM_IN (GETINDIRECT IMDT_DEST_NM_IN_PATH))

;For IMMEDIATE DESTINATION NAME
(IF (OR (ISPRESENT IMDT_DEST_NM_IN)
        (NOT (ISPRESENT IMDT_DEST_NM_IN))
    )    
   THEN
     (
      (ASSIGN IMDT_DEST_NM_IN "CITIBANK, N.A.         ")
      (SETINDIRECT IMDT_DEST_NM_OUT_PATH IMDT_DEST_NM_IN)
     )
)

)

(FUNCTION CITIENH_FILEHDR_IMDT_ORIGIN )

(
(VAR IMDT_ORG_IN)
(VAR IMDT_ORG_IN_PATH)
(VAR IMDT_ORG_OUT)
(VAR IMDT_ORG_OUT_PATH)
(VAR START_CHAR)
(VAR LEN_IMDT_ORG_IN)
(VAR INSTITUTIONID)
(VAR BANK)
(VAR COMPANY_ID)
(VAR NAME)



(ASSIGN IMDT_ORG_IN_PATH (STRING "IN.ACH.FLD-FILE-HDR-REC.IMMEDIATE-ORIGIN"))
(ASSIGN IMDT_ORG_OUT_PATH (STRING "OUT.ACH.FLD-FILE-HDR-REC.IMMEDIATE-ORIGIN"))

(ASSIGN IMDT_ORG_IN (GETINDIRECT IMDT_ORG_IN_PATH))
(ASSIGN START_CHAR (SUBSTR IMDT_ORG_IN 1 1))
(ASSIGN LEN_IMDT_ORG_IN (LENGTH IMDT_ORG_IN))

(ASSIGN INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "INSTITUTION_ID"))
(ASSIGN BANK (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "BANKING_CHANL_UPDT"))
;(ASSIGN COMPANY_ID (APPEND (APPEND (APPEND INSTITUTIONID ".BANKS.") BANK) ".COMPANY_ID"))

(ASSIGN COMPANY_ID (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "ACH_COMPANY_ID"))
(IF (NOT(IsPresent COMPANY_ID))
   THEN
     (
                (ASSIGN COMPANY_ID (APPEND (APPEND INSTITUTIONID ".BANKS.CITIBANK_US") ".COMPANY_ID"))
                (ASSIGN COMPANY_ID (MemTblGetTableValue "INST_PARAM" COMPANY_ID))
                (Assign COMPANY_ID (Trimspace COMPANY_ID))
         )
)
(SETVALUETOHEADER  GV_MSG_OUTPATH "STREAM_DETAILS" "COMPANY_ID" COMPANY_ID)

(ASSIGN NAME (APPEND INSTITUTIONID ".INSTITUTIONDETAILS.NAME.NAME"))
(ASSIGN NAME (MemTblGetTableValue "INST_PARAM" NAME))
(SETVALUETOHEADER  GV_MSG_OUTPATH "STREAM_DETAILS" "IMMED_ORGIN_NAME" NAME)


;For IMMEDIATE ORIGIN
(IF (ISPRESENT IMDT_ORG_IN)
   THEN 
     (
      (IF (ISNOTEQUALSTRING START_CHAR "1")
         THEN
            (ASSIGN IMDT_ORG_IN (APPEND "1" (SUBSTR IMDT_ORG_IN 2 (- (LENGTH IMDT_ORG_IN) 1))))
      )
      (IF (ISGREATERTHAN LEN_IMDT_ORG_IN "10")
         THEN
           (ASSIGN IMDT_ORG_IN (SUBSTR IMDT_ORG_IN 1 10))
      )
      
      (WHILE (ISLESSTHAN LEN_IMDT_ORG_IN "10")
         (ASSIGN IMDT_ORG_IN (APPEND IMDT_ORG_IN " "))
         (ASSIGN LEN_IMDT_ORG_IN (LENGTH IMDT_ORG_IN))
      )
     )
   ELSE
     (ASSIGN IMDT_ORG_IN "          ")
)

(IF (IsPresent COMPANY_ID)
   THEN
         (ASSIGN IMDT_ORG_IN COMPANY_ID)
)

(ASSIGN IMDT_ORG_OUT IMDT_ORG_IN)
(SETINDIRECT IMDT_ORG_OUT_PATH IMDT_ORG_OUT)



)

