                        (QUERY "UPDATE_MT010_MSGDB" 3 "UPDATE MSGDB SET QUEUEID = DECODE(@MSGDB_ID , NULL , 'CRPUNMTH' , 'PROCDQ' ) ,STATUS = '79', INSTITUTIONID = DECODE(@MSGDB_ID , NULL , @INSTITUTION_ID, @INSTITUTIONID), MSGSEGR = DECODE(@MSGDB_ID , NULL , @MSGSEGR , @MSG_SEGR), MESSAGECLASSTYPE = DECODE(@MSG_TYPE,'NULL',NULL,@MSG_TYPE), COUNTRYCODE = DECODE(@SENDER_BIC_COUNTRY_CODE,'NULL',NULL, @SENDER_BIC_COUNTRY_CODE), COMMENTS = DECODE(@COMMENTS,'NULL',NULL,@COMMENTS),SENDER = DECODE(@SENDER_BIC,'NULL',NULL,@SENDER_BIC), RECEIVER = DECODE(@RECEIVER_BIC,'NULL',NULL,@RECEIVER_BIC), INPUTDATE = @DATE_VAR, INPUTTIME = @TIME_VAR, CURRQUEUEINDATE = @DATE_VAR, CURRQUEUEINTIME = @TIME_VAR, PRIORITY = 5, MESSAGEDIRECTION = 'O', CUSTOM5 =DECODE(@MSGDB_ID,NULL,'','PREV=' || @MSGDB_ID || '|ORIG?') WHERE MSGDB_ID = @MSGDBID AND INSTANCEID = @ACE_INSTANCE_ID")
                        (QUERY "INSERT_GENAUDIT_1" 7 "INSERT INTO GENAUDIT (MESSAGENO, AUDITDATETIME, SEQUENCENO, QUEUEID, APPLICATION, MODULENAME, ACTION,AUDITTEXT,INSTITUTIONID) VALUES (DECODE(@MSGDB_ID , NULL , '' , LPAD(@ACE_MESSAGE_NO,12,'0')), SYSDATE, @SEQ_NO, DECODE(@MSGDB_ID , NULL , 'CRPUNMTH' , 'PROCDQ' ), @ACE_APPLICATION_ID, 'WRKFLOW', 'Wrote',@AUDIT2,@INSTITUTIONID)")
                        (QUERY "INSERT" 6 "INSERT INTO GENAUDIT (MESSAGENO, AUDITDATETIME, SEQUENCENO, QUEUEID, APPLICATION, MODULENAME, ACTION,AUDITTEXT,INSTITUTIONID) VALUES (LPAD(@ACE_MESSAGE_NO,12,'0'), SYSDATE, @SEQ_NO, DECODE(@MSGDB_ID , NULL , 'CRPUNMTH' , 'PROCDQ' ), @ACE_APPLICATION_ID, 'WRKFLOW', 'Wrote','MT'|| @MSG_TYPE || ' message <' || @ACE_MESSAGE_NO || '>read from CRPMSGIN queue processed , and wrote to '|| DECODE(@MSGDB_ID , NULL , 'CRPUNMTH' , 'PROCDQ' ) ||' Queue',@INSTITUTIONID)")
                        (QUERY "UPDATE_MSGDB_PAY" 4 "UPDATE MSGDB_PAY SET MDBPAY_BENF_TYPE = 'NONCUSTOMER' WHERE MSGDB_ID = @MSGDBID")
                        (QUERY "INSERT_GENAUDIT_2" 8 "INSERT INTO GENAUDIT (MESSAGENO, AUDITDATETIME, SEQUENCENO, QUEUEID, APPLICATION, MODULENAME, ACTION,AUDITTEXT,INSTITUTIONID) VALUES (DECODE(@MSGDB_ID , NULL , '' , @MUR), SYSDATE, @SEQ_NO,'PROCDQ', @ACE_APPLICATION_ID, 'WRKFLOW', 'Wrote',@AUDIT3,@INSTITUTIONID)")
                        (QUERY "SELECT_MSGDB_ID" 2 "SELECT MSGDB_ID MSGDB_ID, CUSTOM5 CUSTOM5, MSGSEGR MSG_SEGR, INSTITUTIONID INSTITUTIONID  FROM MSGDB WHERE QUEUEID = 'PROCDQ' AND (STATUS = @STATUS_ORG1 OR STATUS =DECODE(@STATUS_ORG2,'NULL','',@STATUS_ORG2)) AND CUSTOM9 = @MUR AND INSTANCEID = @ACE_INSTANCE_ID")
                        (QUERY "UPDATE_CUSTOM5" 5 "UPDATE MSGDB SET CUSTOM5 = (CONCAT ((CONCAT ((CONCAT (@CUSTOM5 , 'NEXT=')), @MSGDBID)), (@LINKED-DETAILS))), STATUS = @ORG-MSG-UPDT WHERE MSGDB_ID =@MSGDB_ID AND INSTANCEID = @ACE_INSTANCE_ID")
                    )
