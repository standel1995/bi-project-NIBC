                        (QUERY "SELECT_DUAL"  1  "SELECT LENGTH(@ERR_COMMENTS) STRLENGTH, SUBSTR(@ERR_COMMENTS, 1,4) ERR_COMMENTS1 , SUBSTR(@ERR_COMMENTS, 5,1) TRANSERRORFLAG, SUBSTR(@ERR_COMMENTS, 6,((@STRLENGTH) -5)) TRANSERRORPATH FROM DUAL")
