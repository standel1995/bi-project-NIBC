                        (QUERY "SELECT_MSGBLOCK_56" 9 "SELECT MESSAGE CHARGE_XML_RESPONSE_MESSAGE FROM MSGBLOCKS WHERE MSGDB_ID = @MSGDBID AND MSGBLOCKTYPE = 56")
