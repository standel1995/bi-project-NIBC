(FUNCTION ENRICH_CATEGORY_PUR_BTCH_ABNA_CT )

(

 (VAR PATH_CATEGORY_PUR)
 (VAR BH_TRANSACTION_GROUP)
 (VAR GETVAL_CATEGORY_PUR)
 (Assign PATH_CATEGORY_PUR (String "OUT.CstmrCdtTrfInitn.PmtInf[0].PmtTpInf.CtgyPurp"))
 (Assign BH_TRANSACTION_GROUP (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "BH_TRANSACTION_GROUP"))

 (IF (ISNOTEQUALSTRING BH_TRANSACTION_GROUP "00")
 THEN
     (
        (ASSIGN GETVAL_CATEGORY_PUR "IN.CstmrCdtTrfInitn.PmtInf[0].PmtTpInf.CtgyPurp.Cd")
         (IF (IsNotEqualstring GETVAL_CATEGORY_PUR "SALA")
              THEN
              (SETINDIRECT PATH_CATEGORY_PUR "")  
         )
     )
 )

)

(FUNCTION ENRICH_CATEGORY_PUR_TXN_ABNA_CT )

(

 (VAR PATH_CATEGORY_PUR)
 (VAR GETVAL_CATEGORY_PUR)
 (VAR BH_TRANSACTION_GROUP)
 (VAR SEQ)
 (VAR PMTTPINF)
 (VAR PATH_CATEGORY_PUR_BTCH)
 (VAR PATH_CATEGORY_TXN)
 (VAR PMTTPINF_TXN_PATH)
 (VAR TXN_COMMENTS)
		 
 (Assign PATH_CATEGORY_PUR (String "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].PmtTpInf.CtgyPurp"))
 (Assign BH_TRANSACTION_GROUP (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "BH_TRANSACTION_GROUP"))
 (IF (ISNOTEQUALSTRING BH_TRANSACTION_GROUP "00")
 THEN
     (

        (ASSIGN GETVAL_CATEGORY_PUR "IN.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].PmtTpInf.CtgyPurp.Cd")
         ;Start : Updated By Nalini Ranjan on 15Mar2016 for Issue id PSG-2316
         (Assign PMTTPINF_TXN_PATH (String "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].PmtTpInf"))
		 (SETINDIRECT PMTTPINF_TXN_PATH "")
		 (ASSIGN TXN_COMMENTS (MEMTBLGETTABLEVALUE "STREAM_DETAILS" "TXN_COMMENTS"))
		 (IF (ISPATTERNPRESENT TXN_COMMENTS ":A00:232-9528")
			THEN
			  (
			    (ASSIGN TXN_COMMENTS (REMOVEPATTERN TXN_COMMENTS ":A00:232-9528"))
				(MEMTBLSETTABLEVALUE "STREAM_DETAILS" "TXN_COMMENTS" TXN_COMMENTS)
				(SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TXN_COMMENTS" TXN_COMMENTS)
			  )
		 )
		 ;(IF (IsNotEqualstring GETVAL_CATEGORY_PUR "SALA")
         ;      THEN
		 ; (
		 ;   (SETINDIRECT PATH_CATEGORY_PUR "")
		 ; )
		 ;ELSE
		 ; (    
         ;  ;2529
		 ;    ; (ASSIGN SEQ (GENERIC_PATH_FORMATION  (STRING "PmtInf") (STRING "CdtTrfTxInf") "" "" "" (STRING "PmtTpInf") "" "" "" "" "PAIN001_CRDINF" ))
     	 ;	 (ASSIGN SEQ "IN.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].PmtTpInf")
         ;    (ASSIGN PMTTPINF (GETINDIRECT SEQ))
		 ;	 (Assign PATH_CATEGORY_PUR_BTCH (String "OUT.CstmrCdtTrfInitn.PmtInf[0].PmtTpInf"))
		 ;	 (SETINDIRECT PATH_CATEGORY_PUR_BTCH PMTTPINF)
		 ;	 (Assign PATH_CATEGORY_TXN (String "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].PmtTpInf"))
		 ;	 (SETINDIRECT PATH_CATEGORY_TXN "")
         ;  ;end
         ;   
		 ; )
         ;)
		;End : Updated By Nalini Ranjan on 15Mar2016 for Issue id PSG-2316
    )
  )

)

(FUNCTION ENRICH_CDTRAGNT_ABNA_CT )

(
    (VAR CDTR_AGNT_ID)
    (VAR CDTR_AGNT_BIC)
    (VAR CDTR_AGNT_PATH)
    (VAR CDTR_AGNT_ID_PATH)
	(VAR CDTR_AGNT_PATH1)
    (ASSIGN CDTR_AGNT_ID (MemTblGetTableValue "ONBOARD_INST" "CDTRAGNT_CT_ABNA_AD"))  
  ;  (SETVALUETOHEADER GV_MSG_INPATH "STREAM_DETAILS" "CDTR_AGNT_ID" CDTR_AGNT_ID)

    (ASSIGN CDTR_AGNT_PATH (STRING "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].CdtrAgt.FinInstnId.BIC"))
    (ASSIGN CDTR_AGNT_ID_PATH (String "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].CdtrAgt.FinInstnId.Othr.Id"))
        (ASSIGN CDTR_AGNT_BIC (GETINDIRECT CDTR_AGNT_PATH))
    (IF (ISEMPTY CDTR_AGNT_BIC)
        THEN
		 (
          				(ASSIGN CDTR_AGNT_PATH1 (String "OUT.CstmrCdtTrfInitn.PmtInf[0].CdtTrfTxInf[0].CdtrAgt"))
						(SETINDIRECT CDTR_AGNT_PATH1 "")
                        (SETINDIRECT CDTR_AGNT_ID_PATH CDTR_AGNT_ID)
		 )
    )


)

(FUNCTION ENRICH_CDTRAGNT_ABNA_DD )

(
   (VAR CDTR_BIC_PATH)
   (VAR CDTR_AGNT_ID)
   (VAR CDTR_BIC)
   (VAR PATH_PMTINF_CDTR_AGNT_ID)
   (VAR PATH_CDTR_AGNT)

   ;     (ASSIGN CDTR_BIC (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "CDTR_BTCH_BIC"))
   (ASSIGN CDTR_BIC_PATH (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].CdtrAgt.FinInstnId.BIC"))   
   (Assign PATH_PMTINF_CDTR_AGNT_ID (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].CdtrAgt.FinInstnId.Othr.Id"))
   (ASSIGN CDTR_AGNT_ID (MemTblGetTableValue "ONBOARD_INST" "CDTRAGNT_DD_ABNA_AD"))
   (ASSIGN CDTR_BIC (GETINDIRECT CDTR_BIC_PATH)) 
   (IF (IsEmpty CDTR_BIC)
       THEN
       (
          (IF (ISPRESENT CDTR_AGNT_ID)
            THEN
			(
              (Assign PATH_CDTR_AGNT (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].CdtrAgt"))
			  (SETINDIRECT PATH_CDTR_AGNT "")
              (SETINDIRECT PATH_PMTINF_CDTR_AGNT_ID CDTR_AGNT_ID)
			)
          )
       )
   ) 

)

(FUNCTION ENRICH_CDTRSCHMID_ABNA_DD )

(
 
    (VAR CDTRSCHMID)
    (VAR PATH_PMTINF_CDTRSCHEME)
        (VAR TXN_NAME_ORDERING_PARTY)
        (VAR PATH_DRCTDBTINF_CDTRSCHEME_ID)

            (Assign PATH_PMTINF_CDTRSCHEME (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].CdtrSchmeId[0].Id[0].PrvtId[0].Othr[0].Id"))
            (ASSIGN CDTRSCHMID (MemTblGetTableValue "ONBOARD_INST" "CDTRSCHMID_ABNA_AD"))
            (SETINDIRECT PATH_PMTINF_CDTRSCHEME CDTRSCHMID)
             (IF (IsEmpty CDTRSCHMID)
                THEN
                      (
                         (Assign TXN_NAME_ORDERING_PARTY (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "BH_OPR_NAME_ORDERING_PARTY"))
                         (Assign PATH_DRCTDBTINF_CDTRSCHEME_ID (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].DrctDbtTx[0].CdtrSchmeId[0].Id[0].PrvtId[0].Othr[0].Id"))
                         (SETINDIRECT PATH_DRCTDBTINF_CDTRSCHEME_ID (STRSKIP TXN_NAME_ORDERING_PARTY))
                      )
             )
              


)

(FUNCTION ENRICH_DBTRAGNT_ABNA_CT )

(
    (VAR DBTR_AGNT_ID)
    (ASSIGN DBTR_AGNT_ID (MemTblGetTableValue "ONBOARD_INST" "DBTRAGNT_CT_ABNA_AD"))  
    ;(SETVALUETOHEADER GV_MSG_INPATH "STREAM_DETAILS" "DBTR_AGNT_ID" DBTR_AGNT_ID)
    (VAR DBTR_AGNT_PATH)
    (VAR DBTR_AGNT_ID_PATH)
    (VAR DBTR_AGNT_BIC)
	(VAR DBTR_AGNT_PATH1)
    (ASSIGN DBTR_AGNT_PATH (STRING "OUT.CstmrCdtTrfInitn.PmtInf[0].DbtrAgt.FinInstnId.BIC"))
    (ASSIGN DBTR_AGNT_ID_PATH (String "OUT.CstmrCdtTrfInitn.PmtInf[0].DbtrAgt.FinInstnId.Othr.Id"))
    (ASSIGN DBTR_AGNT_BIC (GETINDIRECT DBTR_AGNT_PATH))
    (IF (ISEMPTY DBTR_AGNT_BIC)
        THEN
		(
         	(ASSIGN DBTR_AGNT_PATH1 (String "OUT.CstmrCdtTrfInitn.PmtInf[0].DbtrAgt"))
			(SETINDIRECT DBTR_AGNT_PATH1 "")
            (SETINDIRECT DBTR_AGNT_ID_PATH DBTR_AGNT_ID)
		)
    )


)

(FUNCTION ENRICH_DBTRAGNT_ABNA_DD )

(
    (VAR DBTR_AGNT_ID)
    (VAR PATH_DBTTXINF_DBTR_AGNT_ID)
    (VAR DBTR_AGNT_BIC)
    (VAR DBTR_AGNT_PATH)
	(VAR DBTR_PATH)
    (ASSIGN DBTR_AGNT_PATH (STRING "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].DbtrAgt.FinInstnId.BIC"))
    (ASSIGN DBTR_AGNT_ID (MemTblGetTableValue "ONBOARD_INST" "DBTRAGNT_DD_ABNA_AD"))
    (ASSIGN DBTR_AGNT_BIC (GETINDIRECT DBTR_AGNT_PATH))
  
    (IF (ISEMPTY DBTR_AGNT_BIC)
        THEN
        (
            (ASSIGN DBTR_PATH (STRING "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].DbtrAgt"))
			(SETINDIRECT DBTR_PATH "")
            (Assign PATH_DBTTXINF_DBTR_AGNT_ID (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].DbtrAgt.FinInstnId.Othr.Id"))
            (SETINDIRECT PATH_DBTTXINF_DBTR_AGNT_ID DBTR_AGNT_ID)
        )
    )


)

(FUNCTION ENRICH_REQEXNDT_ABNA_CT )

(
 
    (VAR EARLIEST_DAY)
    (VAR LATEST_DAY)
    (VAR EARLIEST_NO_OF_DAYS)
    (VAR LATEST_NO_OF_DAYS)
    (VAR TIME_LINE_CHK_VAL)
    (VAR VALUE_DATE)
    (VAR CLEARING_ID)
    (VAR CHK_HOL_CLRG_ID)
    (VAR HOLIDAY)
    (VAR REQD_EXEN_DATE)
    (VAR REQD_EXEN_DATE_PATH)
    (VAR SCHEDULE_CHECK)
        (VAR INSTITUTIONID)
        (VAR TBL_KEY)

        (Assign INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "INSTITUTION_ID"))
        
    (ASSIGN SCHEDULE_CHECK (MemTblGetTableValue "ONBOARD_INST" "SCHEDULE_FLAG_ABNA_AD"))
        (IF (ISEQUALSTRING SCHEDULE_CHECK "Y")
                THEN
                (     
                    (ASSIGN REQD_EXEN_DATE_PATH (STRING "OUT.CstmrCdtTrfInitn.PmtInf[0].ReqdExctnDt"))    
                    (ASSIGN REQD_EXEN_DATE (CleanString (GETINDIRECT REQD_EXEN_DATE_PATH))) 
                    (ASSIGN CLEARING_ID (MemTblGetTableValue "ONBOARD_INST" "REQ_EXNDATE_ABNA_AD")) 
                    ;(Assign HOLIDAY (CHECK-HOLIDAY-FILE CLEARING_ID REQD_EXEN_DATE))
                                            (Assign TBL_KEY (Append (Append INSTITUTIONID ".")REQD_EXEN_DATE))
                    ;    (Assign CHK_HOL_CLRG_ID (MemTblGetTablevalue "CHL_HOLIDAY" REQD_EXEN_DATE))
                                                (Assign CHK_HOL_CLRG_ID (MemTblGetTablevalue "CHL_HOLIDAY" TBL_KEY))
                        (IF (IsEqualString CHK_HOL_CLRG_ID CLEARING_ID)
                           THEN
                             (
                                   (ASSIGN HOLIDAY "1") 
                             )
                        )       
                    ;(IF (IsGreaterThan HOLIDAY 0)
                   ;     THEN
                   ;     (
             ;       (ASSIGN REQD_EXEN_DATE (DD-NXT-WRKING-DAY-EQNS CLEARING_ID REQD_EXEN_DATE HOLIDAY))
                                        (ASSIGN REQD_EXEN_DATE (DD-NXT-WRKING-DAY-EQNS CLEARING_ID REQD_EXEN_DATE HOLIDAY INSTITUTIONID))
                  ;          (RETURN VALUE_DATE)
                  ;      )
                  ;  )
                  ;  (RETURN REQD_EXEN_DATE)
                    (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "VALUE_DATE" REQD_EXEN_DATE)
                    (IF (ISEQUAL (STRLEN REQD_EXEN_DATE) 8)
                        THEN
                          (Assign REQD_EXEN_DATE (Append(Append (Append (SubStr REQD_EXEN_DATE 1 4) "-") (Append(SubStr REQD_EXEN_DATE 5 2) "-")) (SubStr REQD_EXEN_DATE 7 2)))
                    )
                    (SETINDIRECT REQD_EXEN_DATE_PATH REQD_EXEN_DATE) 
                )
        )


)

(FUNCTION ENRICH_RQSTDCOLTN_ABNA_DD )

(
 
    (VAR RQSTD_COLTN_CLRGID)
    (VAR HOLIDAY)
    (VAR VALUE_DATE)
    (VAR CHK_HOL_CLRG_ID)
    (VAR RQSTD_COLLTN_DATE_PATH)
    (VAR RQSTD_COLLTN_DATE)
    (VAR SCHEDULE_CHECK)
        (VAR INSTITUTIONID)
        (VAR TBL_KEY)

        (Assign INSTITUTIONID (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "INSTITUTION_ID"))
        
    (ASSIGN SCHEDULE_CHECK (MemTblGetTableValue "ONBOARD_INST" "SCHEDULE_FLAG_ABNA_AD"))
    (IF (ISEQUALSTRING SCHEDULE_CHECK "Y")
       THEN
       ( 
            (Assign RQSTD_COLLTN_DATE_PATH (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].ReqdColltnDt"))    
            (ASSIGN RQSTD_COLLTN_DATE (Cleanstring (GETINDIRECT RQSTD_COLLTN_DATE_PATH)))
            (ASSIGN RQSTD_COLTN_CLRGID (MemTblGetTableValue "ONBOARD_INST" "RQSTD_COLTN_DATE_ABNA_AD"))
           ; (Assign HOLIDAY (CHECK-HOLIDAY-FILE RQSTD_COLTN_CLRGID RQSTD_COLLTN_DATE))
                   (Assign TBL_KEY (Append (Append INSTITUTIONID ".")RQSTD_COLLTN_DATE))
           ; (Assign CHK_HOL_CLRG_ID (MemTblGetTablevalue "CHL_HOLIDAY" RQSTD_COLLTN_DATE))
                        (Assign CHK_HOL_CLRG_ID (MemTblGetTablevalue "CHL_HOLIDAY" TBL_KEY))
            (IF (IsEqualString CHK_HOL_CLRG_ID RQSTD_COLTN_CLRGID)
                THEN
                   (ASSIGN HOLIDAY "1") 
            )       
              
           ; (ASSIGN RQSTD_COLLTN_DATE (DD-NXT-WRKING-DAY-EQNS RQSTD_COLTN_CLRGID RQSTD_COLLTN_DATE HOLIDAY))
                        (ASSIGN RQSTD_COLLTN_DATE (DD-NXT-WRKING-DAY-EQNS RQSTD_COLTN_CLRGID RQSTD_COLLTN_DATE HOLIDAY INSTITUTIONID))
                (IF (ISEQUAL (STRLEN RQSTD_COLLTN_DATE) 8)
                 THEN 
                   (Assign RQSTD_COLLTN_DATE (Append(Append (Append (SubStr RQSTD_COLLTN_DATE 1 4) "-") (Append(SubStr RQSTD_COLLTN_DATE 5 2) "-")) (SubStr RQSTD_COLLTN_DATE 7 2)))
            )
            (SETINDIRECT RQSTD_COLLTN_DATE_PATH RQSTD_COLLTN_DATE)
       )
    )

)

(FUNCTION ENRICH_STRUCTURED_ABNA_DD )

(
 
 
 (VAR PATH_PMTINF_STRUCTURED)
 (VAR PATH_PMTINF_UNSTRUCTURED)
 (VAR GETVAL_STRUCTURED)
 (VAR GETVAL_UNSTRUCTURED)
 (VAR GETVAL_CDTRREF_REF)
 (VAR GETVAL_ADDTLRMTINF)
 (VAR CDTRREF_REF)
 ;(VAR ADDTLRMTINF)
 (VAR SETVAL_UNSTRUCTURED)
 (VAR BH_TRANSACTION_GROUP)

 (Assign PATH_PMTINF_STRUCTURED (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Strd"))
 (Assign PATH_PMTINF_UNSTRUCTURED (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Ustrd[0].Ustrd"))
 (Assign BH_TRANSACTION_GROUP (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "BH_TRANSACTION_GROUP"))
 
 (IF (ISNOTEQUALSTRING BH_TRANSACTION_GROUP "10")
 THEN
     (
        (ASSIGN GETVAL_STRUCTURED "IN.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Strd")
        (ASSIGN GETVAL_UNSTRUCTURED "IN.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Ustrd")
        (ASSIGN GETVAL_CDTRREF_REF "IN.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Strd[0].CdtrRefInf.Ref")
    )
)
; (ASSIGN GETVAL_ADDTLRMTINF "IN.CstmrDrctDbtInitnV02.PmtInf[0].DrctDbtTxInf[0].RmtInf[0].Strd[0].AddtlRmtInf")
 (IF (ISEQUALSTRING BH_TRANSACTION_GROUP "10")
 THEN
     (
(ASSIGN GETVAL_CDTRREF_REF GV_TXN_PAYMTREF)

    )
)

(IF(ISPRESENT GETVAL_CDTRREF_REF)
    THEN
        (ASSIGN CDTRREF_REF (Append "Kenmerk: " GETVAL_CDTRREF_REF))
)
    
;(IF(ISPRESENT GETVAL_ADDTLRMTINF)
;    THEN
;      (    
;       (ASSIGN ADDTLRMTINF (Append "Omschrijving: " GETVAL_ADDTLRMTINF))
;       (ASSIGN SETVAL_UNSTRUCTURED (Append (Append CDTRREF_REF " ") ADDTLRMTINF))
;      )
;   ELSE
        (ASSIGN SETVAL_UNSTRUCTURED CDTRREF_REF)

;)
;(ASSIGN SETVAL_UNSTRUCTURED  (SubStr SETVAL_UNSTRUCTURED 1 140))

        
(IF (IsPresent GETVAL_STRUCTURED)
         THEN
         ;(SETINDIRECT PATH_PMTINF_STRUCTURED "")
         (COMPSETACTUALSEQNO PATH_PMTINF_STRUCTURED -1)  
)

(IF(ISEMPTY GETVAL_UNSTRUCTURED)
        THEN
          (SETINDIRECT PATH_PMTINF_UNSTRUCTURED SETVAL_UNSTRUCTURED)
)



)

(FUNCTION TA_ABNA_AD_ENRICH_RULES_CT )

(

    (VAR VAL_TRANSACTION_SEQUENCE_BATCH)
    (VAR BH_TRANSACTION_GROUP)

  ;  (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
    (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_INPATH "GENERAL" "START_OF_BATCH"))   
 (Assign BH_TRANSACTION_GROUP (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "BH_TRANSACTION_GROUP"))

 (IF (ISEQUALSTRING BH_TRANSACTION_GROUP "00")
 THEN
     (
        (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
        (IF (ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "1")
            THEN
            (
               (ASSIGN VAL_TRANSACTION_SEQUENCE_BATCH "YES")
            )
        )

     )
 )
(IF(ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "YES")
        THEN
        (
            (ENRICH_BTCHBOOKNG_ABNA_CT)
            (ENRICH_DBTRAGNT_ABNA_CT)
            (ENRICH_REQEXNDT_ABNA_CT)
            (ENRICH_CATEGORY_PUR_BTCH_ABNA_CT)    ; NEW RULE
        )
)

    ;;TRANSACTION LEVEL ENRICHMENTS
    (ENRICH_CDTRAGNT_ABNA_CT)
    (ENRICH_CATEGORY_PUR_TXN_ABNA_CT);     NEW RULE



)

(FUNCTION TA_ABNA_AD_ENRICH_RULES_DD )

(

    (VAR VAL_TRANSACTION_SEQUENCE_BATCH)
    (VAR BH_TRANSACTION_GROUP)
  ; (VAR VAL_TRANSACTION_SEQUENCE_FILE)
  ;  (ASSIGN VAL_TRANSACTION_SEQUENCE_FILE (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE")) 
  ;  (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
    (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_INPATH "GENERAL" "START_OF_BATCH"))   
    (IF (ISEQUALSTRING BH_TRANSACTION_GROUP "10")
 THEN
     (
        (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
        (IF (ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "1")
            THEN
            (
               (ASSIGN VAL_TRANSACTION_SEQUENCE_BATCH "YES")
            )
        )

     )
 )
   
;;BATCH LEVEL ENRICHMENTS
(IF(ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "YES")
        THEN
        ( 
           (ENRICH_BTCHBOOKNG_ABNA_DD)
           (ENRICH_CDTRAGNT_ABNA_DD)
           (ENRICH_RQSTDCOLTN_ABNA_DD) 
          ; (ENRICH_DBTRAGNT_ABNA_DD)
           (ENRICH_CATEGORY_PUR_ABNA_DD) ; NEW RULE
        )
    )

    ;;TRANSACTION LEVEL ENRICHMENTS
	  (ENRICH_DBTRAGNT_ABNA_DD)
      (ENRICH_STRUCTURED_ABNA_DD) ; NEW RULE


)

