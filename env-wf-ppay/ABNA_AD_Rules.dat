(FUNCTION ABNA_AD_ENRICH_RULES_CT  )

(
    (VAR VAL_TRANSACTION_SEQUENCE_BATCH)
    (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
    
    ;;BATCH LEVEL ENRICHMENTS
    (IF (ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "1")
        THEN
        (
            (ENRICH_BTCHBOOKNG_ABNA_CT)
            (ENRICH_DBTRAGNT_ABNA_CT)
            (ENRICH_REQEXNDT_ABNA_CT)
        )
    )

    ;;TRANSACTION LEVEL ENRICHMENTS
    (ENRICH_CDTRAGNT_ABNA_CT)


)

(FUNCTION ABNA_AD_ENRICH_RULES_DD )

(
    (VAR VAL_TRANSACTION_SEQUENCE_BATCH)
    (Assign VAL_TRANSACTION_SEQUENCE_BATCH (GETVALUEFROMHEADER GV_MSG_INPATH "STREAM_DETAILS" "TRANSACTION_SEQUENCE_BATCH"))
    
    ;;BATCH LEVEL ENRICHMENTS
    (IF (ISEQUALSTRING VAL_TRANSACTION_SEQUENCE_BATCH "1")
        THEN
        ( 
           (ENRICH_BTCHBOOKNG_ABNA_DD)
           (ENRICH_CDTRAGNT_ABNA_DD)
              ;  (ENRICH_CDTRSCHMID_ABNA_DD)
           (ENRICH_RQSTDCOLTN_ABNA_DD) 
          ; (ENRICH_DBTRAGNT_ABNA_DD)
        )
    )
	(ENRICH_DBTRAGNT_ABNA_DD)


)

(FUNCTION ENRICH_BTCHBOOKNG_ABNA_CT )

(

    (VAR BATCH_BOOKING)
    (VAR BTCH_BOOKING_PATH)
        (VAR GETVAL_BTCHBOOKG)

    (ASSIGN BTCH_BOOKING_PATH (String "OUT.CstmrCdtTrfInitn.PmtInf[0].BtchBookg"))
    (ASSIGN GETVAL_BTCHBOOKG(GetIndirect BTCH_BOOKING_PATH))
    (ASSIGN BATCH_BOOKING (MemTblGetTableValue "ONBOARD_INST" "BTCHBOOK_ABNA_AD"))  
    (IF (ISPRESENT GETVAL_BTCHBOOKG)
        THEN
           (SETINDIRECT BTCH_BOOKING_PATH BATCH_BOOKING)
    )

)

(FUNCTION ENRICH_BTCHBOOKNG_ABNA_DD )

(
 
    (VAR BATCH_BOOKING)
        (VAR PATH_PMTINF_BTCHBOOKG)
        (VAR GETVAL_BTCHBOOKG)
            ;;BATCH BOOKING VALUE
                        (Assign PATH_PMTINF_BTCHBOOKG (String "OUT.CstmrDrctDbtInitnV02.PmtInf[0].BtchBookg"))
                        (ASSIGN GETVAL_BTCHBOOKG(GetIndirect PATH_PMTINF_BTCHBOOKG))
            (ASSIGN BATCH_BOOKING (MemTblGetTableValue "ONBOARD_INST" "BTCHBOOK_ABNA_AD"))
                        (IF (IsPresent GETVAL_BTCHBOOKG)
                           THEN
                (SETINDIRECT PATH_PMTINF_BTCHBOOKG BATCH_BOOKING)  
                        )


)

