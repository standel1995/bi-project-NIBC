(FUNCTION DRVE_PRDT_ACC_TARGET_CHNL ACC )

(

 
(VAR CHANNEL_ID)
(VAR QUEUEID)
(VAR COMMENTS)

(ASSIGN CHANNEL_ID (MemTblGetTableValue "ACNO_TO_TRGT_CH" ACC))

    (IF(ISEQUALSTRING CHANNEL_ID "ORA-FIN-MSG-OUT")
     THEN
      (
       (Assign QUEUEID "STMQOUT")          
           (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "QUEUEID" "STMQOUT")
           (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "STATUS" "69")
           (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHNL_PRESENT" "Y")
       (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHANNEL_ID_TARGET" CHANNEL_ID)
      )
    )
    (IF(ISEQUALSTRING CHANNEL_ID "ORA-FIN-OUT")
     THEN
      (
        (Assign QUEUEID "STBLKOUT")        
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "QUEUEID" "STBLKOUT")
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "STATUS" "69")
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHNL_PRESENT" "Y")
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHANNEL_ID_TARGET" CHANNEL_ID)
      )
    )
        (IF (AND(ISPRESENT CHANNEL_ID)
                (NOT(ISPATTERNPRESENT "ORA-FIN-OUT|ORA-FIN-MSG-OUT" CHANNEL_ID))
                )
                THEN
             (
                (Assign QUEUEID "PROCEXCP")
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "QUEUEID" "PROCEXCP")
                (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "STATUS" "69")
            (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "RESUBMIT_STATUS" "69")
            (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "RESUBMIT_QUEUEID" "CRPMSGIN")
                        (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "CHNL_PRESENT" "Y")
                (ASSIGN COMMENTS "P20-1:A00:20-8464")
                        (SETVALUETOHEADER GV_MSG_OUTPATH "STREAM_DETAILS" "COMMENTS" COMMENTS)
                 )
        )

)

(FUNCTION DRVE_PRDT_FILETYP_PRODUCT )

(

(VAR CHANNEL_ID_SOURCE)
(VAR TRANTYPE)
(VAR PRODUCT)
(VAR FILETYPE)

(Assign CHANNEL_ID_SOURCE (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(Assign TRANTYPE "IN.FILEQ-MSG.TRANSACTION-TYPE")
(Assign FILETYPE (MemTblGetTablevalue "SOURCE-CHL-FILE" CHANNEL_ID_SOURCE))

    (IF (AND ;(ISEQUALSTRING CHANNEL_ID_SOURCE "INC_CLI_IN")
              (ISEQUALSTRING CHANNEL_ID_SOURCE "PURCHASE-IN")
             (ISEMPTY FILETYPE)
        )
        THEN
          (
               (IF(ISEQUALSTRING TRANTYPE "C")
                   THEN
                   (
                    (Assign PRODUCT "INC_DD_CLIEOP_OUT")
                    (SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT)
                    (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT)
                    (SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "PRODUCT" PRODUCT)
                    (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "PRODUCT" PRODUCT)
                    (RETURN "CLIEOPDD")
                   )                   
               )
               (IF(ISEQUALSTRING TRANTYPE "D")
                   THEN
                   (
                    (Assign PRODUCT "INC_CT_CLIEOP_OUT")
                    (SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT)                  
                    (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "DERIVED_PRODUCT" PRODUCT)
                    (SETVALUETOHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "PRODUCT" PRODUCT)                  
                    (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "PRODUCT" PRODUCT)
                    (RETURN "CLIEOPCT")
                   )
               )
         )
        )

)

(FUNCTION DRVE_PRDT_MT940_TARGET_CHNL )

(


(VAR CHANNEL_ID)
(ASSIGN CHANNEL_ID (MemTblGetTableValue "ACNO_TO_TRGT_CH" GV_F25))
(Assign GV_CHANNEL_ID "")

(IF(ISEMPTY GV_QUEUE_ID)
 THEN
  (
    (IF (ISEQUALSTRING CHANNEL_ID "ORA-FIN-MSG-OUT")
     THEN
      (
        (Assign GV_QUEUE_ID "STMQOUT")
        (Assign GV_STATUS "69")
        (ASSIGN GV_CHANNEL_ID CHANNEL_ID)
      )
    )
    (IF (ISEQUALSTRING CHANNEL_ID "ORA-FIN-OUT")
     THEN
      (
        (Assign GV_QUEUE_ID "STBLKOUT")
        (Assign GV_STATUS "69")
        (ASSIGN GV_CHANNEL_ID CHANNEL_ID)
      )
    )
        (IF (AND(ISPRESENT CHANNEL_ID)
                (NOT(ISPATTERNPRESENT "ORA-FIN-MSG-OUT|ORA-FIN-OUT" CHANNEL_ID))
                )
                THEN
             (
                        (Assign GV_QUEUE_ID "PROCEXCP")
                        (Assign GV_STATUS "69")
                        (Assign GV_RESUBMIT_QUEUEID "CRPMSGIN")
                        (Assign GV_RESUBMIT_STATUS "69")
                (ASSIGN GV_COMMENTS_FOR_BLOB6 "P20-1:A00:20-8464")
                 )
        )
  )
 )

)

(FUNCTION DRVE_PRDT_PRODUCT_CODE )

(

(VAR CHNL_SOURCE)
(VAR CHNL_SOURCE_ID)
(VAR PRODUCT_CODE)
(VAR MSG_SEGR)
(VAR MSGTYPE)
(VAR TRANTYPE)

(ASSIGN CHNL_SOURCE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "GENERAL" "INPUT_CHANNEL"))
(ASSIGN CHNL_SOURCE_ID (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_SOURCE"))
(ASSIGN PRODUCT_CODE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "PRODUCT_CODE"))
(ASSIGN MSG_SEGR (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSG_SEGR"))
(ASSIGN MSGTYPE (GETVALUEFROMHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CUST_REQ_MSG_TYP"))

(IF;(OR
      (ISEQUALSTRING CHNL_SOURCE "ORA-FIN-MSG-IN")
      ;(ISEQUALSTRING CHNL_SOURCE "SAA-MSG-IN")
   ;)    
 THEN
  (
    (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGSEGR" "VB")
    (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "APPLICATION" "SCD") 
  )
)
(IF(ISEQUALSTRING CHNL_SOURCE "PELICAN")
 THEN
  (
    (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "APPLICATION" "PELICAN")
  )
)
(IF(AND(ISEQUALSTRING CHNL_SOURCE_ID "ORA-FIN-MSG-IN")
       (ISEMPTY PRODUCT_CODE)
   )
 THEN
  (
    (RETURN "ORA-FIN") 
  )
)
(IF(ISEQUALSTRING CHNL_SOURCE "ORA-FIN-MSG-IN")
 THEN
  (
     (RETURN "ORA-FIN") 
  )
)

;added by Bhupesh 03012012


(IF(ISEQUALSTRING CHNL_SOURCE_ID "PURCHASE-IN")
 THEN
   (
                (Assign TRANTYPE "IN.ROUTE_MESSAGE.TRANSACTION-TYPE")
                (IF(ISEQUALSTRING TRANTYPE "C")
                     THEN
                           (
                             (RETURN "INC_DD_CLIEOP_OUT")
                       )
                )

                (IF(ISEQUALSTRING TRANTYPE "D")
                     THEN
                           (
                             (RETURN "INC_CT_CLIEOP_OUT")
                       )
                )

   )
 )

;end Bhupesh 
;;ADDED BY VISHAKH
(IF(ISEQUALSTRING CHNL_SOURCE_ID "PURCHASE-IN")
 THEN
   (
                (Assign TRANTYPE "IN.ROUTE_MESSAGE.TRANSACTION-TYPE")
                (IF(ISEQUALSTRING TRANTYPE "C")
                     THEN
                           (
                             (RETURN "INS_DD_CLIEOP_OUT")
                       )
                )

                (IF(ISEQUALSTRING TRANTYPE "D")
                     THEN
                           (
                             (RETURN "INS_CT_CLIEOP_OUT")
                       )
                )

   )
 )
;;;END BY VISHAKH

;(IF(ISPATTERNPRESENT "195|295" MSGTYPE)
;THEN
; (
;   (RETURN "VB_STATEMENT_IN")
; )
;)

;(IF(AND(ISPATTERNPRESENT "OOV|ROBBEDOES|STIFKO|PVF" MSG_SEGR)
;       (ISEMPTY PRODUCT_CODE)
;   )
; THEN
;  (
;    (RETURN "VB_FIN_OUT1") 
;  )
;)

)

(FUNCTION DRVE_PRDT_QUEUE_ID  )

(

(VAR QUEUEID)
(Assign QUEUEID (GETVALUEFROMHEADER (String "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID"))
(IF (IsEqualString QUEUEID "CRPREPRQ")
 THEN
  (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "QUEUEID" "CRPERR")
)

)

(FUNCTION DRVE_PRDT_SET_OUTPUT_QUEUEID FILE_TP MDBFL-PARAM5   )

(
;(VAR FILE_TP)	 ;modified by rajeshree
 (VAR BANK_FILE_TP)
 (VAR OUTPUT_QUEUE)

        ;(ASSIGN FILE_TP (GETVALUEFROMHEADER (STRING "IN.FILEQ-MSG") "STREAM_DETAILS" "FILE_TYPE"))
        (IF (IsEqualString FILE_TP "US-ACH-IN")
             THEN
             (Assign FILE_TP "ACH")
        )
        (IF (IsEqualString FILE_TP "US-CHK-IN")
             THEN
             (Assign FILE_TP "USCHECKS")
        )
        (ASSIGN BANK_FILE_TP (APPEND "PRODUCT" (APPEND "-" FILE_TP)))
        (ASSIGN OUTPUT_QUEUE (MemTblGetTablevalue "PRDCT_OP_QUEUE" BANK_FILE_TP))

        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "STREAM_DETAILS" "QUEUE_ID" OUTPUT_QUEUE)
        (SETVALUETOHEADER (STRING "OUT.FILEQ-MSG") "GENERAL" "OUTPUT_CHANNEL" "FILE-ROUTE-OUT")
        (Assign MDBFL-PARAM5 (RemovePattern MDBFL-PARAM5 "04END"))
        (RETURN)

)

(FUNCTION DRVE_PRDT_SET_OUT_CHNL  )

(
(VAR MESSAGE)
(VAR MSGTYPE)
(VAR CHANNEL_ID_TARGET)
;(ASSIGN MESSAGE "IN.ROUTE_MESSAGE")
(ASSIGN MSGTYPE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE"))
(ASSIGN CHANNEL_ID_TARGET (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_TARGET"))

    (IF(OR (ISPATTERNPRESENT MSGTYPE "ACK")
           (ISPATTERNPRESENT MSGTYPE "NAK") 
           (ISPATTERNPRESENT MSGTYPE "010") 
           (ISPATTERNPRESENT MSGTYPE "011") 
           (ISPATTERNPRESENT MSGTYPE "012") 
           (ISPATTERNPRESENT MSGTYPE "019") 
       )
    THEN
     (
       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "GENERAL" "OUTPUT_CHANNEL" "VB_ACKNAK_OUT")
       ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TARGET_CHANNEL" "VB_ACKNAK_OUT")
     )
    )
    (IF(OR (ISPATTERNPRESENT MSGTYPE "940")
           ;(ISPATTERNPRESENT CHANNEL_ID_TARGET "VB_FIN_OUT") 
           (ISPATTERNPRESENT CHANNEL_ID_TARGET "ORA-FIN-MSG-OUT") 
       )
    THEN
     (
       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "GENERAL" "OUTPUT_CHANNEL" "ORA-FIN-MSG-OUT")
       ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "GENERAL" "OUTPUT_CHANNEL" "VB_FIN_OUT")
       ;(SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TARGET_CHANNEL" "VB_ACKNAK_OUT")
     )
    )



)

(FUNCTION DRVE_PRDT_SET_TARGET_CHNL  )

(
(VAR MESSAGE)
(VAR MSGTYPE)
(VAR CHANNEL_ID_TARGET)  

(ASSIGN MSGTYPE (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "MSGTYPE"))
(ASSIGN CHANNEL_ID_TARGET (GETVALUEFROMHEADER (STRING "IN.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_TARGET"))

    (IF(OR (ISPATTERNPRESENT MSGTYPE "010") 
           (ISPATTERNPRESENT MSGTYPE "011") 
           (ISPATTERNPRESENT MSGTYPE "012") 
           (ISPATTERNPRESENT MSGTYPE "019") 
       )
    THEN
     (
       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "TARGET_CHANNEL" "VB_ACKNAK_OUT")
     )
    )
    (IF (ISPATTERNPRESENT MSGTYPE "940")
    THEN
     (
       (SETVALUETOHEADER (STRING "OUT.ROUTE_MESSAGE") "STREAM_DETAILS" "CHANNEL_ID_TARGET" CHANNEL_ID_TARGET)
     )
    )



)

(FUNCTION SET_ACCNO_LOCCODE )

(
 
 
(VAR LOCATION)

(ASSIGN LOCATION (MemTblGetTableValue "ACNO_TO_LOC_CD" GV_F25))

(IF(ISPRESENT LOCATION)
 THEN
  (
    (ASSIGN GV_LOCATION LOCATION)
  )
 ELSE
  (
    (ASSIGN GV_LOCATION "BANK_REPORTS")
  )
)


)
